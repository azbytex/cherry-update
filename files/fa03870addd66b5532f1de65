// Efek Suara Alat Tulis (Stationery ASMR) menggunakan Web Audio API murni.
// 100% offline, latensi 0ms, tanpa dependensi file eksternal.
import { settings, saveSettings } from './db.js';

let ctx = null;

function getAudioContext() {
  if (!ctx) {
    const AudioCtx = window.AudioContext || window.webkitAudioContext;
    if (AudioCtx) ctx = new AudioCtx();
  }
  if (ctx && ctx.state === 'suspended') {
    ctx.resume().catch(() => {});
  }
  return ctx;
}

export function isSoundEnabled() {
  return settings.soundFx !== false;
}

export function setSoundEnabled(v) {
  settings.soundFx = !!v;
  saveSettings();
}

// Suara lembut gemerisik membalik halaman kertas (Page Flip)
export function playPageFlip() {
  if (!isSoundEnabled()) return;
  const ac = getAudioContext();
  if (!ac) return;
  try {
    const t = ac.currentTime;
    const dur = 0.16;
    const buf = ac.createBuffer(1, Math.round(ac.sampleRate * dur), ac.sampleRate);
    const data = buf.getChannelData(0);
    for (let i = 0; i < data.length; i++) {
      data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (data.length * 0.38));
    }
    const src = ac.createBufferSource();
    src.buffer = buf;

    const filter = ac.createBiquadFilter();
    filter.type = 'bandpass';
    filter.frequency.setValueAtTime(650, t);
    filter.frequency.exponentialRampToValueAtTime(1500, t + dur * 0.45);
    filter.frequency.exponentialRampToValueAtTime(450, t + dur);
    filter.Q.value = 1.2;

    const gain = ac.createGain();
    gain.gain.setValueAtTime(0.001, t);
    gain.gain.linearRampToValueAtTime(0.22, t + 0.025);
    gain.gain.exponentialRampToValueAtTime(0.001, t + dur);

    src.connect(filter);
    filter.connect(gain);
    gain.connect(ac.destination);
    src.start(t);
  } catch {}
}

// Suara renyah saat menempel stiker (Pop / Slap)
export function playStickerPop() {
  if (!isSoundEnabled()) return;
  const ac = getAudioContext();
  if (!ac) return;
  try {
    const t = ac.currentTime;
    const osc = ac.createOscillator();
    const gain = ac.createGain();

    osc.type = 'sine';
    osc.frequency.setValueAtTime(520, t);
    osc.frequency.exponentialRampToValueAtTime(110, t + 0.065);

    gain.gain.setValueAtTime(0.28, t);
    gain.gain.exponentialRampToValueAtTime(0.001, t + 0.065);

    osc.connect(gain);
    gain.connect(ac.destination);
    osc.start(t);
    osc.stop(t + 0.07);
  } catch {}
}

// Suara halus gesekan pensil / pena di atas kertas (ASMR pencil touch)
let lastPenSound = 0;
export function playPencilTouch() {
  if (!isSoundEnabled()) return;
  const now = performance.now();
  if (now - lastPenSound < 280) return;
  lastPenSound = now;
  const ac = getAudioContext();
  if (!ac) return;
  try {
    const t = ac.currentTime;
    const dur = 0.045;
    const buf = ac.createBuffer(1, Math.round(ac.sampleRate * dur), ac.sampleRate);
    const data = buf.getChannelData(0);
    for (let i = 0; i < data.length; i++) {
      data[i] = (Math.random() * 2 - 1) * (1 - i / data.length);
    }
    const src = ac.createBufferSource();
    src.buffer = buf;

    const filter = ac.createBiquadFilter();
    filter.type = 'highpass';
    filter.frequency.value = 2200;

    const gain = ac.createGain();
    gain.gain.setValueAtTime(0.06, t);
    gain.gain.exponentialRampToValueAtTime(0.001, t + dur);

    src.connect(filter);
    filter.connect(gain);
    gain.connect(ac.destination);
    src.start(t);
  } catch {}
}

// Suara denting manis to-do selesai (Chime / Done)
export function playCheckChime() {
  if (!isSoundEnabled()) return;
  const ac = getAudioContext();
  if (!ac) return;
  try {
    const t = ac.currentTime;
    [523.25, 659.25, 783.99].forEach((freq, idx) => {
      const osc = ac.createOscillator();
      const gain = ac.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(freq, t + idx * 0.04);
      gain.gain.setValueAtTime(0.001, t + idx * 0.04);
      gain.gain.linearRampToValueAtTime(0.14, t + idx * 0.04 + 0.015);
      gain.gain.exponentialRampToValueAtTime(0.001, t + idx * 0.04 + 0.24);
      osc.connect(gain);
      gain.connect(ac.destination);
      osc.start(t + idx * 0.04);
      osc.stop(t + idx * 0.04 + 0.25);
    });
  } catch {}
}

// Suara buang / hapus kertas (Crumple)
export function playTrashCrumple() {
  if (!isSoundEnabled()) return;
  const ac = getAudioContext();
  if (!ac) return;
  try {
    const t = ac.currentTime;
    const dur = 0.11;
    const buf = ac.createBuffer(1, Math.round(ac.sampleRate * dur), ac.sampleRate);
    const data = buf.getChannelData(0);
    for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1) * Math.sin(i / 8);
    const src = ac.createBufferSource();
    src.buffer = buf;
    const filter = ac.createBiquadFilter();
    filter.type = 'lowpass';
    filter.frequency.value = 1800;
    const gain = ac.createGain();
    gain.gain.setValueAtTime(0.18, t);
    gain.gain.exponentialRampToValueAtTime(0.001, t + dur);
    src.connect(filter);
    filter.connect(gain);
    gain.connect(ac.destination);
    src.start(t);
  } catch {}
}

