// ---------- Pengulangan & Rentang ----------
export function occursOn(ev, d, key) {
  if (key < ev.date) return false;
  if (ev.until && key > ev.until) return false;
  if (ev.exdates?.includes(key)) return false;
  const s = parseYmd(ev.date);
  const iv = ev.interval || 1;
  switch (ev.repeat) {
    case 'daily': {
      if (iv === 1) return true;
      const diff = Math.round((d - s) / 86400000);
      return diff >= 0 && diff % iv === 0;
    }
    case 'weekly': {
      const dayMatch = ev.byday?.length ? ev.byday.includes(d.getDay()) : d.getDay() === s.getDay();
      if (!dayMatch) return false;
      if (iv === 1) return true;
      const diffW = Math.floor((d - s) / (7 * 86400000));
      return diffW >= 0 && diffW % iv === 0;
    }
    case 'monthly': {
      if (d.getDate() !== s.getDate()) return false;
      if (iv === 1) return true;
      const diffM = (d.getFullYear() - s.getFullYear()) * 12 + (d.getMonth() - s.getMonth());
      return diffM >= 0 && diffM % iv === 0;
    }
    case 'yearly': {
      if (d.getDate() !== s.getDate() || d.getMonth() !== s.getMonth()) return false;
      const diffY = d.getFullYear() - s.getFullYear();
      return diffY >= 0 && diffY % iv === 0;
    }
    default: return key >= ev.date && key <= (ev.endDate || ev.date);
  }
}
const byTime = (a, b) => (a._holiday ? 1 : 0) - (b._holiday ? 1 : 0) || (a.time || '').localeCompare(b.time || '') || a.title.localeCompare(b.title);
export function eventsOn(d) {
  ensureIndex();
  const key = ymd(d);
  const exact = _dateMap.get(key);
  const rec = _recList.length ? _recList.filter((e) => occursOn(e, d, key)) : null;
  if (!exact && (!rec || !rec.length)) return [];
  const list = exact && rec?.length ? [...exact, ...rec] : exact ? [...exact] : rec;
  return list.length > 1 ? list.sort(byTime) : list;
}
export function formatEventWhen(e) {
  const tStr = e.time ? e.time + (e.end ? ' – ' + e.end : '') : 'Sepanjang hari';
  if (e.endDate && e.endDate > e.date) {
    const a = parseYmd(e.date), b = parseYmd(e.endDate);
    const sameM = a.getMonth() === b.getMonth() && a.getFullYear() === b.getFullYear();
    const dStr = sameM ? `${a.getDate()}–${b.getDate()} ${MONTHS[b.getMonth()]}` : `${a.getDate()} ${MONTHS[a.getMonth()]} – ${b.getDate()} ${MONTHS[b.getMonth()]}`;
    return `${dStr} · ${tStr}`;
  }
  return tStr;
}

function isoWeek(d) {
  const t = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
  const day = t.getUTCDay() || 7; t.setUTCDate(t.getUTCDate() + 4 - day);
  const y0 = new Date(Date.UTC(t.getUTCFullYear(), 0, 1));
  return Math.ceil(((t - y0) / 864e5 + 1) / 7);
}

