          ${e.note && !e._holiday ? `<div class="sub" style="white-space:pre-wrap">${esc(e.note)}</div>` : ''}</div>
      </div>`).join('') : '<div class="dp-empty">Tidak ada acara.</div>'}
    ${tds.length ? `<div class="h2">To-do tenggat hari ini</div>${tds.map((t, i) => `
      <div class="row dp-item ${t.done ? 'done' : ''}" data-todo="${t.id}" style="--i:${evs.length + i}">
        <button class="check">${t.done ? ICON.check : ''}</button><div class="grow ttl">${esc(t.title)}</div></div>`).join('')}` : ''}
    <div class="actions">
      <button class="btn ghost left" id="dd-note">${ICON.pen.replace('<svg', '<svg width="16" height="16" style="vertical-align:-3px;margin-right:6px"')}${note ? 'Buka catatan hari ini' : 'Tulis catatan'}</button>
      <button class="btn ghost" id="dd-close">Tutup</button>
      <button class="btn primary" id="dd-add">+ Acara</button>
