export const newEvent = (date) => editEvent(undefined, date); // dipakai Dashboard
function editEvent(ev, date, after) {
  const isNew = !ev;
  ev = ev || { title: '', date: date || selected, endDate: '', time: '', end: '', note: '', color: settings.calAccent, repeat: 'none', remind: settings.defaultRemind ?? '10' };
  let color = ev.color;
  const hasRange = !!(ev.time || ev.end || (ev.endDate && ev.endDate > ev.date));
  const s = openSheet(`
    <h3>${isNew ? 'Acara baru' : 'Ubah acara'}</h3>
    ${isNew ? `<div class="chips" style="margin:-4px 0 12px">
      <button type="button" class="chip-opt" id="e-pre-bday">🎂 Ulang tahun</button>
      <button type="button" class="chip-opt" id="e-pre-spec">🎉 Hari spesial</button>
    </div>` : ''}
    <div class="field"><label>Judul</label><input class="inp" id="e-title" value="${esc(ev.title)}" placeholder="Mis. Ujian, ulang tahun, deadline tugas"></div>
    <div class="field"><label>Tanggal mulai</label><input class="inp" id="e-date" type="date" value="${ev.date}"></div>
    <button type="button" class="cal-range-toggle ${hasRange ? 'on' : ''}" id="e-range-btn" aria-expanded="${hasRange}">
      <span>Rentang tanggal &amp; jam</span>
      <svg viewBox="0 0 24 24" width="16" height="16"><path d="M6 9l6 6 6-6"/></svg>
    </button>
    <div class="cal-expand ${hasRange ? 'open' : ''}" id="e-range-box">
      <div class="cal-expand-in">
        <div class="field"><label>Sampai tanggal (opsional)</label><input class="inp" id="e-end-date" type="date" value="${ev.endDate || ''}" min="${ev.date}"></div>
        <div class="two">
          <div class="field"><label>Jam mulai</label><input class="inp" id="e-time" type="time" value="${ev.time || ''}"></div>
          <div class="field"><label>Jam selesai</label><input class="inp" id="e-end" type="time" value="${ev.end || ''}"></div>
        </div>
      </div>
    </div>
    <div class="field"><label>Ulangi</label><select class="inp" id="e-rep">${Object.entries(REPEAT).map(([k, v]) => `<option value="${k}" ${ev.repeat === k ? 'selected' : ''}>${v}</option>`).join('')}</select></div>
    <div class="field"><label>Ingatkan</label><select class="inp" id="e-rem">${Object.entries(REMIND).map(([k, v]) => `<option value="${k}" ${String(ev.remind ?? '') === k ? 'selected' : ''}>${v}</option>`).join('')}</select></div>
    <div class="field"><label>Catatan</label><textarea class="inp" id="e-note" rows="2">${esc(ev.note)}</textarea></div>
    <div class="field"><label>Warna</label><div class="swatches">${[...new Set([settings.calAccent, ...COLORS])].map((c) => `<button class="sw ${c === color ? 'on' : ''}" data-c="${c}" style="background:${c}"></button>`).join('')}</div></div>
    <div class="actions">
      ${isNew ? '' : '<button class="btn danger left" id="e-del">Hapus</button>'}
      <button class="btn ghost" id="e-cancel">Batal</button>
      <button class="btn primary" id="e-save">Simpan</button>
    </div>`, { guardForm: true, onSave: () => submit() }); // sudah diisi tapi belum disimpan → tanya dulu
  if (isNew) setTimeout(() => $('#e-title', s).focus(), 40);
  const pickCol = (c) => { color = c; $$('.sw', s).forEach((x) => x.classList.toggle('on', x.dataset.c === c)); };
  $$('.sw', s).forEach((b) => b.onclick = () => pickCol(b.dataset.c));
  const rBtn = $('#e-range-btn', s), rBox = $('#e-range-box', s), dStart = $('#e-date', s), dEnd = $('#e-end-date', s);
  rBtn.onclick = () => {
    const on = !rBox.classList.contains('open');
    rBox.classList.toggle('open', on);
    rBtn.classList.toggle('on', on);
    rBtn.setAttribute('aria-expanded', on);
  };
  dStart.onchange = () => { if (dEnd.value && dEnd.value < dStart.value) dEnd.value = dStart.value; dEnd.min = dStart.value; };
  if (isNew) {
    $('#e-pre-bday', s).onclick = () => {
      const inp = $('#e-title', s);
      if (!inp.value.trim()) inp.value = 'Ulang tahun ';
      $('#e-rep', s).value = 'yearly';
      pickCol('#db2777');
      inp.focus();
    };
    $('#e-pre-spec', s).onclick = () => {
      $('#e-rep', s).value = 'yearly';
      pickCol('#e5484d');
      $('#e-title', s).focus();
    };
  }
  $('#e-cancel', s).onclick = () => closeSheet();
  if (!isNew) $('#e-del', s).onclick = async () => {
    if (!(await confirmDialog(`Hapus acara "${ev.title}"?`, { ok: 'Hapus', danger: true }))) return;
    events = events.filter((e) => e.id !== ev.id);
    invalidateEventIndex();
    await db.del('events', ev.id); reschedule(); render();
    window.dispatchEvent(new CustomEvent('cherry:gcal'));
    after?.(); toast('Acara dihapus');
  };
  const submit = async () => {
    const title = $('#e-title', s).value.trim();
    if (!title) { $('#e-title', s).focus(); return; }
    const startD = $('#e-date', s).value || selected;
    let endD = $('#e-end-date', s).value;
    if (endD && endD <= startD) endD = '';
    const data = { title, date: startD, endDate: endD, time: $('#e-time', s).value, end: $('#e-end', s).value, repeat: $('#e-rep', s).value, remind: $('#e-rem', s).value, note: $('#e-note', s).value.trim(), color };
    let rec;
    if (isNew) { rec = { id: uid(), created: Date.now(), ...data }; events.push(rec); } else { rec = Object.assign(ev, data); }
    invalidateEventIndex();
    await db.put('events', rec);
    if (rec.remind !== '') ensurePermission().then(reschedule); else reschedule();
    if (!after) { selected = data.date; const d = parseYmd(data.date); cursor = new Date(d.getFullYear(), d.getMonth(), 1); }
    closeSheet(); render();
    window.dispatchEvent(new CustomEvent('cherry:gcal'));
    after?.(); toast(isNew ? 'Acara ditambahkan' : 'Acara diperbarui');
  };
  $('#e-save', s).onclick = submit;
  $('#e-title', s).onkeydown = (e) => { if (e.key === 'Enter') submit(); };
}

// ---------- Agenda ----------
function agenda() {
  const t = today(); const items = [];
  for (let i = 0; i < 90 && items.length < 60; i++) {
    const d = new Date(t); d.setDate(t.getDate() + i);
    for (const e of eventsOn(d)) items.push({ d, e });
  }
  const s = openSheet(`<h3>Agenda 90 hari ke depan</h3>
    ${items.length ? items.map(({ d, e }) => `<div class="row click" data-id="${e.id}" data-date="${ymd(d)}"><span class="bar" style="background:${e.color}"></span>
      <div class="grow"><div>${esc(e.title)}</div><div class="sub">${longDate(d)}${e.time ? ' · ' + e.time : ''}</div></div></div>`).join('')
      : '<div class="empty" style="padding:30px">Belum ada acara mendatang.</div>'}
    <div class="actions"><button class="btn ghost" id="ag-c">Tutup</button></div>`);
  $('#ag-c', s).onclick = () => closeSheet();
  $$('.row', s).forEach((r) => r.onclick = () => { selected = r.dataset.date; const d = parseYmd(selected); cursor = new Date(d.getFullYear(), d.getMonth(), 1); closeSheet(); render(); });
}

