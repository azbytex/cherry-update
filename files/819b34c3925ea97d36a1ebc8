  $$('[data-id]', s).forEach((r) => r.onclick = () => { const ev = events.find((e) => e.id === r.dataset.id); if (ev) editEvent(ev, null, () => dayDetail(key)); });
  $$('[data-todo]', s).forEach((r) => r.querySelector('.check').onclick = async () => { await toggleTodo(r.dataset.todo); dayDetail(key); });
  $('#dd-close', s).onclick = () => closeSheet();
  $('#dd-add', s).onclick = () => editEvent(null, key, () => dayDetail(key));
  $('#dd-note', s).onclick = () => { closeSheet(); openDay(key, $(`.cell[data-date="${key}"]`, root)); };
}

