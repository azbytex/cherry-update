  wd.style.gridTemplateColumns = cols;
  const curMonth = cursor.getMonth() === t.getMonth() && cursor.getFullYear() === t.getFullYear();
  wd.innerHTML = (s.weekNumbers ? '<div class="wk">Mg</div>' : '') + order.map((d) =>
    `<div class="${curMonth && d === t.getDay() ? 'now' : ''} ${s.redSunday && d === 0 ? 'red' : ''}">${DAYS[d]}</div>`).join('');

  const offset = (cursor.getDay() - s.weekStart + 7) % 7;
  const start = new Date(cursor); start.setDate(1 - offset);
  const grid = $('#c-grid', root);
  grid.style.gridTemplateColumns = cols;
  grid.classList.toggle('cal-round', s.todayStyle === 'round');
  let html = '';
  for (let i = 0; i < 42; i++) {
    const d = new Date(start); d.setDate(start.getDate() + i);
    const key = ymd(d);
    if (s.weekNumbers && i % 7 === 0) html += `<div class="cell wk">${isoWeek(d)}</div>`;
    const cls = ['cell'];
    const other = d.getMonth() !== cursor.getMonth();
    if (other) cls.push('other');
    if (other && !s.showOther) cls.push('hideother');
    if (key === tKey) cls.push('today');
    if (key === selected) cls.push('sel');
    const evs = eventsOn(d);
    if ((s.redSunday && d.getDay() === 0) || evs.some((e) => e._holiday)) cls.push('red');
    if (i % 7 === 6) cls.push('endcol');
    let body = '';
    if (s.eventStyle === 'dot') {
      body = evs.length ? `<div class="dots">${evs.slice(0, 6).map((e) => `<i style="background:${e.color}"></i>`).join('')}</div>` : '';
    } else {
      const max = 3;
      body = `<div class="evs">${evs.slice(0, max).map((e) => `<div class="ev" style="background:${e.color}">${e.time ? e.time + ' ' : ''}${esc(e.title)}</div>`).join('')}${evs.length > max ? `<div class="more">+${evs.length - max}</div>` : ''}</div>`;
    }
    const hasNote = findDay(key)?.ink ? `<i class="has-note" title="Ada catatan">${ICON.pen}</i>` : '';
    html += `<button class="${cls.join(' ')}" style="--i:${i}" data-date="${key}"><span class="num"><span>${d.getDate()}</span>${hasNote}</span>${body}</button>`;
  }
  grid.innerHTML = html;
  grid.classList.toggle('quiet', quiet);
  grid.classList.remove('anim', 'wave');
  if (dir || wave) {
    void grid.offsetWidth;
    grid.style.setProperty('--dir', dir > 0 ? '36px' : '-36px');
    grid.classList.add(wave ? 'wave' : 'anim');
  }
}

