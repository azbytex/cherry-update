    <div class="field"><label>Tanggal bulan lain</label><div class="chips">${opt('showOther', true, 'Tampilkan')}${opt('showOther', false, 'Sembunyikan')}</div></div>
    <div class="field"><label>Hari Minggu merah</label><div class="chips">${opt('redSunday', true, 'Ya')}${opt('redSunday', false, 'Tidak')}</div></div>
    <div class="field"><label>Hari libur nasional (Indonesia)</label><div class="chips">${opt('showHolidays', true, 'Tampilkan')}${opt('showHolidays', false, 'Sembunyikan')}</div></div>
    <div class="actions"><button class="btn primary" id="cz-ok">Selesai</button></div>`);
  const apply = () => { invalidateEventIndex(); saveSettings(); applyAccent(); render(); window.dispatchEvent(new CustomEvent('cherry:gcal')); };
  $$('[data-acc]', s).forEach((b) => b.onclick = () => { settings.calAccent = b.dataset.acc; $$('[data-acc]', s).forEach((x) => x.classList.toggle('on', x === b)); apply(); });
  $('#cz-col', s).oninput = (e) => { settings.calAccent = e.target.value; $$('[data-acc]', s).forEach((x) => x.classList.remove('on')); apply(); };
  $$('[data-k]', s).forEach((b) => b.onclick = () => {
