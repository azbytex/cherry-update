  $('#s-backup', root).onclick = exportBackup;
  $('#s-restore', root).onclick = async () => {
    const f = await pickFile('application/json,.json'); if (!f) return;
    if (await confirmDialog('Data saat ini akan diganti dengan isi file cadangan. Lanjutkan?', { ok: 'Pulihkan', danger: true })) importBackup(f);
  };
  $('#s-wipe', root).onclick = async () => {
    if (!(await confirmDialog('Hapus SEMUA catatan, acara kalender, dan to-do? Tindakan ini tidak bisa dibatalkan.', { ok: 'Hapus semua', danger: true }))) return;
    for (const st of STORES) if (st !== 'kv') await db.clear(st);
    toast('Semua data dihapus'); setTimeout(() => location.reload(), 600);
  };
}

/** Sheet pengaturan Google Calendar iCal + Bridge 2 Arah */
function openGcalSettings(onDone) {
  const cur = getGcalUrl();
  const curBridge = getGcalBridgeUrl();
  const s = openSheet(`
    <h3>Google Calendar</h3>
    <div class="field">
      <label>1. URL iCal (Baca acara dari Google)</label>
      <textarea class="inp" id="gcal-url" rows="2" placeholder="https://calendar.google.com/calendar/ical/…/basic.ics" style="font-size:12px;word-break:break-all">${esc(cur)}</textarea>
      <small style="color:var(--soft);font-size:12px">calendar.google.com → ⚙ Pengaturan → nama kalender → "Secret address in iCal format"</small>
    </div>

    <div class="field" style="margin-top:14px;padding-top:12px;border-top:1px solid var(--line)">
      <label>2. Sinkronisasi 2 Arah (Edit &amp; Hapus ke Google)</label>
      <textarea class="inp" id="gcal-bridge" rows="2" placeholder="https://script.google.com/macros/s/…/exec" style="font-size:12px;word-break:break-all">${esc(curBridge)}</textarea>
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px">
        <button type="button" class="btn ghost" id="gcal-copy-code" style="font-size:12px;padding:6px 10px">Salin Kode Apps Script</button>
        <button type="button" class="btn ghost" id="gcal-test" style="font-size:12px;padding:6px 10px">Tes Koneksi</button>
      </div>
      <details style="margin-top:8px;font-size:12px;color:var(--soft);line-height:1.55">
        <summary style="cursor:pointer;color:var(--ink)">Cara pasang Apps Script (1x saja)</summary>
        <ol style="margin:6px 0 0 18px;padding:0">
          <li>Klik <b>Salin Kode Apps Script</b> di atas.</li>
          <li>Buka <b>script.google.com</b> → klik <b>New project</b>.</li>
          <li>Hapus isi default, tempel kode tadi, lalu simpan.</li>
          <li>Klik <b>Deploy → New deployment → Web app</b>.</li>
          <li><b>Execute as</b>: Me · <b>Who has access</b>: Anyone → Deploy &amp; izinkan akses kalender.</li>
          <li>Salin <b>Web app URL</b> (<code>/exec</code>) lalu tempel di kolom atas.</li>
        </ol>
      </details>
    </div>

    <div class="actions">
      <button class="btn ghost" id="gcal-clear" ${(cur || curBridge) ? '' : 'disabled'}>Hapus</button>
      <button class="btn ghost" id="gcal-cancel">Batal</button>
      <button class="btn primary" id="gcal-save">Simpan &amp; Sinkronkan</button>
    </div>`);
  setTimeout(() => $('#gcal-url', s)?.focus(), 60);
  $('#gcal-cancel', s).onclick = () => closeSheet();
  $('#gcal-copy-code', s).onclick = async () => {
    try {
      await navigator.clipboard.writeText(getAppsScriptCode());
      toast('Kode Apps Script disalin! Tempel di script.google.com');
    } catch {
      toast('Gagal menyalin otomatis');
    }
  };
  $('#gcal-test', s).onclick = async () => {
    const br = ($('#gcal-bridge', s).value || '').trim();
    if (!br) { toast('Tempel URL Web App Apps Script dulu'); return; }
    await setGcalBridgeUrl(br);
    toast('Menguji koneksi…');
    const r = await testGcalBridge();
    if (r.ok) toast(`Terhubung ke kalender: ${r.calendar || 'OK'}`);
    else toast('Gagal terhubung: ' + (r.error || 'periksa URL / deployment'));
  };
  $('#gcal-clear', s).onclick = async () => {
    await setGcalUrl('');
    await setGcalBridgeUrl('');
    await syncGcal({ silent: true });
    closeSheet(); onDone?.(); toast('Pengaturan Google Calendar dihapus');
  };
  $('#gcal-save', s).onclick = async () => {
    const url = ($('#gcal-url', s).value || '').trim();
    const br = ($('#gcal-bridge', s).value || '').trim();
    if (url && !url.includes('calendar.google.com') && !url.endsWith('.ics')) {
      toast('URL iCal tidak terlihat valid. Periksa kembali.'); return;
    }
    if (br && !br.includes('script.google.com')) {
      toast('URL Bridge harus berupa Web App URL dari script.google.com'); return;
    }
    await setGcalUrl(url);
    await setGcalBridgeUrl(br);
    closeSheet(); onDone?.();
    if (url) {
      toast('Menyinkronkan…');
      const r = await syncGcal();
      if (r.ok) onDone?.();
    } else if (br) {
      toast('Bridge 2 arah disimpan');
    }
  };
}
