  const syncGcalSub = async () => {
    const sub = $('#s-gcal-sub', root); if (!sub) return;
    const url = getGcalUrl(), br = getGcalBridgeUrl();
    if (!url && !br) { sub.textContent = 'Belum dikonfigurasi — tempel URL iCal Google Calendar kamu'; return; }
    const ts = await gcalLastSync();
    const ago = ts ? Math.round((Date.now() - ts) / 60000) : null;
    const mode = br ? '2 Arah Aktif' : 'Hanya-baca (iCal)';
    sub.textContent = `${mode}`
      + (ago !== null ? ` · Sync ${ago < 1 ? 'baru saja' : ago + ' mnt lalu'}` : '');
  };
  syncGcalSub();
  _syncAsync = () => { syncGcalSub(); };
