let root, _drawn = false;
let _syncAsync = () => {};
export function initSettings(el) { root = el; }

function statsData() {
  const nbs = state.notebooks.filter((n) => !n.trashed);
  const daily = nbs.filter((n) => n.kind === 'day' || n.kind === 'month').length;
  const pages = nbs.reduce((a, n) => a + n.pageIds.length, 0);
  const td = todoStats();
  const pct = td.total ? Math.round((td.done / td.total) * 100) : 0;
  return { ev: upcomingCount(), td, pct, books: nbs.length, folders: state.folders.length, pages, daily };
}

function updateSummaryStats() {
  if (!root || !_drawn) return;
  const d = statsData();
  const set = (id, v) => { const el = $(id, root); if (el) el.textContent = v; };
  set('#st-ev', d.ev);
  set('#st-td', d.td.open);
  set('#st-td-sub', d.td.total ? `${d.td.done}/${d.td.total} selesai (${d.pct}%)` : 'Belum ada tugas');
  const bar = $('#st-td-bar', root);
  if (bar) bar.style.width = `${d.pct}%`;
  set('#st-bk', d.books);
  set('#st-bk-sub', `${d.folders} folder`);
  set('#st-pg', d.pages);
  set('#st-pg-sub', `${d.daily} catatan harian`);
}

export function renderSettings(force = false) {
  if (!root) return;
  if (!force && _drawn) {
    updateSummaryStats();
    _syncAsync();
    return;
  }
  // ganti pengaturan: tampilan diperbarui di tempat, posisi gulir tetap (tidak loncat ke atas)
  const keep = root.isConnected && root.childElementCount ? [root, ...root.querySelectorAll("*")].filter((x) => x.scrollTop > 0).map((x) => [x.className, x === root, x.scrollTop]) : null;
  drawSettings();
  _drawn = true;
  if (keep) { root.classList.add("still"); setTimeout(() => root.classList.remove("still"), 500); for (const [cls, isRoot, top] of keep) { const el = isRoot ? root : [...root.querySelectorAll("*")].find((x) => x.className === cls && x.scrollHeight > x.clientHeight); if (el) el.scrollTop = top; } }
}
