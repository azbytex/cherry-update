const COVER_COLORS = ['#ffd93b', '#f0442f', '#0a99f0', '#22a861', '#8b5cf6', '#ec4899', '#f59e0b', '#14b8a6', '#26262a', '#b08968',
  '#ffb5c2', '#ffd6a5', '#fdffb6', '#caffbf', '#9bf6ff', '#a0c4ff', '#bdb2ff', '#ffc6ff', '#f4a261', '#2a9d8f', '#264653', '#e76f51', '#6d597a', '#9c6644', '#f8f4e3', '#1d3557'];
