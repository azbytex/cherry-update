// Scribble: model pengenal tulisan tangan (Google ML Kit, berjalan di HP).
// Model per bahasa (~20 MB) diunduh sekali. File ini mengurus penjelasan untuk pengguna baru, unduhan, dan statusnya.
import { settings, saveSettings } from './db.js';
import { $, openSheet, closeSheet, toast } from './ui.js';

export const scribPlugin = () => window.Capacitor?.Plugins?.Scribble;
export const scribLang = () => (settings.lang === 'en' ? 'en-US' : 'id');
const LANG_NAME = { id: 'Bahasa Indonesia', 'en-US': 'English' };
export const scribLangName = () => LANG_NAME[scribLang()];

// 'ready' | 'missing' | 'unsupported' (bukan aplikasi Android)
export async function modelStatus() {
  const P = scribPlugin(); if (!P) return 'unsupported';
  try { return (await P.status({ lang: scribLang() })).downloaded ? 'ready' : 'missing'; } catch { return 'missing'; }
}
export async function downloadModel() {
  const P = scribPlugin(); if (!P) return false;
  try { await P.download({ lang: scribLang() }); return true; } catch (e) { console.warn('unduh model', e); return false; }
}
export async function removeModel() {
  const P = scribPlugin(); if (!P) return false;
  try { await P.remove({ lang: scribLang() }); return true; } catch { return false; }
}

const PEN = '<svg viewBox="0 0 24 24"><path d="M14.5 4.5l3 3L8 17l-4 1 1-4z"/><path d="M13 20h7"/></svg>';

// Dipanggil saat alat Scribble dipilih. true = siap dipakai.
// force = dari tombol "Unduh" di layar Saya (tetap tampil walau penjelasan sudah pernah dilihat)
export async function ensureScribbleReady(force = false) {
  const st = await modelStatus();
  if (st === 'ready') return true;
  // penjelasan hanya sekali seumur aplikasi; sesudahnya model diunduh otomatis saat pertama menulis
  if (settings.scribIntroSeen && !force) return true;
  return new Promise((resolve) => {
    let done = false;
    const finish = (v) => { if (done) return; done = true; settings.scribIntroSeen = true; saveSettings(); resolve(v); };
    const native = st !== 'unsupported';
    const s = openSheet(`
      <div class="scr-intro">
        <div class="scr-demo"><span class="scr-ink">${PEN}<i>halo</i></span><span class="scr-arrow">→</span><span class="scr-text">halo</span></div>
        <h3>Scribble: tulis tangan jadi teks</h3>
        <p>Tulis langsung di kertas dengan pena atau jari. Saat kamu berhenti sejenak, tulisanmu berubah jadi teks rapi yang bisa disalin, diedit, dan diberi format.</p>
        ${native ? `
        <ul class="scr-facts">
          <li><b>Unduhan sekali, sekitar 20 MB</b> untuk ${scribLangName()}.</li>
          <li>Perlu internet saat mengunduh. Setelah itu Scribble jalan <b>tanpa internet</b>.</li>
          <li>Tulisanmu dibaca di HP ini, tidak pernah dikirim ke internet.</li>
        </ul>
        <div class="scr-state" id="scr-state" hidden></div>
        <div class="actions" id="scr-act"><button class="btn ghost" id="scr-later">Nanti saja</button><button class="btn primary" id="scr-go">Unduh sekarang</button></div>`
        : `<p class="scr-note">Scribble berjalan di aplikasi Cherry untuk Android. Di sini tulisan disimpan sebagai coretan biasa.</p>
        <div class="actions"><button class="btn primary" id="scr-ok">Oke</button></div>`}
      </div>`, { onClose: () => finish(false) });
    if (!native) { $('#scr-ok', s).onclick = () => { finish(true); closeSheet(); }; return; }
    const state = $('#scr-state', s), act = $('#scr-act', s);
    $('#scr-later', s).onclick = () => { finish(false); closeSheet(); };
    const go = async () => {
      act.hidden = true; state.hidden = false;
      state.className = 'scr-state busy';
      state.innerHTML = '<div class="scr-bar"><i></i></div><span>Mengunduh pengenal tulisan… biarkan aplikasi tetap terbuka.</span>';
      const ok = await downloadModel();
      if (ok) {
        state.className = 'scr-state ok';
        state.innerHTML = '<span>Siap dipakai. Silakan mulai menulis.</span>';
        setTimeout(() => { finish(true); closeSheet(); toast('Scribble siap dipakai'); }, 900);
      } else {
        state.className = 'scr-state err';
        state.innerHTML = '<span>Gagal mengunduh. Pastikan HP tersambung ke internet, lalu coba lagi.</span>';
        act.hidden = false; $('#scr-go', s).textContent = 'Coba lagi';
      }
    };
    $('#scr-go', s).onclick = go;
  });
}
