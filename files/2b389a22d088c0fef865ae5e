// ---------- Fluent Emoji 3D (Microsoft, lisensi MIT) ----------
let flIndex = null;
async function loadFluent() {
  if (!flIndex) flIndex = fetch('stickers/fluent/index.json').then((r) => r.json()).catch(() => []);
  return flIndex;
}
export const isFluent = (v) => typeof v === 'string' && v.startsWith('fl:');
const flURL = (v) => `stickers/fluent/${v.slice(3)}.webp`;

// Gambar stiker berbasis file (SVG bawaan / 3D) untuk canvas — dicache per URL
const urlImgs = new Map();
function urlImage(url, onload) {
  let e = urlImgs.get(url);
  if (!e) { const img = new Image(); e = { img, ok: false, waiters: [] }; img.onload = () => { e.ok = true; e.waiters.splice(0).forEach((f) => f()); }; img.src = url; urlImgs.set(url, e); }
  if (!e.ok && onload) e.waiters.push(onload);
  return e.ok ? e.img : null;
}
export function stickerImage(v, onload) { return isFluent(v) ? urlImage(flURL(v), onload) : svgImage(v, onload); }
export function stickerImageReady(v) { return new Promise((r) => { const im = stickerImage(v, () => r(stickerImage(v))); if (im) r(im); }); }

// ---------- Stiker saya (hasil impor pengguna, disimpan di perangkat) ----------
// v = 'my:<blobId>'
let mine = []; // [{ id, a }]
const mineURL = new Map();
export async function loadMyStickers() {
  const rec = await db.get('kv', 'mystickers');
  mine = rec?.value || [];
  await Promise.all(mine.map(async (s) => { const b = await db.get('blobs', s.id); if (b) mineURL.set(s.id, URL.createObjectURL(b.blob)); }));
}
const saveMine = () => db.put('kv', { id: 'mystickers', value: mine });

// Dipanggil saat layar pembuka: siapkan daftar 3D, gambar stiker saya, dan stiker bawaan supaya panel stiker langsung tampil
export async function preloadStickers() {
  const decode = (src) => { const im = new Image(); im.src = src; return im.decode().catch(() => {}); };
  const fl = await loadFluent();
  await Promise.all([
    ...[...mineURL.values()].slice(0, 60).map(decode),
    ...fl.slice(0, 48).map((x) => decode(flURL('fl:' + x.f))),
    ...Object.keys(SVG_STICKERS).map((id) => svgImageReady(id)),
  ]);
}
export const isMine = (v) => typeof v === 'string' && v.startsWith('my:');
export const mineId = (v) => v.slice(3);
export const isEmoji = (v) => !isSvgSticker(v) && !isMine(v) && !isFluent(v);
async function importMine(files, onProgress) {
  let n = 0;
  for (const f of files) {
    const parts = await splitStickerFile(f);
    // urutan sesuai lembar (kiri→kanan, atas→bawah), lembar terbaru di depan
    const added = [];
    for (const p of parts) {
      const id = 'stk' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
      await db.put('blobs', { id, blob: p.blob });
      mineURL.set(id, URL.createObjectURL(p.blob));
      added.push({ id, a: p.a }); n++;
      onProgress?.(n);
    }
    mine = [...added, ...mine];
  }
  await saveMine();
  return n;
}
// Paket stiker bawaan (lembar milik pengguna) — dipotong otomatis sekali saat pertama dibuka
const BUNDLED = ['stickers/pack-girl.webp', 'stickers/pack-axolotl.webp', 'stickers/pack-words.webp',
  'stickers/pack-frog.webp', 'stickers/pack-axolotl-pink.webp', 'stickers/pack-chick.webp', 'stickers/pack-doodle.webp', 'stickers/pack-hearts.webp'];
export async function seedBundledStickers() {
  // catat paket yang sudah dipotong, supaya paket baru ikut masuk tanpa menggandakan yang lama
  const norm = (u) => u.replace(/\.(png|webp)$/, '');
  const rec = await db.get('kv', 'stickers-seeded');
  const done = (rec?.value === true ? BUNDLED.slice(0, 3) : Array.isArray(rec?.value) ? rec.value : []).map(norm);
  const todo = BUNDLED.filter((u) => !done.includes(norm(u)));
  if (!todo.length) return 0;
  const files = [];
  for (const url of todo) { try { const r = await fetch(url); if (r.ok) files.push(await r.blob()); } catch {} }
  if (!files.length) return 0;
  const before = mine.length;
  await importMine(files.reverse());
  await db.put('kv', { id: 'stickers-seeded', value: [...done, ...todo.map(norm)] });
  return mine.length - before;
}
async function removeMine(id) {
  // gambar tetap disimpan agar stiker yang sudah ditempel tidak hilang; hanya dikeluarkan dari daftar
  mine = mine.filter((s) => s.id !== id); await saveMine();
}

export function stickerURL(id) { return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(SVG_STICKERS[id]); }
export function isSvgSticker(v) { return v in SVG_STICKERS; }
// rasio lebar:tinggi stiker
export function stickerAspect(v) {
  if (isMine(v)) return mine.find((s) => s.id === mineId(v))?.a || 1;
  const m = SVG_STICKERS[v]?.match(/viewBox="0 0 (\d+) (\d+)"/);
  return m ? +m[1] / +m[2] : 1;
}

// HTML untuk satu stiker (dipakai di popup catatan & pemilih)
export function stickerHTML(v) {
  if (isFluent(v)) return `<img src="${flURL(v)}" alt="" loading="lazy" draggable="false">`;
  if (isMine(v)) return `<img src="${mineURL.get(mineId(v)) || ''}" data-blob="${mineId(v)}" alt="" loading="lazy" draggable="false">`;
  return isSvgSticker(v) ? `<img src="${stickerURL(v)}" alt="" draggable="false">` : `<span class="emo">${esc(v)}</span>`;
}
// muat gambar stiker-saya yang belum ada URL-nya (mis. setelah pulihkan cadangan)
export async function hydrateMine(root) {
  for (const img of root.querySelectorAll('img[data-blob]')) {
    if (img.getAttribute('src')) continue;
    const id = img.dataset.blob;
    if (!mineURL.has(id)) { const b = await db.get('blobs', id); if (b) mineURL.set(id, URL.createObjectURL(b.blob)); }
    img.src = mineURL.get(id) || '';
  }
}

// Gambar stiker di canvas (emoji via teks, SVG via gambar yang dicache)
const svgImgs = new Map();
export function svgImage(id, onload) {
  let e = svgImgs.get(id);
  if (!e) {
    const img = new Image(); e = { img, ok: false, waiters: [] };
    img.onload = () => { e.ok = true; e.waiters.splice(0).forEach((f) => f()); };
    img.src = stickerURL(id); svgImgs.set(id, e);
  }
  if (!e.ok && onload) e.waiters.push(onload);
  return e.ok ? e.img : null;
}
export function svgImageReady(id) { return new Promise((r) => { const im = svgImage(id, () => r(svgImage(id))); if (im) r(im); }); }

// Panel pemilih stiker (tab kategori). onPick(v)
let lastTab = null;
let flQuery = '', flGroup = 'Semua';
async function drawFluent(container, onPick) {
  const idx = await loadFluent();
  const groups = ['Semua', ...new Set(idx.map((x) => x.g))];
  const gEl = container.querySelector('.fl-groups'), grid = container.querySelector('.fl-grid'), q = container.querySelector('.fl-q');
  if (!gEl) return;
  gEl.innerHTML = groups.map((g) => `<button class="stk-tab ${g === flGroup ? 'on' : ''}" data-g="${esc(g)}">${esc(g)}</button>`).join('');
  let limit = 96;
  const filtered = () => {
    const words = flQuery.toLowerCase().split(/\s+/).filter(Boolean);
    return idx.filter((x) => (flGroup === 'Semua' || x.g === flGroup) && words.every((w) => x.n.includes(w) || x.k.includes(w)));
  };
  const fill = () => {
    const list = filtered();
    grid.innerHTML = list.slice(0, limit).map((x) => `<button class="stk" data-v="fl:${x.f}" title="${esc(x.n)}">${stickerHTML('fl:' + x.f)}</button>`).join('') || '<div class="stk-empty">Tidak ditemukan.</div>';
    $$('[data-v]', grid).forEach((b) => b.onclick = (e) => { e.stopPropagation(); playStickerPop(); b.animate([{ transform: 'scale(1)' }, { transform: 'scale(1.35) rotate(-8deg)' }, { transform: 'scale(1)' }], { duration: 300, easing: 'cubic-bezier(.34,1.56,.64,1)' }); onPick(b.dataset.v); });
  };
  grid.onscroll = () => { if (grid.scrollTop + grid.clientHeight > grid.scrollHeight - 80) { const n = filtered().length; if (limit < n) { limit += 96; fill(); } } };
  $$('[data-g]', gEl).forEach((b) => b.onclick = (e) => { e.stopPropagation(); flGroup = b.dataset.g; limit = 96; $$('[data-g]', gEl).forEach((x) => x.classList.toggle('on', x === b)); fill(); grid.scrollTop = 0; });
  q.oninput = () => { flQuery = q.value; limit = 96; fill(); grid.scrollTop = 0; };
  q.onclick = (e) => e.stopPropagation();
  fill();
}
export function stickerPicker(container, onPick, { extra = '' } = {}) {
  let tab = lastTab || (mine.length ? MINE : 'Stiker');
  let manage = false;
  const draw = () => {
    lastTab = tab;
    let grid;
    if (tab === FL) {
      container.innerHTML = `<div class="stk-tabs">${Object.keys(TABS).map((t) => `<button class="stk-tab ${t === tab ? 'on' : ''}" data-tab="${t}">${t}</button>`).join('')}${extra}</div>
        <div class="fl-bar"><input class="inp fl-q" placeholder="Cari: cat, heart, cake, book…" value="${esc(flQuery)}"></div>
        <div class="stk-tabs fl-groups"></div><div class="stk-grid fl-grid"></div>`;
      $$('[data-tab]', container).forEach((b) => b.onclick = (e) => { e.stopPropagation(); tab = b.dataset.tab; manage = false; draw(); });
      drawFluent(container, onPick);
      return;
    }
    if (tab === MINE) {
      grid = `<div class="stk-mine-bar">
          <button class="stk-import" data-import>＋ Impor stiker</button>
          ${mine.length ? `<button class="stk-manage ${manage ? 'on' : ''}" data-manage>${manage ? 'Selesai' : 'Atur'}</button>` : ''}
          <span class="stk-hint">Gambar PNG atau lembar berisi banyak stiker; dipotong otomatis.</span></div>
        <div class="stk-grid big ${manage ? 'managing' : ''}">${mine.map((s) => `<button class="stk" data-v="my:${s.id}">${stickerHTML('my:' + s.id)}${manage ? `<i class="stk-x">${ICON.close}</i>` : ''}</button>`).join('') || '<div class="stk-empty">Belum ada stiker. Impor gambar stikermu sendiri.</div>'}</div>`;
    } else {
      grid = `<div class="stk-grid ${tab === 'Stiker' ? 'big' : ''}">${(tab === 'Stiker' ? Object.keys(SVG_STICKERS) : TABS[tab]).map((v) => `<button class="stk" data-v="${esc(v)}">${stickerHTML(v)}</button>`).join('')}</div>`;
    }
    container.innerHTML = `<div class="stk-tabs">${Object.keys(TABS).map((t) => `<button class="stk-tab ${t === tab ? 'on' : ''}" data-tab="${t}">${t}</button>`).join('')}${extra}</div>${grid}`;
    $$('[data-tab]', container).forEach((b) => b.onclick = (e) => { e.stopPropagation(); tab = b.dataset.tab; manage = false; draw(); });
    $$('[data-v]', container).forEach((b) => b.onclick = async (e) => {
      e.stopPropagation();
      if (manage) { await removeMine(mineId(b.dataset.v)); draw(); return; }
      b.animate([{ transform: 'scale(1)' }, { transform: 'scale(1.35) rotate(-8deg)' }, { transform: 'scale(1)' }], { duration: 300, easing: 'cubic-bezier(.34,1.56,.64,1)' });
      playStickerPop();
      onPick(b.dataset.v);
    });
    container.querySelector('[data-manage]')?.addEventListener('click', (e) => { e.stopPropagation(); manage = !manage; draw(); });
    container.querySelector('[data-import]')?.addEventListener('click', async (e) => {
      e.stopPropagation();
      const files = await pickFile('image/*', true); if (!files?.length) return;
      const btn = container.querySelector('[data-import]'); if (btn) btn.textContent = 'Memotong stiker…';
      try {
        const n = await importMine(files, (k) => { const b2 = container.querySelector('[data-import]'); if (b2) b2.textContent = `Memotong… ${k}`; });
        toast(n ? `${n} stiker ditambahkan` : 'Tidak ada stiker yang ditemukan');
      } catch (err) { console.error(err); toast('Gagal mengimpor gambar'); }
      tab = MINE; draw();
    });
  };
  draw();
}
