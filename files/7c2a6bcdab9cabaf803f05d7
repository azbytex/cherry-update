function onScroll() { updateIndicator(); if (E.rot) applyRot(); scheduleHiResAll(); }
function updateIndicator() {
  if (!E) return;
  const spread = isSpreadActive();
  if (spread) {
    const midX = E.pagesEl.getBoundingClientRect().left + E.pagesEl.clientWidth / 2;
    let best = 0, bd = Infinity;
    E.pages.forEach((p, i) => {
      const r = E.els.get(p.id).el.getBoundingClientRect();
      const d = Math.abs((r.left + r.right) / 2 - midX);
      if (d < bd) { bd = d; best = i; }
    });
    E.cur = best;
    const curSpr = Math.floor(best / 2);
    const left = curSpr * 2;
    const right = Math.min(E.pages.length, left + 2);
    const ind = $('#ed-ind');
    if (ind) ind.textContent = `${left + 1}–${right}/${E.pages.length}`;
    updateFlipButtons();
  } else {
    const midY = E.pagesEl.getBoundingClientRect().top + E.pagesEl.clientHeight / 2;
    let best = 0, bd = Infinity;
    E.pages.forEach((p, i) => {
      const r = E.els.get(p.id).el.getBoundingClientRect();
      const d = Math.abs((r.top + r.bottom) / 2 - midY);
      if (d < bd) { bd = d; best = i; }
    });
    E.cur = best;
    const ind = $('#ed-ind');
