function mountPage(pg, index) {
  const el = document.createElement('div');
  el.className = 'page';
  el.innerHTML = '<canvas class="c-bg"></canvas><canvas class="c-ink"></canvas><canvas class="c-live"></canvas><span class="pno"></span>';
  // tombol hapus halaman di bawah tiap halaman
  const del = document.createElement('button'); del.className = 'pdel'; del.title = 'Hapus halaman'; del.innerHTML = ICON.trash;
  del.onclick = (e) => { e.stopPropagation(); E.cur = E.pages.indexOf(pg); deletePage(); };
  el.appendChild(del);
  el._pg = pg;
  const rec = { el, bg: el.children[0], ink: el.children[1], live: el.children[2], rendered: false, visible: false };
  E.els.set(pg.id, rec);
  const ref = E.inner.children[index];
  E.inner.insertBefore(el, ref || null);
  E.io.observe(el);
  return rec;
}
function numberPages() { E.pages.forEach((p, i) => { const el = E.els.get(p.id).el; el.querySelector('.pno').textContent = `${i + 1}`; el.querySelector('.pdel').hidden = E.pages.length < 2; }); updateIndicator(); }

function isSpreadActive() {
  if (!E || E.pages.length < 2) return false;
  if (E.spreadMode === 'spread') return true;
  if (E.spreadMode === 'single') return false;
  const w = E.pagesEl.clientWidth, h = E.pagesEl.clientHeight;
  return w >= 660 && w > h * 0.92;
}

function totalSpreads() {
  if (!E || !E.pages.length) return 0;
  return Math.ceil(E.pages.length / 2);
}

function currentSpreadIndex() {
  if (!E || !E.pages.length || !isSpreadActive()) return 0;
  const spreadW = (E.spreadPw || 300) * 2 + (E.spreadGap || 60);
  if (!spreadW) return 0;
  const idx = Math.round(E.pagesEl.scrollLeft / spreadW);
  return Math.max(0, Math.min(totalSpreads() - 1, idx));
}

function spreadScrollLeft(idx) {
  if (!E || !isSpreadActive()) return 0;
  const spreadW = (E.spreadPw || 300) * 2 + (E.spreadGap || 60);
  return idx * spreadW;
}

function flipToSpread(idx, animated = true) {
  if (!E || !isSpreadActive()) return;
  const targetIdx = Math.max(0, Math.min(Math.max(0, totalSpreads() - 1), idx));
  const from = currentSpreadIndex();
  if (animated && Math.abs(targetIdx - from) === 1) { autoFlip(targetIdx > from ? 1 : -1); return; }
  jumpToSpread(targetIdx);
}

function nextSpread() {
  const cur = currentSpreadIndex();
  if (cur < totalSpreads() - 1) flipToSpread(cur + 1, true);
}

function prevSpread() {
  const cur = currentSpreadIndex();
  if (cur > 0) flipToSpread(cur - 1, true);
}

function snapCurrentSpread() { jumpToSpread(currentSpreadIndex()); }

function updateFlipButtons() {
  const prevBtn = $('#ed-prev-spread');
  const nextBtn = $('#ed-next-spread');
  if (!prevBtn || !nextBtn) return;
  if (!isSpreadActive()) {
    prevBtn.hidden = true;
    nextBtn.hidden = true;
    return;
  }
  const cur = currentSpreadIndex();
  const maxIdx = totalSpreads() - 1;
  prevBtn.hidden = cur <= 0;
  nextBtn.hidden = cur >= maxIdx;
}


