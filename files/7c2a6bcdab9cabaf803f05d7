// Ketuk kotak tanggal Monthly Plan → popup catatan berformat
function cellNote(pg, pt) {
  const lay = templateLayout(pg.tpl, metaOf(pg));
  const idx = cellAt(pg.tpl, lay, pt.x, pt.y);
  if (idx < 0) return false;
  let title = 'Kotak kosong', sub = '';
  if (pg.month) {
    const [y, m] = pg.month.split('-').map(Number);
    const first = (new Date(y, m - 1, 1).getDay() - settings.weekStart + 7) % 7;
    const n = idx - first + 1, days = new Date(y, m, 0).getDate();
    if (n >= 1 && n <= days) { const d = new Date(y, m - 1, n); title = `${n} ${MONTHS_LONG[m - 1]} ${y}`; sub = DAYS_LONG[d.getDay()]; }
  }
  const apply = (note) => {
    const before = snap(pg);
    pg.notes = { ...(pg.notes || {}) };
    if (note) pg.notes[idx] = note; else delete pg.notes[idx];
    pushUndo(before); markDirty(pg); drawInk(pg);
  };
  const openNote = () => cellPhotos(pg, idx, title, sub, apply);
  // ketuk tumpukan foto (kalau catatannya punya foto) = lihat fotonya dulu
  // hanya ikon foto yang membuka popup foto; sisa kotak adalah area kuas/teks
  const ic = lay.areas[1 + idx]?.icon;
  if (!ic || pt.x < ic.x - 10 || pt.x > ic.x + ic.w + 10 || pt.y < ic.y - 10 || pt.y > ic.y + ic.h + 10) return false;
  openNote();
  return true;
}

// Pratinjau foto layar penuh: geser kiri/kanan, ketuk latar atau tombol tutup untuk keluar
// Foto catatan dimuat & di-decode lebih dulu (saat kotak digambar), jadi pratinjau langsung tampil mulus
const pvCache = new Map();
