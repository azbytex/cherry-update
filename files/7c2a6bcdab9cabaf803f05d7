}
const EASE_OUT = 'cubic-bezier(.22,1,.36,1)';       // melambat lembut di akhir
const EASE_SPRING = 'cubic-bezier(.34,1.45,.64,1)'; // sedikit memantul

const monthTitle = (m) => { const [y, mo] = m.split('-').map(Number); return `${MONTHS_LONG[mo - 1]} ${y}`; };

async function openPhotoViewer(srcs, title, onOpenNote) {
  // Tumpukan polaroid: foto depan diketuk/digeser ke kiri → melengkung keluar lalu menyelip ke paling belakang,
  // foto di belakangnya maju. Geser ke kanan = foto paling belakang ditarik ke depan.
  const n = srcs.length;
  const order = srcs.map((_, k) => k); // order[0] = foto paling depan
  const TILT = [-1.5, 7, -8, 4, -5, 8.5];

  // tunggu semua foto siap (maks 400 ms; biasanya sudah di-preload saat kotak digambar)
  preloadPhotos(srcs);
  await Promise.race([Promise.all(srcs.map((s) => pvCache.get(s))), new Promise((r) => setTimeout(r, 400))]);

  const v = document.createElement('div');
  v.className = 'pv';
  v.innerHTML = `<div class="pv-top"><div class="pv-title">${esc(title)}<small></small></div>
      <button class="pv-btn" data-note>${ICON.note}<span>Buka catatan</span></button>
      <button class="pv-btn round" data-close title="Tutup">${ICON.close}</button></div>
    <div class="pv-stage"><div class="pv-deck">${srcs.map((s, k) => `<div class="pv-card" data-k="${k}"><img src="${s}" alt="" draggable="false"></div>`).join('')}</div></div>
    <div class="pv-hint">${n > 1 ? 'Ketuk atau geser foto untuk melihat berikutnya' : ''}</div>`;
  const stage = v.querySelector('.pv-stage'), cards = [...v.querySelectorAll('.pv-card')];
  const count = v.querySelector('.pv-title small');
  let busy = 0;

  const fit = () => {
    const W = stage.clientWidth * 0.78, H = stage.clientHeight * 0.8;
    cards.forEach((c) => {
      const im = c.querySelector('img'), a = (im.naturalWidth || 4) / (im.naturalHeight || 3);
      let w = Math.min(W, 560), h = w / a;
      if (h > H) { h = H; w = h * a; }
      im.style.width = w + 'px'; im.style.height = h + 'px';
    });
  };
  const posOf = (p) => {
    if (p === 0) return 'translate3d(0,0,0) rotate(-1.5deg) scale(1)';
    const d = Math.min(p, 4);
    return `translate3d(${(p % 2 ? 1 : -1) * (10 + d * 6)}px, ${d * 6}px, 0) rotate(${TILT[p % TILT.length]}deg) scale(${1 - d * 0.03})`;
  };
  const shade = (p) => (p === 0 ? 'brightness(1)' : `brightness(${1 - Math.min(p, 4) * 0.07})`);
  const place = (skip = -1, dur = 560) => {
    order.forEach((k, p) => {
      if (k === skip) return;
      const c = cards[k];
      c.style.transition = dur ? `transform ${dur}ms ${EASE_OUT}, filter ${dur}ms ${EASE_OUT}` : 'none';
      c.style.zIndex = String(n - p);
      c.style.transform = posOf(p);
      c.style.filter = shade(p);
    });
    count.textContent = n > 1 ? `${order[0] + 1} dari ${n} foto` : '1 foto';
  };
  const outPos = (dir) => `translate3d(${dir * Math.min(stage.clientWidth * 0.55, 420)}px, -26px, 0) rotate(${dir * 14}deg) scale(.96)`;

  // foto depan melengkung keluar lalu menyelip ke belakang, dalam satu gerakan tanpa patah
  const sendBack = (dir = -1) => {
    if (n < 2) return;
    const k = order.shift(); order.push(k);
    const c = cards[k], from = getComputedStyle(c).transform, D = 760;
    c.getAnimations().forEach((a) => a.cancel());
    c.style.transition = 'none';
    c.style.transform = posOf(n - 1); c.style.filter = shade(n - 1);
    place(k);
    busy++;
    c.animate([
      { transform: from === 'none' ? posOf(0) : from, filter: 'brightness(1)', easing: 'cubic-bezier(.25,.6,.35,1)' },
      { transform: outPos(dir), filter: 'brightness(1)', offset: 0.44, easing: 'cubic-bezier(.55,0,.25,1)' },
      { transform: posOf(n - 1), filter: shade(n - 1) },
    ], { duration: D });
    // tukar urutan lapisan tepat saat foto berada di luar tumpukan, jadi tidak terlihat "menembus"
    setTimeout(() => { c.style.zIndex = '0'; }, D * 0.44);
    setTimeout(() => { busy--; }, D * 0.5);
  };
  // foto paling belakang keluar ke kanan lalu mendarat di depan
  const bringFront = (from) => {
    if (n < 2) return;
    const k = order.pop(); order.unshift(k);
    const c = cards[k], D = 760;
    c.getAnimations().forEach((a) => a.cancel());
    c.style.transition = 'none';
    c.style.transform = posOf(0); c.style.filter = shade(0);
    place(k);
    busy++;
    c.animate([
      { transform: posOf(n - 1), filter: shade(n - 1), easing: 'cubic-bezier(.25,.6,.35,1)' },
      { transform: outPos(1), filter: 'brightness(1)', offset: 0.44, easing: 'cubic-bezier(.3,0,.2,1)' },
      { transform: posOf(0), filter: 'brightness(1)' },
    ], { duration: D });
    setTimeout(() => { c.style.zIndex = String(n + 1); }, D * 0.44);
    setTimeout(() => { c.style.zIndex = String(n); busy--; }, D);
    // kartu depan sebelumnya ikut mundur, mulai dari posisi gesernya (kalau sedang digeser)
    if (from) { const prev = cards[order[1]]; prev.animate([{ transform: from }, { transform: posOf(1) }], { duration: 560, easing: EASE_OUT }); }
  };

  let unBack = null;
  const close = () => {
    if (!v.isConnected || v.classList.contains('out')) return;
    unBack?.(); document.removeEventListener('keydown', key); removeEventListener('resize', onResize);
    v.classList.add('out');
    cards.forEach((c) => c.animate([{ opacity: 1, translate: '0 0', scale: '1' }, { opacity: 0, translate: '0 30px', scale: '.94' }], { duration: 260, easing: 'cubic-bezier(.4,0,1,1)', fill: 'forwards' }));
    setTimeout(() => v.remove(), 280);
  };
  const key = (e) => { if (e.key === 'Escape') close(); else if (e.key === 'ArrowRight' || e.key === ' ') sendBack(-1); else if (e.key === 'ArrowLeft') bringFront(); };
  const onResize = () => { fit(); place(-1, 0); };
  v.querySelector('[data-close]').onclick = close;
  v.querySelector('[data-note]').onclick = () => { close(); onOpenNote(); };

  // geser kartu depan mengikuti jari (pakai rAF supaya mulus)
  let g = null, raf = 0;
  stage.addEventListener('pointerdown', (e) => {
    const card = e.target.closest('.pv-card');
    g = { x: e.clientX, y: e.clientY, dx: 0, dy: 0, onFront: card && +card.dataset.k === order[0], moved: false, t: performance.now() };
    try { stage.setPointerCapture(e.pointerId); } catch {}
  });
  stage.addEventListener('pointermove', (e) => {
    if (!g) return;
    g.dx = e.clientX - g.x; g.dy = e.clientY - g.y;
    if (Math.hypot(g.dx, g.dy) > 6) g.moved = true;
    if (!g.moved || !g.onFront || n < 2) return;
    const c = cards[order[0]];
    if (!raf) raf = requestAnimationFrame(() => {
      raf = 0; if (!g) return;
      c.getAnimations().forEach((a) => a.cancel());
      c.style.transition = 'none';
      c.style.transform = `translate3d(${g.dx}px, ${g.dy * 0.2}px, 0) rotate(${-1.5 + g.dx / 18}deg)`;
    });
  });
  const up = (e) => {
    if (!g) return;
    const s = g; g = null; cancelAnimationFrame(raf); raf = 0;
    if (!s.moved) { if (s.onFront) sendBack(-1); else close(); return; }
    if (!s.onFront || n < 2) return;
    const vx = s.dx / Math.max(1, performance.now() - s.t); // kecepatan: sentil cepat juga dihitung
    if (s.dx < -70 || vx < -0.6) sendBack(-1);
    else if (s.dx > 70 || vx > 0.6) bringFront(cards[order[0]].style.transform);
    else { const c = cards[order[0]]; c.style.transition = `transform 520ms ${EASE_SPRING}`; c.style.transform = posOf(0); }
  };
  stage.addEventListener('pointerup', up);
  stage.addEventListener('pointercancel', () => { g = null; place(); });

  document.addEventListener('keydown', key);
  addEventListener('resize', onResize);
  unBack = pushBack(close); // tombol kembali HP menutup pratinjau
  document.body.appendChild(v);
  fit(); place(-1, 0);
  // masuk: latar memudar, foto naik satu per satu dari belakang ke depan
  order.slice().reverse().forEach((k, j) => cards[k].animate(
    [{ opacity: 0, translate: '0 46px', scale: '.9' }, { opacity: 1, translate: '0 0', scale: '1' }],
    { duration: 620, delay: 60 + j * 70, easing: EASE_OUT, fill: 'backwards' }));
}

