}

// ---------- Popup kotak tanggal: khusus foto ----------
// Teks ditulis langsung di kertas dengan alat T. Di sini hanya menambah, melihat, dan menghapus foto hari itu.
function cellPhotos(pg, idx, title, sub, apply) {
  const note = normNote(pg.notes?.[idx]);
  let floats = note.floats.slice();
  const save = () => { const keep = note.html || floats.length; apply(keep ? { html: note.html, floats } : null); };
  const s = openSheet(`
    <div class="rn-head"><div><h3 style="margin:0">${esc(title)}</h3>${sub ? `<div class="rn-sub">${esc(sub)}</div>` : ''}</div>
      <button class="ib sm" id="cp-x" title="Tutup">${ICON.close}</button></div>
    <div class="cp-grid" id="cp-grid"></div>
    <div class="actions"><button class="btn ghost" id="cp-cam">${ICON.image}<span>Kamera</span></button><button class="btn primary" id="cp-gal">${ICON.image}<span>Galeri</span></button></div>`);
  const grid = $('#cp-grid', s);
  const draw = () => {
    const imgs = floats.filter((f) => f.t === 'img');
    grid.innerHTML = imgs.length
      ? imgs.map((f, i) => `<div class="cp-item" style="--i:${i}"><img src="${f.src}" alt="" data-v="${i}"><button class="cp-del" data-d="${i}" title="Hapus foto">${ICON.close}</button></div>`).join('')
      : '<div class="cp-empty">Belum ada foto di tanggal ini.<br>Tambahkan dari kamera atau galeri.</div>';
    $$('[data-v]', grid).forEach((im) => im.onclick = () => openPhotoViewer(imgs.map((f) => f.src), title, () => {}));
    $$('[data-d]', grid).forEach((b) => b.onclick = async () => {
      if (!(await askDelete())) return;
      const f = imgs[+b.dataset.d]; floats = floats.filter((x) => x !== f); save(); draw();
    });
  };
  // konfirmasi kecil tanpa menutup lembar
  const askDelete = () => askUnsaved(false, 'Foto ini akan dihapus dari tanggal ini.', { title: 'Hapus foto?', discard: 'Hapus', keep: 'Batal' }).then((r) => r === 'discard');
  const add = async (source) => {
    const url = await pickImage(source); if (!url) return;
    const im = new Image(); im.src = url; await im.decode().catch(() => {});
    floats.push({ t: 'img', src: url, x: 0.08 + Math.random() * 0.1, y: 0.06, w: 0.42, a: (im.naturalWidth || 4) / (im.naturalHeight || 3), r: 0 });
    save(); draw(); toast('Foto ditambahkan');
  };
  $('#cp-cam', s).onclick = () => add('camera');
  $('#cp-gal', s).onclick = () => add('gallery');
  $('#cp-x', s).onclick = () => closeSheet();
  draw();
}

// ---------- Kanvas tajam saat zoom besar ----------
// Kanvas halaman maksimal 2400 px; di atas zoom 220% hanya bagian halaman yang terlihat digambar ulang
// dengan resolusi penuh layar, jadi garis kertas & coretan tetap tajam sampai 1500%.
const HI_ZOOM = 2.2;
const hiTimers = new Map();
// HP dengan RAM kecil: lapisan tajam lebih kecil (cadangan geser lebih sempit) supaya tidak macet
const DEV_MEM = navigator.deviceMemory || 4;
const LOW_MEM = DEV_MEM <= 4;
const HI_CAP = DEV_MEM <= 2 ? 3.5e6 : DEV_MEM <= 4 ? 6e6 : 9e6;
const hiForce = new Set();
function scheduleHiRes(pg, force = false) {
  if (!E) return;
  if (force) hiForce.add(pg.id);
  clearTimeout(hiTimers.get(pg.id));
  hiTimers.set(pg.id, setTimeout(() => { const f = hiForce.delete(pg.id); renderHiRes(pg, f); }, 70));
}
function scheduleHiResAll() { if (E) for (const p of E.pages) { const r = E.els.get(p.id); if (r?.visible || r?.hi) scheduleHiRes(p); } }
function dropHiRes(r) { r.hi?.remove(); r.hiLive?.remove(); r.hi = r.hiLive = r.hiInfo = null; }
async function renderHiRes(pg, force = false) {
  const r = E?.els.get(pg.id); if (!r) return;
  const needPx = parseFloat(r.el.style.width) * Math.min(3, devicePixelRatio || 1);
  if (needPx <= r.ink.width * 1.02 || !r.visible || !r.rendered || E.rot) return dropHiRes(r);
  const bm = pg.bg ? await getBitmap(pg.bg) : null; // siapkan dulu, sebelum kanvas dikosongkan
  if (!E || !r.el.isConnected) return;
  const pr = E.pagesEl.getBoundingClientRect(), er = r.el.getBoundingClientRect();
  const vx = Math.max(0, pr.left - er.left), vy = Math.max(0, pr.top - er.top);
  const vw = Math.min(er.width, pr.right - er.left) - vx, vh = Math.min(er.height, pr.bottom - er.top) - vy;
  if (vw <= 2 || vh <= 2) return dropHiRes(r);
  const dpr = Math.min(LOW_MEM ? 2 : 2.5, devicePixelRatio || 1);
  // lapisan tajam masih menutupi layar di ukuran zoom yang sama → tidak perlu digambar ulang (tidak ada "loncat")
  const cv = r.hiInfo?.cover;
  if (!force && r.hi && cv && Math.abs(cv.pw - er.width) < 0.5 && vx >= cv.x0 - 1 && vy >= cv.y0 - 1 && vx + vw <= cv.x1 + 1 && vy + vh <= cv.y1 + 1) return;
  // gambar lebih luas dari layar (cadangan setengah layar tiap arah), dibatasi ±16 juta piksel supaya hemat memori
  let m = 0.5, x0, y0, x1, y1;
  for (;;) {
    x0 = Math.max(0, vx - vw * m); y0 = Math.max(0, vy - vh * m);
    x1 = Math.min(er.width, vx + vw * (1 + m)); y1 = Math.min(er.height, vy + vh * (1 + m));
    if ((x1 - x0) * (y1 - y0) * dpr * dpr <= HI_CAP || m <= 0) break;
    m = Math.max(0, m - 0.1);
  }
  if (!r.hi) {
    r.hi = document.createElement('canvas'); r.hi.className = 'c-hi';
    r.hiLive = document.createElement('canvas'); r.hiLive.className = 'c-hi';
    r.el.insertBefore(r.hi, r.live); r.live.after(r.hiLive);
  }
  const W = er.width * dpr, H = er.height * dpr, s = W / pg.w;
  const cw = x1 - x0, ch = y1 - y0;
  for (const c of [r.hi, r.hiLive]) {
    c.width = Math.round(cw * dpr); c.height = Math.round(ch * dpr);
    Object.assign(c.style, { left: x0 + 'px', top: y0 + 'px', width: cw + 'px', height: ch + 'px' });
  }
  r.hiInfo = { vx: x0, vy: y0, dpr, s, cover: { x0, y0, x1, y1, pw: er.width } };
  const ctx = r.hi.getContext('2d');
  ctx.setTransform(1, 0, 0, 1, -x0 * dpr, -y0 * dpr);
  drawTemplate(ctx, W, H, pg.tpl, pg.paper, metaOf(pg));
  if (bm) ctx.drawImage(bm, 0, 0, W, H);
  drawInkTo(ctx, pg, s);
}
function drawHiStroke(pg, st) {
  const r = E.els.get(pg.id); if (!r?.hi || !r.hiInfo) return;
  const ctx = r.hi.getContext('2d'); ctx.setTransform(1, 0, 0, 1, -r.hiInfo.vx * r.hiInfo.dpr, -r.hiInfo.vy * r.hiInfo.dpr);
  drawStroke(ctx, st, r.hiInfo.s);
}

// ---------- Ukuran kuas (slider & popup) ----------
// Skala logaritmik: geser pelan di kiri untuk ukuran sangat kecil, ke kanan untuk ukuran besar
const BRUSH_RANGE = { pen: [0.3, 40], hl: [4, 80], eraser: [3, 120], shape: [0.3, 40] };
const brushW = (t, cfg) => cfg?.w ?? SIZES[t]?.[cfg?.z ?? 1] ?? 4.5;
