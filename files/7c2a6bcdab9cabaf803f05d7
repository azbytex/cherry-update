  mountPage(pg, at);
  layout();
  playPageFlip();
  await db.put('pages', pg);
  E.nb.updated = Date.now(); await saveNotebook(E.nb);
  if (isSpreadActive()) {
    flipToSpread(Math.floor(at / 2), true);
