}

// ---------- Format teks (alat T) ----------
const TEXT_FMT_KEYS = ['b', 'it', 'u', 'st', 'al', 'hl'];
const ALIGN_ICON = {
  left: '<svg viewBox="0 0 24 24"><path d="M4 6h16M4 10h10M4 14h16M4 18h10"/></svg>',
  center: '<svg viewBox="0 0 24 24"><path d="M4 6h16M7 10h10M4 14h16M7 18h10"/></svg>',
  right: '<svg viewBox="0 0 24 24"><path d="M4 6h16M10 10h10M4 14h16M10 18h10"/></svg>',
};
const HL_CYCLE = ['', '#ffe066', '#ffadc8', '#b2f2bb', '#a5d8ff'];
function textFmtHTML(cfg) {
  const on = (k) => (cfg[k] ? 'on' : '');
  const al = cfg.al || 'left';
  return `<span class="tf-sep"></span>
    <button class="tfbtn ${on('b')}" data-tf="b" title="Tebal"><b>B</b></button>
    <button class="tfbtn ${on('it')}" data-tf="it" title="Miring"><i style="font-family:Georgia,serif">I</i></button>
    <button class="tfbtn ${on('u')}" data-tf="u" title="Garis bawah"><u>U</u></button>
    <button class="tfbtn ${on('st')}" data-tf="st" title="Coret"><s>S</s></button>
    <button class="tfbtn" data-tf="al" title="Rata kiri / tengah / kanan">${ALIGN_ICON[al]}</button>
    <button class="tfbtn ${on('hl')}" data-tf="hl" title="Stabilo"><span class="tf-hl" style="background:${cfg.hl || 'transparent'}">ab</span></button>`;
}
// alat format berlaku untuk teks yang sedang diketik / dipilih, dan untuk teks baru berikutnya
function bindTextFmt(cfg) {
  // tombol tidak mengambil fokus, jadi teks yang sedang diketik tetap terbuka
  $$('#ed-sizes [data-tf], #ed-font').forEach((b) => { b.onpointerdown = (e) => e.preventDefault(); b.onmousedown = (e) => e.preventDefault(); });
  $$('#ed-sizes [data-tf]').forEach((b) => b.onclick = () => {
    const k = b.dataset.tf;
    const target = E.textInput?.t || (sel?.t?.lk ? null : sel?.t);
    if (k === 'al') {
      const order = ['left', 'center', 'right'];
      const current = target?.al || cfg.al || 'left';
      const next = order[(order.indexOf(current) + 1) % 3];
      cfg.al = next;
      if (target) { if (next === 'left') delete target.al; else target.al = next; }
    } else if (k === 'hl') {
      const current = target?.hl || cfg.hl || '';
      const next = HL_CYCLE[(HL_CYCLE.indexOf(current) + 1) % HL_CYCLE.length];
      cfg.hl = next;
      if (target) { if (next) target.hl = next; else delete target.hl; }
    } else {
      const current = target ? !!target[k] : !!cfg[k];
      const next = !current;
      cfg[k] = next;
      if (target) { if (next) target[k] = true; else delete target[k]; }
    }
    saveSettings();
    if (target) {
      const pg = E.textInput?.pg || sel?.pg;
      if (pg) {
        const curBefore = snap(pg);
        if (E.textInput) styleTextarea(E.textInput.ta, target);
        pushUndo(curBefore); markDirty(pg); drawInk(pg);
        if (sel?.t === target) {
          const r = E.els.get(pg.id);
          const kk = parseFloat(r.el.style.width) / pg.w;
          const bx = textBox(target);
          sel.box.update({ x: bx.x * kk, y: bx.y * kk, w: bx.w * kk, h: bx.h * kk, r: target.r || 0 });
        }
      }
    }
