    pg.texts.push(t);
    clearLive(pg); drawInk(pg); pushUndo(before); markDirty(pg);
    // Langsung pilih teks yang baru dikonversi agar kotak seleksi transform langsung aktif
    selectText(pg, t);
  } catch (e) {
    console.warn('scribble', e);
    keepAsInk(String(e?.message || e).toLowerCase().includes('download') || !navigator.onLine
