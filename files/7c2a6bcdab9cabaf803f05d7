async function deletePage() {
  const pg = E.pages[E.cur];
  if (E.pages.length === 1) { toast('Buku harus punya minimal 1 halaman'); return; }
  if (!(await confirmDialog(`Hapus halaman ${E.cur + 1}? Tindakan ini tidak bisa dibatalkan.`, { ok: 'Hapus', danger: true }))) return;
  const r = E.els.get(pg.id); E.io.unobserve(r.el); r.el.remove(); E.els.delete(pg.id);
  E.pages.splice(E.cur, 1);
  E.nb.pageIds = E.pages.map((p) => p.id);
  E.undo = E.undo.filter((s) => s.pg !== pg); E.redo = E.redo.filter((s) => s.pg !== pg); syncUndo();
  E.dirty.delete(pg);
  await db.del('pages', pg.id);
  if (pg.bg) await db.del('blobs', pg.bg);
  E.nb.updated = Date.now(); await saveNotebook(E.nb);
  playTrashCrumple();
  layout(); updateIndicator();
}

