    const d = new Date(y, m, 1); month = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
  }
  const pg = opts.page || newPage(E.nb.id, { tpl, paper: ref?.paper || E.nb.paper, date: tpl === 'daily' ? ref?.date : undefined, month });
  pg.nb = E.nb.id;
