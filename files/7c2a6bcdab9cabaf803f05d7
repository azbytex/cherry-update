  // bounding box tulisan
  let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
  for (const st of job.strokes) for (let i = 0; i < st.p.length; i += 3) { x0 = Math.min(x0, st.p[i]); y0 = Math.min(y0, st.p[i + 1]); x1 = Math.max(x1, st.p[i]); y1 = Math.max(y1, st.p[i + 1]); }
