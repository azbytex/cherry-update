// ---------- Pilih teks di halaman: geser, ubah ukuran (huruf ikut membesar), putar ----------
function selectText(pg, t, e) {
  deselectItem();
  const r = E.els.get(pg.id);
  const k = () => parseFloat(r.el.style.width) / pg.w;
  const box = createTransformBox(r.el);
  let before = snap(pg);
  sel = { pg, t, box };

  let b0 = textBox(t);
  let z0 = t.z, lh0 = t.lh, w0 = t.w, bw0 = b0.w;
  const toBox = () => { const b = textBox(t), kk = k(); return { x: b.x * kk, y: b.y * kk, w: b.w * kk, h: b.h * kk, r: t.r || 0 }; };
  const rebaseline = () => { b0 = textBox(t); z0 = t.z; lh0 = t.lh; w0 = t.w; bw0 = b0.w; };

  box.attach(toBox(), {
    viewRot: () => E?.rot || 0,
    min: 16, max: () => parseFloat(r.el.style.width) * 1.5,
    label: () => Math.round(t.z) + ' pt',
    onDuplicate: () => {
      const clone = { ...t, x: t.x + 24, y: t.y + 24 };
      const curBefore = snap(pg);
      pg.texts.push(clone);
      pushUndo(curBefore); markDirty(pg); drawInk(pg);
      selectText(pg, clone);
      toast('Teks diduplikasi');
    },
    sideFree: true,
    locked: () => !!t.lk,
    onLock: () => { pushUndo(snap(pg)); t.lk = !t.lk; markDirty(pg); before = snap(pg); toast(t.lk ? 'Teks dikunci' : 'Kunci dibuka'); syncToolbar(); },
    onChange: (m) => {
      const kk = k();
