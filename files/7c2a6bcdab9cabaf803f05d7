const fromSlider = (t, v) => { const [a, b] = BRUSH_RANGE[t] || [0.5, 40]; return +(a * Math.pow(b / a, Math.max(0, Math.min(100, v)) / 100)).toFixed(1); };

function sizeSlider(t, cfg) {
  const w = brushW(t, cfg);
  const box = $('#ed-sizes');
