    },
  });
  syncToolbar();
  if (e) box.el.dispatchEvent(new PointerEvent("pointerdown", e));
}

// ---------- Cari kata di PDF (teks yang tersimpan saat PDF diimpor) ----------
let FIND = null;
function closeFind() { if (!FIND) return; FIND.bar.remove(); document.querySelectorAll('.find-hl').forEach((x) => x.remove()); FIND = null; }
function openFind() {
  if (FIND) { FIND.input.focus(); return; }
  if (!E.pages.some((p) => p.pt?.length)) { toast('Buku ini belum punya teks PDF. Impor ulang PDF-nya supaya bisa dicari.'); return; }
  const bar = document.createElement('div');
  bar.className = 'find-bar';
  bar.innerHTML = '<input type="search" placeholder="Cari kata di PDF" enterkeyhint="search"><span class="find-n">0/0</span><button class="fb-prev" title="Sebelumnya">‹</button><button class="fb-next" title="Berikutnya">›</button><button class="fb-copy" title="Salin semua teks PDF">' + ICON.copy + '</button><button class="fb-x" title="Tutup">' + ICON.close + '</button>';
  $('#editor').appendChild(bar);
  const input = bar.querySelector('input'), nEl = bar.querySelector('.find-n');
  FIND = { bar, input, hits: [], i: -1 };
  const show = () => {
    document.querySelectorAll('.find-hl').forEach((x) => x.remove());
    FIND.hits.forEach((h, j) => {
      const el = E.els.get(h.pg.id)?.el; if (!el) return;
      const d = document.createElement('i');
      d.className = 'find-hl' + (j === FIND.i ? ' on' : '');
      Object.assign(d.style, { left: h.x / h.pg.w * 100 + '%', top: h.y / h.pg.h * 100 + '%', width: h.w / h.pg.w * 100 + '%', height: h.h / h.pg.h * 100 + '%' });
      el.appendChild(d); h.el = d;
    });
    nEl.textContent = FIND.hits.length ? (FIND.i + 1) + '/' + FIND.hits.length : '0/0';
    FIND.hits[FIND.i]?.el?.scrollIntoView({ block: 'center', inline: 'center', behavior: 'smooth' });
  };
  const run = () => {
    const q = input.value.trim().toLowerCase(); FIND.hits = []; FIND.i = -1;
    if (q.length >= 1) for (const pg of E.pages) for (const it of pg.pt || []) {
      const low = it.s.toLowerCase(); let k = low.indexOf(q);
      while (k >= 0) {
        const L = it.s.length || 1;
        FIND.hits.push({ pg, x: it.x + it.w * k / L, y: it.y, w: Math.max(4, it.w * q.length / L), h: it.h });
        k = low.indexOf(q, k + q.length);
      }
    }
    if (FIND.hits.length) FIND.i = 0;
    show();
  };
  const go = (d) => { if (!FIND.hits.length) return; FIND.i = (FIND.i + d + FIND.hits.length) % FIND.hits.length; show(); };
  let t; input.oninput = () => { clearTimeout(t); t = setTimeout(run, 180); };
  input.onkeydown = (e) => { if (e.key === 'Enter') { e.preventDefault(); go(e.shiftKey ? -1 : 1); } if (e.key === 'Escape') closeFind(); };
  bar.querySelector('.fb-prev').onclick = () => go(-1);
  bar.querySelector('.fb-next').onclick = () => go(1);
  bar.querySelector('.fb-x').onclick = closeFind;
  bar.querySelector('.fb-copy').onclick = () => copyText(E.pages.map((p) => pdfPageText(p)).filter(Boolean).join('\n\n'));
  bar.addEventListener('pointerdown', (e) => e.stopPropagation());
  input.focus();
}
function pdfPageText(pg) {
  const its = pg.pt || []; let out = '', last = null;
  for (const it of its) {
    if (last) out += Math.abs(it.y - last.y) > last.h * 0.6 ? '\n' : (it.x - (last.x + last.w) > it.h * 0.15 && !/\s$/.test(out) ? ' ' : '');
    out += it.s; last = it;
  }
  return out.trim();
}
