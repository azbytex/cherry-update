function itemAt(pg, pt) {
  const items = pg.items || [];
  for (let i = items.length - 1; i >= 0; i--) {
    const it = items[i], c = Math.cos(-(it.r || 0)), sn = Math.sin(-(it.r || 0));
    const dx = pt.x - it.x, dy = pt.y - it.y;
    const lx = dx * c - dy * sn, ly = dx * sn + dy * c;
    // area sentuh minimal ±28 satuan supaya stiker kecil tetap gampang dipilih
    if (Math.abs(lx) <= Math.max(it.w / 2 + 6, 28) && Math.abs(ly) <= Math.max(it.h / 2 + 6, 28)) return it;
  }
  return null;
}
