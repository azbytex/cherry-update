    const cfg = pens().text;
    const strokeH = Math.max(14, y1 - y0);
    const strokeW = Math.max(20, x1 - x0);
    const lines = text.split('\n');
    const numLines = Math.max(1, lines.length);
    const lineH = strokeH / numLines;
    const estZ = Math.max(12, Math.min(180, Math.round(lineH * 0.85)));

    const m = measurer(estZ, { f: cfg.f, b: cfg.b, it: cfg.it });
    const maxTextW = Math.max(...lines.map((l) => m.measureText(l).width), 20);
    const fitW = Math.max(strokeW, Math.ceil(maxTextW) + 20);

    const t = { x: x0, y: y0, z: estZ, c: cfg.c || job.strokes[0].c || '#1f1f22', v: text, w: fitW };
    if (cfg.f) t.f = cfg.f;
    for (const k of TEXT_FMT_KEYS) if (cfg[k]) t[k] = cfg[k];
