        await P.download({ lang });
      }
      scribModelReady[lang] = true;
    }
    // ML Kit butuh waktu per titik: dibuat urut (10 ms per titik) dari urutan goresan
    let tm = 0;
    const strokes = job.strokes.map((st) => { const a = []; for (let i = 0; i < st.p.length; i += 3) { a.push(+(st.p[i] - x0).toFixed(1), +(st.p[i + 1] - y0).toFixed(1), tm); tm += 10; } tm += 120; return a; });
    const pre = [...pg.texts].filter((t) => Math.abs(t.y - y0) < 60 && t.x < x0).map((t) => t.v).join(' ').slice(-20);
    const res = await P.recognize({ lang, strokes, width: Math.max(200, x1 - x0), height: Math.max(40, y1 - y0), preContext: pre });
    const text = (res.text || '').trim();
