  for (const p of E.pages) {
    const r = E.els.get(p.id);
    for (const c of [r?.hi, r?.hiLive]) if (c) for (const k of ['left', 'top', 'width', 'height']) c.style[k] = parseFloat(c.style[k]) * ratio + 'px';
    if (r?.hiInfo?.cover) r.hiInfo.cover.pw = -1; // ukuran zoom berubah → gambar ulang tajam setelah berhenti
