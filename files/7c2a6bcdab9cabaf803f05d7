// ---------- Scribble: tulisan tangan → teks ----------
// Coretan ditampung dulu; setelah pena diam 0,9 detik, dikenali (ML Kit di HP) lalu diganti teks dengan format alat T.
const SCRIBBLE_ICON = '<svg viewBox="0 0 24 24"><path d="M14.5 4.5l3 3L8 17l-4 1 1-4z"/><path class="acc" d="M13 20h7M16.5 14v6"/></svg>';
