  });
}
function styleTextarea(ta, t) {
  Object.assign(ta.style, {
    fontWeight: t.b ? '700' : '', fontStyle: t.it ? 'italic' : '',
    textDecoration: [t.u ? 'underline' : '', t.st ? 'line-through' : ''].filter(Boolean).join(' '),
    textAlign: t.al || 'left', background: t.hl ? t.hl + '6b' : '',
