// pola untuk teks yang mengandung angka atau nama
const mEN = (m) => MONTHS_EN[MONTHS_ID.indexOf(m)] || m;
const dEN = (d) => DAYS_EN[DAYS_ID.indexOf(d)] || d;
const MON_RE = MONTHS_ID.join('|'), DAY_RE = DAYS_ID.join('|');
const pl = (n, one, many) => `${n} ${+n === 1 ? one : many}`;
const PATTERNS = [
  [new RegExp(`^(${DAY_RE}), (\\d{1,2}) (${MON_RE}) (\\d{4})$`), (_, d, n, m, y) => `${dEN(d)}, ${mEN(m)} ${n}, ${y}`],
  [new RegExp(`^(\\d{1,2}) (${MON_RE}) (\\d{4})$`), (_, n, m, y) => `${mEN(m)} ${n}, ${y}`],
  [new RegExp(`^(${MON_RE}) (\\d{4})$`), (_, m, y) => `${mEN(m)} ${y}`],
  [new RegExp(`^Monthly Plan (${MON_RE}) (\\d{4})$`), (_, m, y) => `Monthly Plan ${mEN(m)} ${y}`],
  [/^(\d+) dari (\d+) foto$/, (_, a, b) => `${a} of ${b} photos`],
  [/^Coba lagi dalam (\d+) detik$/, (_, n) => `Try again in ${n} seconds`],
  [/^PIN salah \((\d+) kali lagi\)$/, (_, n) => `Wrong PIN (${pl(n, 'try', 'tries')} left)`],
  [/^Masukkan PIN untuk membuka "(.*)"$/, (_, t) => `Enter your PIN to open "${t}"`],
  [/^"(.*)" tidak akan meminta PIN lagi$/, (_, t) => `"${t}" won't ask for a PIN anymore`],
  [/^(\d+) angka untuk mengunci catatan$/, (_, n) => `${n} digits to lock your notes`],
  [/^(\d+) acara$/, (_, n) => pl(n, 'event', 'events')],
  [/^(\d+) to-do$/, (_, n) => pl(n, 'to-do', 'to-dos')],
  [/^(\d+) menit lagi$/, (_, n) => `in ${pl(n, 'minute', 'minutes')}`],
  [/^(\d+) jam lagi$/, (_, n) => `in ${pl(n, 'hour', 'hours')}`],
  [/^(.*) · (\d+) hlm$/, (_, a, n) => `${a} · ${n} ${+n === 1 ? 'page' : 'pages'}`],
  [/^(\d+) catatan · (\d+) halaman · (\d+) folder$/, (_, a, b, c) => `${pl(a, 'notebook', 'notebooks')} · ${pl(b, 'page', 'pages')} · ${pl(c, 'folder', 'folders')}`],
  [/^catatan · (\d+) halaman · (\d+) folder$/, (_, b, c) => `notebooks · ${pl(b, 'page', 'pages')} · ${pl(c, 'folder', 'folders')}`],
  [/^Halaman (\d+) dari (\d+)$/, (_, a, b) => `Page ${a} of ${b}`],
  [/^Halaman (\d+) ditambahkan$/, (_, a) => `Page ${a} added`],
  [/^Hapus "(.*)" selamanya\? Tidak bisa dikembalikan\.$/, (_, t) => `Delete "${t}" forever? This can't be undone.`],
  [/^Hapus acara "(.*)"\?$/, (_, t) => `Delete event "${t}"?`],
  [/^Hapus folder "(.*)"\? Isinya tidak ikut terhapus, hanya dipindah ke Semua catatan\.$/, (_, t) => `Delete folder "${t}"? Its notebooks stay and move to All notes.`],
  [/^Hapus halaman (\d+)\? Tindakan ini tidak bisa dibatalkan\.$/, (_, n) => `Delete page ${n}? This can't be undone.`],
  [/^Hapus (\d+) catatan di Sampah selamanya\?$/, (_, n) => `Delete ${pl(n, 'notebook', 'notebooks')} in Trash forever?`],
  [/^Hapus (\d+) tugas yang sudah selesai\?$/, (_, n) => `Delete ${pl(n, 'completed task', 'completed tasks')}?`],
  [/^Pindahkan "(.*)"$/, (_, t) => `Move "${t}"`],
  [/^Dipindahkan ke (.*)$/, (_, t) => `Moved to ${t}`],
  [/^PDF diimpor \((\d+) halaman\)$/, (_, n) => `PDF imported (${pl(n, 'page', 'pages')})`],
  [/^(\d+) gambar diimpor$/, (_, n) => `${pl(n, 'image', 'images')} imported`],
  [/^(\d+) stiker ditambahkan$/, (_, n) => `${pl(n, 'sticker', 'stickers')} added`],
  [/^(\d+) acara diimpor(.*)$/, (_, n, r) => `${pl(n, 'event', 'events')} imported${r}`],
  [/^Memotong… (.*)$/, (_, r) => `Cutting… ${r}`],
  [/^Belum selesai · (\d+)$/, (_, n) => `To do · ${n}`],
  [/^Selesai · (\d+)$/, (_, n) => `Done · ${n}`],
  [/^Terlambat · (.*)$/, (_, r) => `Overdue · ${trBase(r)}`],
  [/^Mengumpulkan (.*)$/, (_, r) => `Collecting ${r}`],
  [/^(.*) · Hari ini$/, (_, r) => `${trBase(r)} · Today`],
  [/^(.+) · (.+)$/, (_, a, b) => { const A = trBase(a), B = trBase(b); return A !== a || B !== b ? `${A} · ${B}` : null; }],
];

function trBase(s) {
  if (EN[s] != null) return EN[s];
  const di = DAYS_ID.indexOf(s); if (di >= 0) return DAYS_EN[di];
  const mi = MONTHS_ID.indexOf(s); if (mi >= 0) return MONTHS_EN[mi];
  for (const [re, fn] of PATTERNS) { const m = s.match(re); if (m) { const r = fn(...m); if (r != null) return r; } }
  return s;
}
// terjemahkan satu teks (dipakai juga untuk notifikasi, nama file, dan tulisan di kertas)
export function tr(s) { if (lang() !== 'en' || typeof s !== 'string') return s; const t = s.trim(); if (!t) return s; const r = trBase(t); return r === t ? s : s.replace(t, r); }

// ---------- Terjemahan layar ----------
const SKIP = 'script,style,textarea,[contenteditable="true"],.rn-body,.rn-txt,.text-input,.name,.ev-title,.dp-title,.nb-title,.nb-body,.td-title,.pv-title,.label,.notes-user';
function translateText(node) {
  const p = node.parentElement; if (!p || (p.closest(SKIP) && !p.closest('[data-i18n]'))) return;
  const v = node.data, t = v.trim(); if (!t || t.length > 400) return;
  const r = trBase(t); if (r !== t) node.data = v.replace(t, r);
}
const ATTRS = ['placeholder', 'title', 'aria-label'];
function translateEl(el) {
  if (el.closest?.(SKIP) && !el.matches?.('input[placeholder],textarea[placeholder]')) return;
  for (const a of ATTRS) { const v = el.getAttribute?.(a); if (v) { const r = trBase(v.trim()); if (r !== v.trim()) el.setAttribute(a, r); } }
}
function translateTree(root) {
  if (root.nodeType === 3) return translateText(root);
  if (root.nodeType !== 1) return;
  translateEl(root);
  root.querySelectorAll?.('[placeholder],[title],[aria-label]').forEach(translateEl);
  const w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
  for (let n = w.nextNode(); n; n = w.nextNode()) translateText(n);
}

// Pasang bahasa: dipanggil sekali setelah pengaturan dimuat
export function initLang() {
  document.documentElement.lang = lang();
  if (lang() !== 'en') return;
  // nama bulan & hari di seluruh aplikasi (array dipakai bersama, diganti isinya di tempat)
  MONTHS.splice(0, 12, ...MONTHS_EN.map((m) => m.slice(0, 3)));
  MONTHS_LONG.splice(0, 12, ...MONTHS_EN);
  DAYS.splice(0, 7, ...DAYS_EN.map((d) => d.slice(0, 3)));
  DAYS_LONG.splice(0, 7, ...DAYS_EN);
  translateTree(document.body);
  new MutationObserver((list) => {
    for (const m of list) {
      if (m.type === 'characterData') translateText(m.target);
      else if (m.type === 'attributes') translateEl(m.target);
      else m.addedNodes.forEach(translateTree);
    }
  }).observe(document.body, { childList: true, subtree: true, characterData: true, attributes: true, attributeFilter: ATTRS });
}
export const monthsEN = MONTHS_EN, daysEN = DAYS_EN;
