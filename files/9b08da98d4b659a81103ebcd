    if (allOn) { picked.clear(); syncPicks(); }
    else { if (!picking) setPicking(true, false); for (const n of vis) picked.add(n.id); syncPicks(); }
  };
  $('#l-pick-all', root).onclick = togglePickAll;
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && picking && root.classList.contains('active')) setPicking(false); });
