      goal = { x: tr.left + Math.min(28, tr.width / 2), y: tr.top + tr.height / 2 };
      bodies.forEach((b) => (b.locked = false));
      mode = 'drop';
      if (!raf) raf = requestAnimationFrame(step);
      await Promise.race([done, new Promise((r) => setTimeout(r, 900))]);
      cancelAnimationFrame(raf); fx.remove();
      await movePickedTo(ids, folder);
      const pulse = folder ? $(`#l-side [data-kind="folder"][data-id="${folder}"], #l-chips [data-kind="folder"][data-id="${folder}"]`, root) : $('#l-side [data-kind="all"]', root);
      pulse?.animate([{ transform: 'scale(1)' }, { transform: 'scale(1.1)' }, { transform: 'scale(.97)' }, { transform: 'scale(1)' }], { duration: 420, easing: 'ease-out' });
      navigator.vibrate?.(10);
    } else {
      // batal: memantul kembali ke tempat asalnya
      bodies.forEach((b) => (b.locked = false));
      mode = 'back';
      if (!raf) raf = requestAnimationFrame(step);
      await Promise.race([done, new Promise((r) => setTimeout(r, 1000))]);
      cancelAnimationFrame(raf); fx.remove(); cards.forEach((c) => c.classList.remove('drag-src'));
    }
  };
  window.addEventListener('pointermove', move, { passive: false });
  window.addEventListener('pointerup', finish); window.addEventListener('pointercancel', finish);
}
