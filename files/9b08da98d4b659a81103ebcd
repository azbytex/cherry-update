// Motif sampul: digeser per halaman (2 baris), titik penanda halaman di bawahnya
function motifPages(root) {
  const box = root.querySelector('#cv-sty'); if (!box) return;
  let dots = box.nextElementSibling?.classList.contains('cv-dots') ? box.nextElementSibling : null;
  if (!dots) { dots = document.createElement('div'); dots.className = 'cv-dots'; box.after(dots); }
  // isi halaman terakhir dengan tempat kosong supaya bisa digeser penuh
  box.querySelectorAll(".cv-pad").forEach((x) => x.remove());
  const n = box.querySelectorAll(".cv-motif").length;
  for (let i = n; i < Math.ceil(n / 10) * 10; i++) { const p = document.createElement("i"); p.className = "cv-pad"; box.appendChild(p); }
  const pages = () => Math.max(1, Math.ceil(box.querySelectorAll(".cv-motif").length / 10));
  const cur = () => Math.min(pages() - 1, Math.round(box.scrollLeft / Math.max(1, box.clientWidth)));
  const draw = () => {
    const n = pages(), c = cur();
    if (dots.childElementCount !== n) dots.innerHTML = Array.from({ length: n }, (_, i) => `<button data-p="${i}" aria-label="Halaman ${i + 1}"></button>`).join('');
    [...dots.children].forEach((d, i) => d.classList.toggle('on', i === c));
    dots.hidden = n < 2;
    dots.querySelectorAll('[data-p]').forEach((d) => (d.onclick = () => box.scrollTo({ left: +d.dataset.p * box.clientWidth, behavior: 'smooth' })));
  };
  box.addEventListener('scroll', () => requestAnimationFrame(draw), { passive: true });
  new ResizeObserver(draw).observe(box);
  // buka di halaman yang berisi motif terpilih
  requestAnimationFrame(() => { const on = box.querySelector('.cv-motif.on'); if (on) box.scrollLeft = Math.floor(on.offsetLeft / box.clientWidth) * box.clientWidth; draw(); });
}
