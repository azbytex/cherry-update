      if (!picked.size) return;
      const ids = [...picked];
      if (!(await confirmDialog(`Pindahkan ${ids.length} buku ke Sampah?`, { ok: 'Hapus', danger: true }))) return;
      await trashPicked(ids);
      return;
    }
    clearPicking();
