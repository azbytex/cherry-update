const TEXT_COLORS = ['#1f1f22', '#e5484d', '#0a99f0', '#16a34a', '#f59e0b', '#8b5cf6', '#ec4899', '#64748b'];
const TEXT_NAMES = ['Hitam', 'Merah', 'Biru', 'Hijau', 'Oranye', 'Ungu', 'Pink', 'Abu-abu'];
const MARK_COLORS = ['#fff3a3', '#c8f7c5', '#cfe8ff', '#ffd6e8', 'transparent'];
const MARK_NAMES = ['Kuning', 'Hijau', 'Biru', 'Pink', 'Hapus stabilo'];

// ---------- Ambil gambar: kamera / galeri ----------
async function shrink(dataUrlOrBlob) {
  const blob = typeof dataUrlOrBlob === 'string' ? await (await fetch(dataUrlOrBlob)).blob() : dataUrlOrBlob;
  const bm = await createImageBitmap(blob);
  const max = 1280, k = Math.min(1, max / Math.max(bm.width, bm.height));
  const c = document.createElement('canvas'); c.width = Math.round(bm.width * k); c.height = Math.round(bm.height * k);
  c.getContext('2d').drawImage(bm, 0, 0, c.width, c.height);
  return c.toDataURL('image/jpeg', 0.82);
}
export async function pickImage(source) {
  const Cam = window.Capacitor?.isNativePlatform?.() ? window.Capacitor.Plugins.Camera : null;
  if (Cam) {
    try {
      const p = await Cam.getPhoto({ source: source === 'camera' ? 'CAMERA' : 'PHOTOS', resultType: 'dataUrl', quality: 85, width: 1600, correctOrientation: true });
      return p?.dataUrl ? shrink(p.dataUrl) : null;
    } catch (e) { if (!/cancel/i.test(String(e?.message || e))) toast('Tidak bisa membuka ' + (source === 'camera' ? 'kamera' : 'galeri')); return null; }
  }
  const f = await pickFile('image/*', false, source === 'camera' ? 'environment' : undefined);
  return f ? shrink(f) : null;
}

// ---------- Pembersih HTML (hanya format yang aman) ----------
const ALLOWED = new Set(['B', 'STRONG', 'I', 'EM', 'U', 'S', 'STRIKE', 'BR', 'P', 'DIV', 'SPAN', 'FONT', 'H2', 'H3', 'UL', 'OL', 'LI', 'IMG', 'MARK', 'BLOCKQUOTE', 'INPUT', 'LABEL']);
export function sanitize(html) {
  const t = document.createElement('template'); t.innerHTML = html;
  const walk = (node) => {
    for (const el of [...node.children]) {
      if (!ALLOWED.has(el.tagName)) { el.replaceWith(...el.childNodes); continue; }
      for (const a of [...el.attributes]) {
        const n = a.name.toLowerCase();
        const ok = n === 'style' || n === 'color' || n === 'class' || (el.tagName === 'FONT' && n === 'face') || (el.tagName === 'IMG' && n === 'src' && /^data:image\//.test(a.value)) || (el.tagName === 'INPUT' && (n === 'type' || n === 'checked'));
        if (!ok) el.removeAttribute(a.name);
      }
      if (el.tagName === 'INPUT' && el.getAttribute('type') !== 'checkbox') { el.remove(); continue; }
      if (el.style) for (const p of [...el.style]) if (!/^(text-align|color|background-color|font-weight|font-style|text-decoration.*|width|font-size|font-family)$/.test(p)) el.style.removeProperty(p);
      walk(el);
    }
  };
  walk(t.content);
  return t.innerHTML;
}
export function plainText(html) {
  const d = document.createElement('div'); d.innerHTML = html.replace(/<(br|\/p|\/div|\/li|\/h\d)>/gi, '\n$&');
  return d.textContent.replace(/\n{2,}/g, '\n').trim();
}
export const hasImage = (html) => /<img\b/i.test(html);

// ---------- Popup editor ----------
// Catatan disimpan sebagai { html, floats } — floats = foto/stiker bebas: { t:'img'|'stk', src|v, x, y, w, a, r } (x,y,w relatif lebar)
export const normNote = (n) => !n ? { html: '', floats: [] } : typeof n === 'string' ? { html: n, floats: [] } : { html: n.html || '', floats: n.floats || [] };

export function openRichNote({ title, subtitle = '', note, onSave, onDelete }) {
  const start = normNote(note);
  const html = start.html;
  let floats = start.floats.map((f) => ({ ...f }));
  let dirty = false;
  // diisi setelah lembar siap: penjaga saat ditutup lewat ketuk luar/tombol kembali
  let guardFn = () => false, cleanupFn = () => {};
  const btn = (cmd, icon, tip, arg = '') => `<button class="rn-b" data-cmd="${cmd}" data-arg="${arg}" title="${tip}">${icon}</button>`;
  const s = openSheet(`
    <div class="rn-head"><div><h3 style="margin:0">${esc(title)}</h3>${subtitle ? `<div class="rn-sub">${esc(subtitle)}</div>` : ''}</div>
      <button class="ib sm" id="rn-x" title="Tutup">${ICON.close}</button></div>
    <div class="rn-bar">
      ${btn('bold', I.bold, 'Tebal')}${btn('italic', I.italic, 'Miring')}${btn('underline', I.underline, 'Garis bawah')}${btn('strikeThrough', I.strike, 'Coret')}
      <span class="rn-sep"></span>
      ${btn('heading', I.h, 'Judul')}${btn('insertUnorderedList', I.ul, 'Daftar poin')}${btn('insertOrderedList', I.ol, 'Daftar nomor')}${btn('checklist', I.check, 'Kotak centang')}
      <span class="rn-sep"></span>
      ${btn('justifyLeft', I.left, 'Rata kiri')}${btn('justifyCenter', I.center, 'Rata tengah')}${btn('justifyRight', I.right, 'Rata kanan')}${btn('justifyFull', I.justify, 'Rata kiri-kanan')}
      <span class="rn-sep"></span>
      ${btn('font', '<span style="font-size:15px;font-family:Pacifico,serif">Aa</span>', 'Font')}${btn('color', I.color, 'Warna teks')}${btn('mark', I.mark, 'Stabilo')}${btn('image', I.image, 'Sisipkan foto')}${btn('sticker', I.sticker, 'Stiker')}${btn('textbox', I.textbox, 'Kotak teks bebas')}
      <span class="rn-sep"></span>
      ${btn('undo', I.undo, 'Urungkan')}${btn('redo', I.redo, 'Ulangi')}
    </div>
    <div class="rn-stk" id="rn-stk" hidden></div>
    <div class="rn-stk" id="rn-font" hidden></div>
    <div class="rn-wrap" id="rn-wrap">
      <div class="rn-body" id="rn-body" contenteditable="true" spellcheck="false" data-ph="Tulis apa saja: kegiatan, catatan, daftar…">${sanitize(html)}</div>
      <div class="rn-layer" id="rn-layer"><div class="rn-inner" id="rn-inner"></div></div>
    </div>
    <div class="actions">
      ${html || floats.length ? '<button class="btn danger left" id="rn-del">Hapus catatan</button>' : ''}
      <button class="btn ghost" id="rn-c">Batal</button><button class="btn yellow" id="rn-ok">Simpan</button>
    </div>`, { wide: true, guard: () => guardFn(), onClose: () => cleanupFn() });

  const body = $('#rn-body', s);
  try { document.execCommand('styleWithCSS', false, true); } catch {}
  setTimeout(() => { body.focus(); placeCaretEnd(body); }, 60);
  body.addEventListener('input', () => { dirty = true; syncState(); });

  let saved = null; // simpan posisi kursor sebelum membuka menu
  const keep = () => { const sel = getSelection(); if (sel.rangeCount && body.contains(sel.anchorNode)) saved = sel.getRangeAt(0).cloneRange(); };
  const restoreSel = () => {
    const sel = getSelection();
    if (document.activeElement === body && sel.rangeCount && body.contains(sel.anchorNode)) return; // seleksi masih aktif
    body.focus();
    if (saved) { sel.removeAllRanges(); sel.addRange(saved); }
  };
  document.addEventListener('selectionchange', onSel);
  function onSel() { keep(); syncState(); }

  function syncState() {
    $$('.rn-b', s).forEach((b) => {
      const c = b.dataset.cmd;
      let on = false;
      try { if (['bold', 'italic', 'underline', 'strikeThrough', 'insertUnorderedList', 'insertOrderedList', 'justifyLeft', 'justifyCenter', 'justifyRight', 'justifyFull'].includes(c)) on = document.queryCommandState(c); } catch {}
      b.classList.toggle('on', on);
    });
  }

  $$('.rn-b', s).forEach((b) => {
    b.addEventListener('pointerdown', (e) => e.preventDefault()); // jangan hilangkan seleksi
    b.onclick = async () => {
      const c = b.dataset.cmd;
      restoreSel();
      if (c === 'heading') {
        const cur = document.queryCommandValue('formatBlock').toLowerCase();
        document.execCommand('formatBlock', false, cur === 'h2' ? 'div' : 'h2');
      } else if (c === 'checklist') {
        document.execCommand('insertHTML', false, '<div class="rn-todo"><input type="checkbox">&nbsp;</div>');
      } else if (c === 'color') {
        keep();
        popover(b, TEXT_COLORS.map((col, i) => ({ label: TEXT_NAMES[i], fn: () => {
          if (selected?.t === 'txt') { selected.c = col; refreshTxt(selected); dirty = true; return; }
          restoreSel(); document.execCommand('foreColor', false, col); s.style.setProperty('--rn-color', col); dirty = true;
        } })));
        return colorize();
      } else if (c === 'mark') {
        keep();
        popover(b, MARK_COLORS.map((col, i) => ({ label: MARK_NAMES[i], fn: () => { restoreSel(); document.execCommand('hiliteColor', false, col); dirty = true; } })));
        return colorize(true);
      } else if (c === 'image') {
        keep();
        return popover(b, [
          { label: 'Ambil foto (kamera)', icon: 'image', fn: () => addImage('camera') },
          { label: 'Pilih dari galeri', icon: 'pages', fn: () => addImage('gallery') },
        ]);
      } else if (c === 'font') {
        keep();
        const p = $('#rn-font', s); p.hidden = !p.hidden; b.classList.toggle('on', !p.hidden);
        if (!p.hidden) fontPicker(p, null, (fam) => {
          if (selected?.t === 'txt') { selected.f = fam; refreshTxt(selected); dirty = true; return; }
          restoreSel();
          document.execCommand('fontName', false, fam || 'Segoe UI');
          dirty = true;
        }, 'Cherry');
        return;
      } else if (c === 'textbox') {
        addFloat({ t: 'txt', v: 'Ketuk dua kali untuk edit', c: '#1f1f22', f: null, fs: 0.05, w: 0.45, a: 4 });
        return;
      } else if (c === 'sticker') {
        const p = $('#rn-stk', s); p.hidden = !p.hidden; b.classList.toggle('on', !p.hidden);
        if (!p.hidden) stickerPicker(p, (v) => addFloat({ t: 'stk', v, a: stickerAspect(v), w: isEmoji(v) ? 0.16 : 0.3 }));
        return;
      } else {
        document.execCommand(c, false, null);
      }
      dirty = true; syncState();
    };
  });
  // beri warna pada pilihan di popover warna
  function colorize(mark) {
    $$('#popover button').forEach((pb, i) => {
      const col = (mark ? MARK_COLORS : TEXT_COLORS)[i];
      pb.insertAdjacentHTML('afterbegin', `<i style="width:18px;height:18px;border-radius:50%;flex:none;background:${col === 'transparent' ? 'repeating-linear-gradient(45deg,#ccc 0 3px,#fff 3px 6px)' : col};box-shadow:inset 0 0 0 1px rgba(0,0,0,.15)"></i>`);
    });
  }

  // ---------- Lapisan foto & stiker bebas (boleh menimpa teks) ----------
  const layer = $('#rn-layer', s), inner = $('#rn-inner', s);
  const W = () => inner.clientWidth || 1;
  const tbox = createTransformBox(inner);
  let selected = null;

  function floatEl(f) {
    const el = document.createElement('div');
    el.className = 'rn-float' + (f.t === 'stk' ? ' is-stk' : f.t === 'txt' ? ' is-txt' : '');
    el.innerHTML = f.t === 'img' ? `<img src="${f.src}" alt="" draggable="false">` : f.t === 'txt' ? `<div class="rn-txt"></div>` : stickerHTML(f.v);
    if (f.t === 'txt') el.firstChild.textContent = f.v;
    el._f = f;
    el.addEventListener('pointerdown', (e) => { e.preventDefault(); e.stopPropagation(); select(f, e); });
    return el;
  }
  function layout(f) {
    const w = W(), el = f._el;
    if (f.t === 'txt') {
      const tx = el.firstChild;
      Object.assign(tx.style, { fontSize: f.fs * w + 'px', color: f.c, fontFamily: cssFamily(f.f) });
      Object.assign(el.style, { left: f.x * w + 'px', top: f.y * w + 'px', width: f.w * w + 'px', height: 'auto', transform: `rotate(${f.r || 0}rad)` });
      f.a = (f.w * w) / Math.max(1, el.offsetHeight);
      return;
    }
    const pw = f.w * w, ph = pw / f.a;
    Object.assign(el.style, { left: f.x * w + 'px', top: f.y * w + 'px', width: pw + 'px', height: ph + 'px', transform: `rotate(${f.r || 0}rad)` });
    const emo = el.querySelector('.emo'); if (emo) emo.style.fontSize = ph * 0.86 + 'px';
  }
  function renderFloats() {
    inner.querySelectorAll('.rn-float').forEach((n) => n.remove());
    for (const f of floats) { f._el = floatEl(f); inner.insertBefore(f._el, tbox.el); layout(f); }
    fitSpace();
    hydrateMine(inner);
  }
  // beri ruang gulir supaya foto di bawah tetap bisa dijangkau
  function fitSpace() {
    const w = W();
    const bottom = floats.reduce((m, f) => Math.max(m, (f.y + f.w / f.a) * w + 24), 0);
    body.style.paddingBottom = '16px';
    const natural = body.scrollHeight;
    if (bottom > natural) body.style.paddingBottom = (16 + bottom - natural) + 'px';
    inner.style.height = Math.max(body.scrollHeight, bottom) + 'px';
  }
  const syncScroll = () => { inner.style.transform = `translateY(${-body.scrollTop}px)`; };
  body.addEventListener('scroll', syncScroll);
  new ResizeObserver(() => { floats.forEach(layout); fitSpace(); syncScroll(); if (selected) tbox.update(toBox(selected)); }).observe(body);

  const toBox = (f) => { const w = W(); return { x: f.x * w, y: f.y * w, w: f.w * w, h: f.w * w / f.a, r: f.r || 0 }; };
  function select(f, e) {
    selected = f;
    // bawa ke paling depan
    floats = floats.filter((x) => x !== f).concat(f);
    inner.insertBefore(f._el, tbox.el);
    let armed = !e;
    tbox.attach(toBox(f), {
      min: 24, max: () => W() * 1.5,
      label: (m) => f.t === 'txt' ? Math.round(f.fs * W()) + ' px' : Math.round(m.w / W() * 100) + '%',
      onChange: (m) => {
        const w = W();
        if (f.t === 'txt') f.fs *= (m.w / w) / f.w; // huruf ikut membesar/mengecil
        Object.assign(f, { x: m.x / w, y: m.y / w, w: m.w / w, r: m.r }); layout(f);
        if (f.t === 'txt') tbox.update(toBox(f));
      },
      onCommit: () => { armed = true; dirty = true; fitSpace(); },
      onTap: () => { if (f.t !== 'txt') return; if (!armed) { armed = true; return; } editTxt(f); },
      onDelete: () => { floats = floats.filter((x) => x !== f); f._el.remove(); selected = null; dirty = true; fitSpace(); },
    });
    // langsung bisa diseret dari ketukan pertama
    if (e) { const ev = new PointerEvent('pointerdown', e); tbox.el.dispatchEvent(ev); }
  }
  function deselect() { selected = null; tbox.detach(); }
  function refreshTxt(f) { layout(f); if (selected === f) tbox.update(toBox(f)); fitSpace(); }
  // edit isi kotak teks langsung di tempat
  function editTxt(f) {
    const tx = f._el.firstChild;
    tbox.detach(); selected = null;
    f._el.classList.add('editing');
    tx.contentEditable = 'true'; tx.focus();
    const r = document.createRange(); r.selectNodeContents(tx); const sl = getSelection(); sl.removeAllRanges(); sl.addRange(r);
    tx.oninput = () => { layout(f); fitSpace(); };
    tx.onblur = () => {
      tx.contentEditable = 'false'; f._el.classList.remove('editing');
      f.v = tx.innerText.replace(/\n+$/, '') || ' ';
      tx.textContent = f.v; layout(f); fitSpace(); dirty = true;
    };
    tx.onpointerdown = (ev) => ev.stopPropagation();
  }
  body.addEventListener('pointerdown', deselect);

  function addFloat(f) {
    const w = W();
    f.x = Math.max(0, 0.5 - f.w / 2 + (Math.random() - 0.5) * 0.1);
    f.y = (body.scrollTop + body.clientHeight * 0.35) / w - f.w / f.a / 2;
    f.r = (Math.random() - 0.5) * 0.2;
    floats.push(f); f._el = floatEl(f); inner.insertBefore(f._el, tbox.el); layout(f); fitSpace();
    f._el.animate([{ transform: `scale(.2) rotate(${f.r}rad)`, opacity: 0 }, { transform: `scale(1.08) rotate(${f.r}rad)`, opacity: 1, offset: .7 }, { transform: `rotate(${f.r}rad)` }], { duration: 380, easing: 'cubic-bezier(.34,1.56,.64,1)' });
    select(f); dirty = true;
  }
  async function addImage(src) {
    const url = await pickImage(src); if (!url) return;
    const im = new Image(); im.src = url; await im.decode().catch(() => {});
    addFloat({ t: 'img', src: url, a: (im.naturalWidth || 4) / (im.naturalHeight || 3), w: 0.55 });
  }

  // foto lama yang masih menyatu dengan teks → jadikan foto bebas
  requestAnimationFrame(async () => {
    const olds = [...body.querySelectorAll('img')];
    await Promise.all(olds.map((i) => i.decode().catch(() => {})));
    const w = W(), br = body.getBoundingClientRect();
    for (const img of olds) {
      const r = img.getBoundingClientRect();
      floats.push({ t: 'img', src: img.src, x: (r.left - br.left) / w, y: (r.top - br.top + body.scrollTop) / w, w: r.width / w, a: r.width / Math.max(1, r.height), r: 0 });
      img.remove();
    }
    renderFloats(); syncScroll();
  });

  body.addEventListener('click', (e) => {
    const cb = e.target.closest('input[type=checkbox]');
    if (cb) { cb.toggleAttribute('checked', cb.checked); dirty = true; }
  });
  document.addEventListener('keydown', onKey);
  function onKey(e) {
    if (selected && (e.key === 'Delete' || (e.key === 'Backspace' && document.activeElement !== body))) { e.preventDefault(); tbox.el.querySelector('.tb-del').click(); }
  }

  const clean = (f) => { const { _el, ...rest } = f; return rest; };
  const result = () => {
    const out = sanitize(body.innerHTML).trim();
    const fl = floats.map(clean);
    const empty = !plainText(out) && !/type="checkbox"/.test(out) && !fl.length;
    return empty ? null : { html: out, floats: fl };
  };
  const cleanup = () => { document.removeEventListener('selectionchange', onSel); document.removeEventListener('keydown', onKey); };
  const save = () => { const r = result(); cleanup(); closeSheet(); onSave(r); };
  $('#rn-ok', s).onclick = save;
  // Catatan yang sudah diketik tidak bisa tertutup diam-diam: tanya Simpan / Buang / Lanjut menulis
  const askClose = async () => {
    const r = await askUnsaved(true, 'Catatan ini belum disimpan. Simpan dulu sebelum ditutup?');
    if (r === 'save') save();
    else if (r === 'discard') { cleanup(); closeSheet(); }
  };
  const cancel = () => { if (dirty) askClose(); else { cleanup(); closeSheet(); } };
  guardFn = () => { if (!dirty) return false; askClose(); return true; };
  cleanupFn = cleanup;
  $('#rn-c', s).onclick = cancel;
  $('#rn-x', s).onclick = save;
  $('#rn-del', s)?.addEventListener('click', async () => {
    const snapNote = { html: body.innerHTML, floats: floats.map(clean) };
    cleanup();
    if (await confirmDialog('Hapus catatan di kotak ini?', { ok: 'Hapus', danger: true })) onDelete?.();
    else openRichNote({ title, subtitle, note: snapNote, onSave, onDelete });
  });
}

function placeCaretEnd(el) {
  const r = document.createRange(); r.selectNodeContents(el); r.collapse(false);
  const sel = getSelection(); sel.removeAllRanges(); sel.addRange(r);
}
