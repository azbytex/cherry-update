// ---------- Tombol back Android & penutup lapisan ----------
const backStack = [];
export function pushBack(fn) { backStack.push(fn); return () => { const i = backStack.lastIndexOf(fn); if (i >= 0) backStack.splice(i, 1); }; }
export function handleBack() { const fn = backStack.pop(); if (fn) { fn(); return true; } return false; }

// ---------- Toast ----------
export function toast(msg, ms = 1900) {
  const t = $('#toast'); t.textContent = msg; t.classList.add('show');
  clearTimeout(t._h); t._h = setTimeout(() => t.classList.remove('show'), ms);
}

// ---------- Sheet (dialog) ----------
let sheetBackRemove = null;
let sheetOnClose = null;
let sheetGuard = null; // dipanggil saat ditutup lewat ketuk luar / tombol kembali; true = jangan tutup dulu
// guard: fungsi sendiri, atau guardForm: true untuk menanyakan kalau isian formulir berubah
export function openSheet(html, { onClose, wide = false, guard = null, guardForm = false, onSave = null } = {}) {
  const sheet = $('#sheet');
  sheet.innerHTML = html;
  sheet.classList.toggle('wide', wide);
  $('#scrim').classList.add('open');
  if (sheetBackRemove) sheetBackRemove();
  sheetOnClose = onClose || null;
  sheetGuard = guard || (guardForm ? formGuard(sheet, onSave) : null);
  const back = () => { if (sheetGuard?.()) { sheetBackRemove = pushBack(back); return; } closeSheet(true); };
  sheetBackRemove = pushBack(back);
  return sheet;
}
// isian formulir berubah tapi belum disimpan → tanya dulu
function formGuard(sheet, onSave) {
  const vals = () => [...sheet.querySelectorAll('input:not([type=color]):not([type=file]), textarea, select')].map((i) => (i.type === 'checkbox' ? i.checked : i.value)).join('\u0001');
  const start = vals();
  return () => {
    if (vals() === start) return false;
    askUnsaved(!!onSave).then((r) => { if (r === 'save') onSave(); else if (r === 'discard') closeSheet(); });
    return true;
  };
}

// Peringatan "belum disimpan" yang tampil di atas lembar (isi lembar tidak hilang)
// hasil: 'save' | 'discard' | null (lanjut menulis)
export function askUnsaved(canSave = true, msg = 'Perubahan belum disimpan. Mau disimpan dulu?', { title = 'Belum disimpan', discard = 'Buang', keep = 'Lanjut menulis' } = {}) {
  return new Promise((resolve) => {
    const w = document.createElement('div');
    w.className = 'mconf';
    w.innerHTML = `<div class="mconf-card"><h3>${esc(title)}</h3><p>${esc(msg)}</p>
      <div class="mconf-act">${canSave ? '<button class="btn primary" data-r="save">Simpan</button>' : ''}<button class="btn danger-ghost" data-r="discard">${esc(discard)}</button><button class="btn ghost" data-r="">${esc(keep)}</button></div></div>`;
    const done = (r) => { w.classList.add('out'); setTimeout(() => w.remove(), 200); removeBack(); resolve(r || null); };
    const removeBack = pushBack(() => done(null));
    w.addEventListener('pointerdown', (e) => { if (e.target === w) { e.stopPropagation(); done(null); } });
    w.querySelectorAll('[data-r]').forEach((b) => b.onclick = (e) => { e.stopPropagation(); done(b.dataset.r); });
    document.body.appendChild(w);
  });
}
// salinan visual yang memudar & mengecil halus saat ditutup (aslinya langsung bebas dipakai lagi)
function ghostOut(el, cls) {
  if (!el || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const g = el.cloneNode(true);
  g.removeAttribute('id'); g.querySelectorAll('[id]').forEach((x) => x.removeAttribute('id'));
  g.classList.add('fx-ghost', cls); g.setAttribute('aria-hidden', 'true');
  if (el.style.cssText) g.style.cssText = el.style.cssText;
  el.parentNode.appendChild(g);
  setTimeout(() => g.remove(), 320);
}
export function closeSheet(fromBack = false) {
  sheetGuard = null;
  if ($('#scrim').classList.contains('open')) ghostOut($('#scrim'), 'closing');
  $('#scrim').classList.remove('open');
  if (!fromBack && sheetBackRemove) sheetBackRemove();
  sheetBackRemove = null;
  const cb = sheetOnClose; sheetOnClose = null; cb?.();
  syncFabs();
}
document.addEventListener('DOMContentLoaded', () => {
  $('#scrim').addEventListener('pointerdown', (e) => {
    if (e.target.id !== 'scrim') return;
    swallowTap(e); // ketuk luar hanya menutup, tidak menekan apa pun di bawahnya
    if (sheetGuard?.()) return;
    closeSheet();
  });
});

export function confirmDialog(msg, { ok = 'Ya', danger = false, title = 'Konfirmasi' } = {}) {
  return new Promise((resolve) => {
    let done = false;
    const finish = (v) => { if (done) return; done = true; resolve(v); };
    const s = openSheet(`<h3>${esc(title)}</h3><p>${esc(msg)}</p>
      <div class="actions"><button class="btn ghost" data-r="0">Batal</button><button class="btn ${danger ? 'primary' : 'primary'}" data-r="1" ${danger ? 'style="background:var(--danger)"' : ''}>${esc(ok)}</button></div>`,
      { onClose: () => finish(false) });
    s.querySelectorAll('[data-r]').forEach((b) => b.onclick = () => { const v = b.dataset.r === '1'; finish(v); closeSheet(); });
  });
}

export function promptDialog(title, value = '', { placeholder = '', ok = 'Simpan', multiline = false } = {}) {
  return new Promise((resolve) => {
    let done = false;
    const finish = (v) => { if (done) return; done = true; resolve(v); };
    const field = multiline
      ? `<textarea class="inp" id="pd-in" rows="5" placeholder="${esc(placeholder)}">${esc(value)}</textarea>`
      : `<input class="inp" id="pd-in" value="${esc(value)}" placeholder="${esc(placeholder)}">`;
    const s = openSheet(`<h3>${esc(title)}</h3><div class="field">${field}</div>
      <div class="actions"><button class="btn ghost" id="pd-c">Batal</button><button class="btn primary" id="pd-ok">${esc(ok)}</button></div>`,
      { onClose: () => finish(null) });
    const inp = $('#pd-in', s);
    setTimeout(() => { inp.focus(); if (!multiline) inp.select(); }, 40);
    const submit = () => { finish(inp.value); closeSheet(); };
    $('#pd-ok', s).onclick = submit;
    $('#pd-c', s).onclick = () => closeSheet();
    if (!multiline) inp.onkeydown = (e) => { if (e.key === 'Enter') submit(); };
  });
}

// ---------- Popover menu ----------
let popBackRemove = null;
export function popover(anchor, items) {
  const pop = $('#popover');
  pop.innerHTML = items.map((it, i) => it === '-' ? '<hr>' :
    `<button data-i="${i}" class="${it.danger ? 'danger' : ''}">${it.icon ? ICON[it.icon] : ''}<span>${esc(it.label)}</span></button>`).join('');
  pop.classList.add('open');
  const r = anchor.getBoundingClientRect ? anchor.getBoundingClientRect() : { left: anchor.x, right: anchor.x, top: anchor.y, bottom: anchor.y };
  const pw = pop.offsetWidth, ph = pop.offsetHeight;
  let x = r.right - pw, y = r.bottom + 6;
  if (x < 8) x = Math.min(r.left, innerWidth - pw - 8);
  if (y + ph > innerHeight - 8) y = Math.max(8, r.top - ph - 6);
  pop.style.left = Math.max(8, x) + 'px'; pop.style.top = y + 'px';
  if (popBackRemove) popBackRemove();
  popBackRemove = pushBack(() => closePopover(true));
  pop.onclick = (e) => {
    const b = e.target.closest('[data-i]'); if (!b) return;
    closePopover(); items[+b.dataset.i].fn?.();
  };
}
export function closePopover(fromBack = false) {
  const pop = $('#popover');
  if (!pop.classList.contains('open')) return;
  ghostOut(pop, 'closing');
  pop.classList.remove('open');
  if (!fromBack && popBackRemove) popBackRemove();
  popBackRemove = null;
  syncFabs();
}
// Ketukan yang dipakai untuk MENUTUP sesuatu tidak boleh ikut menekan tombol/halaman di bawahnya
let swallowUntil = 0, swallowUp = false;
export function swallowTap(e) {
  e?.stopPropagation?.(); e?.preventDefault?.();
  swallowUntil = performance.now() + 650; swallowUp = true;
}
// hanya pointerup & klik dari ketukan yang sama yang ditelan (sekali saja)
document.addEventListener('pointerup', (e) => { if (swallowUp) { swallowUp = false; if (performance.now() < swallowUntil) e.stopImmediatePropagation(); } }, true);
document.addEventListener('click', (e) => {
  if (performance.now() < swallowUntil) { swallowUntil = 0; e.stopImmediatePropagation(); e.preventDefault(); }
}, true);
document.addEventListener('pointerdown', (e) => {
  if ($('#popover')?.classList.contains('open') && !e.target.closest('#popover')) {
    closePopover();
    if (e.target.closest('#ed-pages')) { e.cherryClosed = true; return; }
    swallowTap(e); e.stopImmediatePropagation();
  }
}, true);

// ---------- Tombol + (FAB): ikon berputar jadi × saat menu/lembar terbuka, kembali + saat ditutup ----------
let fabSuppress = false;
function syncFabs() {
  setTimeout(() => {
    const anyOpen = $('#scrim')?.classList.contains('open') || $('#popover')?.classList.contains('open');
    if (!anyOpen) $$('.fab.open').forEach((f) => f.classList.remove('open'));
  });
}
// ketuk + yang sedang terbuka = tutup saja (jangan buka lagi)
document.addEventListener('pointerdown', (e) => { if (e.target.closest('.fab.open')) fabSuppress = true; }, true);
document.addEventListener('click', (e) => {
  const f = e.target.closest('.fab'); if (!f) return;
  if (fabSuppress) { fabSuppress = false; e.stopPropagation(); e.preventDefault(); closePopover(); closeSheet(); f.classList.remove('open'); return; }
  f.classList.add('open'); syncFabs();
}, true);

// ---------- Pilih file ----------
export function pickFile(accept, multiple = false, capture) {
  return new Promise((resolve) => {
    const old = $('#filePicker');
    const inp = old.cloneNode(); old.replaceWith(inp);
    inp.accept = accept; inp.multiple = multiple;
    if (capture) inp.setAttribute('capture', capture); else inp.removeAttribute('capture');
    inp.onchange = () => resolve(multiple ? [...inp.files] : inp.files[0] || null);
    inp.click();
  });
}

export const blobToDataURL = (blob) => new Promise((res, rej) => { const r = new FileReader(); r.onload = () => res(r.result); r.onerror = rej; r.readAsDataURL(blob); });
export const dataURLToBlob = async (url) => (await fetch(url)).blob();
