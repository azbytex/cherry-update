      } else {
        events.splice(idx, 1);
        await db.del('events', ev.id);
      }
      invalidateEventIndex(); render(0, false, true);
      window.dispatchEvent(new CustomEvent('cherry:gcal'));
    } else {
      window.dispatchEvent(new CustomEvent('cherry:gcal'));
