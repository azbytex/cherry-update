let gcalEvents = [];       // event dari Google Calendar user
let gcalSig = '';          // tanda tangan cepat untuk cegah render ulang jika tidak ada perubahan
let holidayOnline = [];    // tambahan hari libur dari Google public feed (opsional)
let _syncBusy = false;
let _lastAutoSync = 0;
let _syncTimer = 0;
let _listenersBound = false;

// Indeks tanggal O(1) agar render & dashboard bebas lag walau ribuan event
let _idxDirty = true;
let _calVer = 1;
let _mergedCache = [];
let _dateMap = new Map();
let _recList = [];

export function calendarVersion() { return _calVer; }
function invalidateEventIndex() {
  _idxDirty = true;
  _calVer++;
}

function buildSig(evs) {
  let s = String(evs.length);
  for (let i = 0; i < evs.length; i++) {
    const e = evs[i];
    s += `;${e.date}|${e.endDate || ''}|${e.time}|${e.end}|${e.title}|${e.repeat}|${e.until || ''}`;
  }
  return s;
}

const bustUrl = (u) => u + (u.includes('?') ? '&' : '?') + '_=' + Date.now();

async function fetchIcsText(url) {
  const fresh = bustUrl(url);
  const capHttp = window.Capacitor?.Plugins?.CapacitorHttp;
  if (capHttp?.get) {
    try {
      const r = await capHttp.get({
        url: fresh,
        headers: { 'Cache-Control': 'no-cache, no-store', Pragma: 'no-cache' },
      });
      if (r?.status >= 200 && r?.status < 300 && typeof r.data === 'string' && r.data.includes('BEGIN:VCALENDAR')) {
        return r.data;
      }
    } catch {}
  }
  const urls = [
    fresh,
    `https://api.allorigins.win/raw?url=${encodeURIComponent(fresh)}`,
    `https://corsproxy.io/?url=${encodeURIComponent(fresh)}`,
  ];
  let lastErr = null;
  for (const u of urls) {
    try {
      const res = await fetch(u, { cache: 'no-store', signal: AbortSignal.timeout(10000) });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const t = await res.text();
      if (t.includes('BEGIN:VCALENDAR')) return t;
      lastErr = new Error('Bukan file iCal valid');
    } catch (e) { lastErr = e; }
  }
  throw lastErr || new Error('Gagal mengunduh iCal');
}

/** Ambil cache dari IndexedDB (dipanggil saat init) */
async function loadGcalCache() {
  try {
    const r = await db.get('kv', GCAL_KEY);
    if (r?.ver === GCAL_VER && Array.isArray(r.events)) {
      gcalEvents = r.events;
      gcalSig = r.sig || buildSig(gcalEvents);
    } else {
      // Cache versi lama (v1) bisa salah tanggal zona waktu: bersihkan agar segera fetch ulang
      gcalEvents = [];
      gcalSig = '';
      if (r) db.del('kv', GCAL_KEY).catch(() => {});
    }
  } catch { gcalEvents = []; gcalSig = ''; }
  try {
    const h = await db.get('kv', GCAL_HOL_KEY);
    if (h?.ver === GCAL_VER && Array.isArray(h.events)) holidayOnline = h.events;
  } catch { holidayOnline = []; }
  invalidateEventIndex();
}

/** Sinkronkan hari libur resmi Indonesia di latar belakang (maks 1x per 7 hari) */
async function syncHolidaysBg() {
  if (!navigator.onLine || settings.showHolidays === false) return;
  try {
    const cached = await db.get('kv', GCAL_HOL_KEY).catch(() => null);
    if (cached?.ver === GCAL_VER && cached.synced && Date.now() - cached.synced < 7 * 86400000) return;
    const text = await fetchIcsText(ID_HOLIDAY_ICS);
    const parsed = parseIcs(text, HOLIDAY_COLOR).map((e) => ({ ...e, color: HOLIDAY_COLOR, _holiday: true }));
    if (parsed.length) {
      holidayOnline = parsed;
      invalidateEventIndex();
      await db.put('kv', { id: GCAL_HOL_KEY, ver: GCAL_VER, events: parsed, synced: Date.now() });
      render();
      window.dispatchEvent(new CustomEvent('cherry:gcal'));
    }
  } catch {}
}

/** Simpan hasil fetch ke IndexedDB */
async function saveGcalCache(evs, sig) {
  gcalEvents = evs;
  gcalSig = sig;
  invalidateEventIndex();
  try { await db.put('kv', { id: GCAL_KEY, ver: GCAL_VER, events: evs, sig, synced: Date.now() }); } catch {}
}

/** Kapan terakhir sync berhasil */
export async function gcalLastSync() {
  try { const r = await db.get('kv', GCAL_KEY); return r?.synced || 0; } catch { return 0; }
}

/**
 * Ambil & parse iCal dari URL Google Calendar.
 * - Online  → fetch → parse → simpan IndexedDB (jika berubah) → render
 * - Offline → pakai cache IndexedDB terakhir
 */
export async function syncGcal({ silent = false } = {}) {
  const url = getGcalUrl();
  if (!url) {
    const had = gcalEvents.length > 0;
    gcalEvents = [];
    gcalSig = '';
    invalidateEventIndex();
    try { await db.del('kv', GCAL_KEY); } catch {}
    if (had) {
      render();
      window.dispatchEvent(new CustomEvent('cherry:gcal'));
    }
    return { ok: false, reason: 'no_url' };
  }
  if (_syncBusy) return { ok: false, reason: 'busy' };
  _syncBusy = true;
  try {
    if (!navigator.onLine) {
      if (!silent) toast('Offline — menampilkan data terakhir dari cache');
      return { ok: false, reason: 'offline' };
    }
    const text = await fetchIcsText(url);
    const parsed = parseIcs(text, settings.calAccent || '#0a99f0');
    const marked = parsed.map((e) => ({ ...e, _gcal: true }));
    const nextSig = buildSig(marked);
    const changed = nextSig !== gcalSig;
    if (changed) {
      // Sinkronkan perubahan dari Google Calendar ke acara lokal yang punya gcalUid sama
      const byUid = new Map(marked.filter((e) => e.gcalUid).map((e) => [e.gcalUid, e]));
      let localUpdated = false;
      for (const ev of events) {
        if (!ev.gcalUid) continue;
        const g = byUid.get(ev.gcalUid);
        if (!g) continue;
        if (ev.title !== g.title || ev.date !== g.date || (ev.endDate || '') !== (g.endDate || '') || ev.time !== g.time || ev.end !== g.end || (ev.location || '') !== (g.location || '') || ev.note !== g.note) {
          ev.title = g.title; ev.date = g.date; ev.endDate = g.endDate || '';
          ev.time = g.time; ev.end = g.end; ev.location = g.location || '';
          ev.note = g.note;
          await db.put('events', ev);
          localUpdated = true;
        }
      }
      if (localUpdated) reschedule();
      await saveGcalCache(marked, nextSig);
      render(0, false, silent);
      window.dispatchEvent(new CustomEvent('cherry:gcal'));
    } else {
      // Tetap perbarui timestamp synced tanpa re-render DOM
      try { await db.put('kv', { id: GCAL_KEY, ver: GCAL_VER, events: gcalEvents, sig: gcalSig, synced: Date.now() }); } catch {}
    }
    if (!silent) toast(`Kalender Google disinkronkan: ${marked.length} acara`);
    return { ok: true, count: marked.length, changed };
  } catch (err) {
    if (!silent) toast('Gagal sinkronisasi kalender: ' + (err.message || err));
    return { ok: false, reason: err.message };
  } finally {
    _syncBusy = false;
  }
}

/** Sync cepat supaya kembali dari Google Calendar / pindah tab terasa real-time tanpa lag */
export function triggerQuickGcalSync(minGapMs = 2000) {
  if (!getGcalUrl() || !navigator.onLine) return;
  const now = Date.now();
  if (now - _lastAutoSync < minGapMs) return;
  _lastAutoSync = now;
  syncGcal({ silent: true });
}

let _resumeFollowT = 0;
function onAppResume() {
  triggerQuickGcalSync(1500);
  // Cek ulang diam-diam 4.5 dtk kemudian jika Google Calendar baru saja menyimpan acara
  clearTimeout(_resumeFollowT);
  _resumeFollowT = setTimeout(() => triggerQuickGcalSync(3500), 4500);
}

/** Init sync: muat cache lalu fetch jika online; pasang listener real-time (termasuk Android App resume) */
export async function initGcalSync() {
  await loadGcalCache();
  triggerQuickGcalSync(0);
  syncHolidaysBg();
  if (_listenersBound) return;
  _listenersBound = true;
  window.addEventListener('online', () => { triggerQuickGcalSync(0); syncHolidaysBg(); });
  document.addEventListener('visibilitychange', () => { if (!document.hidden) onAppResume(); });
  window.addEventListener('focus', onAppResume);
  try {
    const capApp = window.Capacitor?.Plugins?.App;
    capApp?.addListener?.('appStateChange', ({ isActive }) => { if (isActive) onAppResume(); });
    capApp?.addListener?.('resume', onAppResume);
  } catch {}
  clearInterval(_syncTimer);
  _syncTimer = setInterval(() => {
    if (!document.hidden && navigator.onLine && getGcalUrl()) triggerQuickGcalSync(9000);
  }, 10000);
}

/** Bangun ulang indeks O(1) bila data berubah */
function ensureIndex() {
  if (!_idxDirty) return;
  _idxDirty = false;
  const localKeys = new Set(events.map((e) => `${e.date}|${e.time}|${e.title}`));
  const localUids = new Set(events.map((e) => e.gcalUid).filter(Boolean));
  const gcalExtra = gcalEvents.filter((e) => !(e.gcalUid && localUids.has(e.gcalUid)) && !localKeys.has(`${e.date}|${e.time}|${e.title}`));
  let hols = [];
  if (settings.showHolidays !== false) {
    const holSource = holidayOnline.length ? holidayOnline : STATIC_HOLIDAYS;
    const seen = new Set([...localKeys, ...gcalExtra.map((e) => `${e.date}|${e.time}|${e.title}`)]);
    // Gabungkan juga hari libur statis tetap (Natal, Kemerdekaan, dll) jika belum ada
    const holSeen = new Set();
    for (const h of [...holSource, ...STATIC_HOLIDAYS]) {
      const k = `${h.date}|${h.title.toLowerCase()}`;
      if (holSeen.has(k) || seen.has(`${h.date}||${h.title}`)) continue;
      holSeen.add(k);
      hols.push(h);
    }
  }
  _mergedCache = [...events, ...gcalExtra, ...hols];
  _dateMap = new Map();
  _recList = [];
  const pushDay = (k, ev) => {
    let arr = _dateMap.get(k);
    if (!arr) { arr = []; _dateMap.set(k, arr); }
    arr.push(ev);
  };
  for (const ev of _mergedCache) {
    if (ev.repeat && ev.repeat !== 'none') {
      _recList.push(ev);
      continue;
    }
    if (!ev.endDate || ev.endDate <= ev.date) {
      pushDay(ev.date, ev);
      continue;
    }
    // Rentang multi-hari tanpa pengulangan: indeks tiap hari (maks 60 hari ke map, lebih dari itu ke recList)
    const s = parseYmd(ev.date), e = parseYmd(ev.endDate);
    const days = Math.round((e - s) / 86400000);
    if (days >= 0 && days <= 60) {
      for (let i = 0; i <= days; i++) {
        const d = new Date(s); d.setDate(s.getDate() + i);
        pushDay(ymd(d), ev);
      }
    } else {
      _recList.push(ev);
    }
  }
}

/** Semua event (lokal + Google Calendar + Hari Libur), untuk render */
function allEvents() {
  ensureIndex();
  return _mergedCache;
}

