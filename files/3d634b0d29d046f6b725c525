      await db.del('events', rem.id);
      invalidateEventIndex(); render(0, false, true);
      window.dispatchEvent(new CustomEvent('cherry:gcal'));
    } else if ((action === 'save' || action === 'toggle') && idx >= 0) {
      const ev = events[idx];
      if (todo.due) {
        ev.title = todo.title;
        ev.date = todo.due;
        ev.endDate = '';
        ev.time = todo.dueTime || '';
        ev.end = '';
        ev.note = todo.note || '';
