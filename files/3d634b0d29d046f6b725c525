    </div>
    ${isGcal ? (hasBridge
      ? `<div class="gcal-ro-note" style="display:flex;align-items:center;justify-content:space-between;gap:8px;background:color-mix(in srgb,var(--cal) 10%,transparent);color:var(--text)"><span>Sinkron 2 arah Google Calendar aktif</span><button type="button" id="e-gcal-open" style="font-size:12px;color:var(--cal);font-weight:600;white-space:nowrap">Buka di Google ↗</button></div>`
      : `<div class="gcal-ro-note">Acara dari Google Calendar (iCal hanya-baca). Aktifkan <b>Sinkron 2 Arah</b> di Pengaturan agar bisa edit langsung.</div>`) : ''}

    <div class="gcal-row" id="e-time-row">
      <svg class="gcal-ic" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
      <div class="gcal-row-body">
        <div class="gcal-sum-line">
          <div class="gcal-sum-txt">
            <div id="e-sum-date">${esc(fmtDateChip(ev.date))}${ev.endDate && ev.endDate > ev.date ? ' – ' + esc(fmtDateChip(ev.endDate)) : ''}</div>
            <small id="e-sum-rep">${esc(REPEAT[ev.repeat || 'none'])}</small>
          </div>
          <button type="button" class="gcal-pill-btn ${timeOpen ? 'on' : ''}" id="e-time-toggle">${timeOpen ? 'Tutup waktu' : 'Tambah jam'}</button>
        </div>
        <div class="cal-expand ${timeOpen ? 'open' : ''}" id="e-time-box">
          <div class="cal-expand-in">
            <div class="two" style="margin-top:10px">
              <div class="field"><label id="e-date-lbl">${kind === 'task' ? 'Tanggal tenggat' : 'Tanggal mulai'}</label><input class="inp" id="e-date" type="date" value="${ev.date}"></div>
              <div class="field" id="e-enddate-wrap" ${kind === 'task' ? 'hidden' : ''}><label>Sampai tanggal</label><input class="inp" id="e-end-date" type="date" value="${ev.endDate || ''}" min="${ev.date}"></div>
            </div>
            <div class="two" id="e-hm-wrap" ${!ev.time && timeOpen === false ? '' : ''}>
              <div class="field"><label id="e-time-lbl">${kind === 'task' ? 'Jam tenggat' : 'Jam mulai'}</label><input class="inp" id="e-time" type="time" value="${ev.time || ''}"></div>
              <div class="field" id="e-end-wrap" ${kind === 'task' ? 'hidden' : ''}><label>Jam selesai</label><input class="inp" id="e-end" type="time" value="${ev.end || ''}"></div>
            </div>
            <div class="gcal-time-opts">
              <label class="gcal-chk"><input type="checkbox" id="e-allday" ${!ev.time ? 'checked' : ''}><span>Sepanjang hari</span></label>
              <select class="gcal-sel" id="e-rep">${Object.entries(REPEAT).map(([k, v]) => `<option value="${k}" ${ev.repeat === k ? 'selected' : ''}>${v}</option>`).join('')}</select>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="gcal-pane ${kind === 'event' ? 'show' : ''}" id="e-pane-event">
      <div class="gcal-row">
        <svg class="gcal-ic" viewBox="0 0 24 24"><path d="M12 21s-6-5.4-6-10a6 6 0 1 1 12 0c0 4.6-6 10-6 10z"/><circle cx="12" cy="11" r="2.2"/></svg>
        <div class="gcal-row-body"><input class="gcal-line-inp" id="e-loc" value="${esc(ev.location || '')}" placeholder="Tambahkan lokasi"></div>
      </div>
      <div class="gcal-row">
        <svg class="gcal-ic" viewBox="0 0 24 24"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
        <div class="gcal-row-body">
          <select class="gcal-sel full" id="e-rem">${Object.entries(REMIND).map(([k, v]) => `<option value="${k}" ${String(ev.remind ?? '') === k ? 'selected' : ''}>Ingatkan: ${v}</option>`).join('')}</select>
        </div>
      </div>
    </div>

    <div class="gcal-pane ${kind === 'task' ? 'show' : ''}" id="e-pane-task">
      <div class="gcal-row">
        <svg class="gcal-ic" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        <div class="gcal-row-body">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:6px">
            <span class="gcal-subh">Sub-tugas (masuk ke To-do list)</span>
            <div class="td-subsort"><button type="button" class="td-sortbtn" id="e-sub-undone">⇅ Belum</button><button type="button" class="td-sortbtn" id="e-sub-az">A–Z</button></div>
          </div>
          <div id="e-subs">${initSubs.map(subRow).join('')}</div>
          <button type="button" class="btn ghost td-add" id="e-addsub">+ Tambah sub-tugas</button>
        </div>
      </div>
    </div>

    <div class="gcal-row">
      <svg class="gcal-ic" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
      <div class="gcal-row-body"><textarea class="gcal-line-inp" id="e-note" rows="2" placeholder="Tambahkan deskripsi atau catatan">${esc(ev.note || '')}</textarea></div>
    </div>

    <div class="gcal-row">
      <svg class="gcal-ic" viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="15.5" rx="3"/><path d="M8 3v4M16 3v4"/></svg>
      <div class="gcal-row-body">
        <div class="swatches" style="gap:7px">${[...new Set([settings.calAccent, ...COLORS])].map((c) => `<button type="button" class="sw ${c === color ? 'on' : ''}" data-c="${c}" style="background:${c}"></button>`).join('')}</div>
      </div>
    </div>

    <div class="actions">
      ${(!isNew && !isGcal) || (isGcal && hasBridge) ? '<button type="button" class="btn danger left" id="e-del">Hapus</button>' : ''}
      ${isGcalRo ? '<button type="button" class="btn ghost left" id="e-gcal-open">Buka di Google</button>' : ''}
      <button type="button" class="btn ghost" id="e-cancel">Batal</button>
      <button type="button" class="btn primary" id="e-save">${isGcalRo ? 'Simpan salinan' : 'Simpan'}</button>
    </div>`, { guardForm: !isGcalRo, onSave: () => submit() });

  if (isNew) setTimeout(() => $('#e-title', s).focus(), 40);
  const pickCol = (c) => { color = c; $$('.sw', s).forEach((x) => x.classList.toggle('on', x.dataset.c === c)); };
  $$('.sw', s).forEach((b) => b.onclick = () => pickCol(b.dataset.c));

  const tToggle = $('#e-time-toggle', s), tBox = $('#e-time-box', s);
  const dStart = $('#e-date', s), dEnd = $('#e-end-date', s), tStart = $('#e-time', s), tEnd = $('#e-end', s);
  const allDay = $('#e-allday', s), repSel = $('#e-rep', s), hmWrap = $('#e-hm-wrap', s);
  const sumDate = $('#e-sum-date', s), sumRep = $('#e-sum-rep', s);

  const syncSummary = () => {
    const a = dStart.value || selected, b = kind === 'event' ? dEnd.value : '';
    const tm = allDay.checked ? '' : tStart.value;
    const te = allDay.checked || kind === 'task' ? '' : tEnd.value;
    const dStr = fmtDateChip(a) + (b && b > a ? ' – ' + fmtDateChip(b) : '');
    const tStr = tm ? ` · ${tm}${te ? ' – ' + te : ''}` : '';
    sumDate.textContent = dStr + tStr;
    sumRep.textContent = REPEAT[repSel.value || 'none'];
  };
  const syncAllDay = () => {
    hmWrap.style.display = allDay.checked ? 'none' : '';
    if (allDay.checked) { tStart.value = ''; tEnd.value = ''; }
    else if (!tStart.value) { tStart.value = kind === 'task' ? '23:59' : '09:00'; }
    syncSummary();
  };
  syncAllDay();

  tToggle.onclick = () => {
    const on = !tBox.classList.contains('open');
    tBox.classList.toggle('open', on);
    tToggle.classList.toggle('on', on);
    tToggle.textContent = on ? 'Tutup waktu' : 'Tambah jam';
    if (on && allDay.checked && !tStart.value) {
      allDay.checked = false;
      syncAllDay();
    }
  };
  allDay.onchange = syncAllDay;
  dStart.onchange = () => { if (dEnd.value && dEnd.value < dStart.value) dEnd.value = dStart.value; dEnd.min = dStart.value; syncSummary(); };
  dEnd.onchange = syncSummary;
  tStart.onchange = () => { if (tStart.value) allDay.checked = false; syncSummary(); };
  tEnd.onchange = () => { if (tEnd.value) allDay.checked = false; syncSummary(); };
  repSel.onchange = syncSummary;

  const syncKindUI = () => {
    $$('[data-kind]', s).forEach((b) => b.classList.toggle('on', b.dataset.kind === kind));
    $('#e-pane-event', s).classList.toggle('show', kind === 'event');
    $('#e-pane-task', s).classList.toggle('show', kind === 'task');
    $('#e-enddate-wrap', s).hidden = kind === 'task';
    $('#e-end-wrap', s).hidden = kind === 'task';
    $('#e-date-lbl', s).textContent = kind === 'task' ? 'Tanggal tenggat' : 'Tanggal mulai';
    $('#e-time-lbl', s).textContent = kind === 'task' ? 'Jam tenggat' : 'Jam mulai';
    syncSummary();
  };
  $$('[data-kind]', s).forEach((b) => b.onclick = () => { kind = b.dataset.kind; syncKindUI(); });

  // Sub-tugas (mode Tugas): tambah, naik/turun, & sortir smooth
  const subsBox = $('#e-subs', s);
  const addSub = (focus = true) => {
    subsBox.insertAdjacentHTML('beforeend', subRow({ id: uid(), t: '', d: false }));
    if (focus) subsBox.lastElementChild.querySelector('.inp').focus();
  };
  const sortSubsUI = (cmp) => {
    const rows = [...$$('.td-erow', subsBox)];
    if (rows.length < 2) return;
    rows.sort(cmp).forEach((r) => {
      r.classList.add('td-erow-anim');
      subsBox.appendChild(r);
      r.addEventListener('animationend', () => r.classList.remove('td-erow-anim'), { once: true });
    });
  };
  $('#e-addsub', s).onclick = () => addSub();
  $('#e-sub-undone', s).onclick = () => sortSubsUI((a, b) => Number(a.querySelector('input[type=checkbox]').checked) - Number(b.querySelector('input[type=checkbox]').checked));
  $('#e-sub-az', s).onclick = () => sortSubsUI((a, b) => a.querySelector('.inp').value.localeCompare(b.querySelector('.inp').value));
  subsBox.addEventListener('click', (e) => {
    if (e.target.closest('.td-x')) { e.target.closest('.td-erow').remove(); return; }
    const mv = e.target.closest('.td-mv');
    if (mv) {
      const row = mv.closest('.td-erow'), dir = +mv.dataset.mv;
      const sib = dir < 0 ? row.previousElementSibling : row.nextElementSibling;
      if (!sib) return;
      row.classList.add('td-erow-anim');
      if (dir < 0) subsBox.insertBefore(row, sib); else subsBox.insertBefore(sib, row);
      row.addEventListener('animationend', () => row.classList.remove('td-erow-anim'), { once: true });
    }
  });
  subsBox.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' || !e.target.classList.contains('inp')) return;
    e.preventDefault();
    const r = e.target.closest('.td-erow');
    if (r === subsBox.lastElementChild && e.target.value.trim()) addSub(); else r.nextElementSibling?.querySelector('.inp')?.focus();
  });

  $('#e-cancel', s).onclick = () => closeSheet();
  if (isGcal) {
    $('#e-gcal-open', s).onclick = () => {
      const url = googleCalTemplateUrl({
        title: $('#e-title', s).value.trim() || ev.title,
        date: dStart.value || ev.date,
        endDate: dEnd.value || ev.endDate,
        time: allDay.checked ? '' : tStart.value,
        end: allDay.checked ? '' : tEnd.value,
        location: $('#e-loc', s).value.trim(),
        note: $('#e-note', s).value.trim(),
      });
      window.open(url, '_blank', 'noopener');
    };
  }
  if ((!isNew && !isGcal) || (isGcal && hasBridge)) $('#e-del', s).onclick = async () => {
    if (!(await confirmDialog(`Hapus ${kind === 'task' ? 'tugas' : 'acara'} "${ev.title}"?`, { ok: 'Hapus', danger: true }))) return;
    if (isGcal) {
      gcalEvents = gcalEvents.filter((e) => e.id !== ev.id && (!ev.gcalUid || e.gcalUid !== ev.gcalUid));
      await saveGcalCache(gcalEvents, buildSig(gcalEvents));
      render(); window.dispatchEvent(new CustomEvent('cherry:gcal'));
      after?.();
      const res = await pushGcalAction('delete', { gcalUid: ev.gcalUid });
      toast(res.ok ? 'Dihapus dari Cherry & Google Calendar' : `Dihapus lokal (${res.error || 'gagal hapus di Google'})`);
      return;
    }
    events = events.filter((e) => e.id !== ev.id);
    if (ev.todoId || ev.kind === 'task') await deleteTodoByCalId(ev.id, ev.todoId);
    invalidateEventIndex();
    await db.del('events', ev.id); reschedule(); render();
    window.dispatchEvent(new CustomEvent('cherry:gcal'));
    after?.();
    if (ev.gcalUid && hasBridge) {
      const res = await pushGcalAction('delete', { gcalUid: ev.gcalUid });
      toast(res.ok ? 'Dihapus dari Cherry & Google Calendar' : 'Dihapus di Cherry');
    } else {
      toast('Dihapus');
    }
  };

  const submit = async () => {
    const title = $('#e-title', s).value.trim();
    if (!title) { $('#e-title', s).focus(); return; }
    const startD = dStart.value || selected;
    let endD = kind === 'event' ? dEnd.value : '';
    if (endD && endD <= startD) endD = '';
    const tm = allDay.checked ? '' : tStart.value;
    const te = allDay.checked || kind === 'task' ? '' : tEnd.value;
    const loc = kind === 'event' ? $('#e-loc', s).value.trim() : '';
    const note = $('#e-note', s).value.trim();
    const rep = repSel.value || 'none';
    const rem = $('#e-rem', s).value;

    // Edit langsung acara Google Calendar saat Bridge 2 arah aktif
    if (isGcal && hasBridge) {
      Object.assign(ev, { title, date: startD, endDate: endD, time: tm, end: te, location: loc, note, repeat: rep, color });
      await saveGcalCache(gcalEvents, buildSig(gcalEvents));
      if (!after) { selected = startD; const d = parseYmd(startD); cursor = new Date(d.getFullYear(), d.getMonth(), 1); }
      closeSheet(); render();
      window.dispatchEvent(new CustomEvent('cherry:gcal'));
      after?.();
      toast('Menyimpan ke Google Calendar…');
      const res = await pushGcalAction('update', { gcalUid: ev.gcalUid, title, date: startD, endDate: endD, time: tm, end: te, location: loc, note, repeat: rep });
      if (res.ok) {
        if (res.gcalUid && res.gcalUid !== ev.gcalUid) { ev.gcalUid = res.gcalUid; await saveGcalCache(gcalEvents, buildSig(gcalEvents)); }
        toast('Diperbarui di Google Calendar');
      } else {
        toast('Gagal kirim ke Google: ' + (res.error || 'periksa koneksi'));
      }
      return;
    }

    const calId = (isNew || isGcalRo) ? uid() : ev.id;

    let todoId = ev.todoId || '';
    if (kind === 'task') {
      const subs = $$('.td-erow', subsBox).map((r) => ({ id: r.dataset.id, t: r.querySelector('.inp').value.trim(), d: r.querySelector('input[type=checkbox]').checked })).filter((x) => x.t);
      const repMap = { daily: 'daily', weekly: 'weekly', monthly: 'monthly' };
      const td = await upsertTodoFromCalendar({
        todoId, calEventId: calId, title, due: startD, dueTime: tm, note, rep: repMap[rep] || '', subs,
      });
      todoId = td.id;
    } else if (!isNew && !isGcalRo && todoId) {
      await deleteTodoByCalId(ev.id, todoId);
      todoId = '';
    }

    const data = { title, kind, date: startD, endDate: endD, time: tm, end: te, location: loc, note, repeat: rep, remind: rem, color, todoId };
    let rec;
    if (isNew || isGcalRo) { rec = { id: calId, created: Date.now(), ...data }; events.push(rec); }
    else { rec = Object.assign(ev, data); }
    invalidateEventIndex();
    await db.put('events', rec);
    if (rec.remind !== '') ensurePermission().then(reschedule); else reschedule();
    if (!after) { selected = data.date; const d = parseYmd(data.date); cursor = new Date(d.getFullYear(), d.getMonth(), 1); }
    closeSheet(); render();
    window.dispatchEvent(new CustomEvent('cherry:gcal'));
    after?.();
    if (hasBridge && navigator.onLine && !isGcalRo) {
      const act = rec.gcalUid ? 'update' : 'create';
      toast(isNew ? 'Menyimpan & mengirim ke Google…' : 'Memperbarui di Google…');
      const res = await pushGcalAction(act, rec);
      if (res.ok) {
        if (res.gcalUid && res.gcalUid !== rec.gcalUid) {
          rec.gcalUid = res.gcalUid;
          await db.put('events', rec);
          invalidateEventIndex();
        }
        toast(isNew ? 'Tersimpan di Cherry & Google Calendar' : 'Diperbarui di Cherry & Google Calendar');
      } else {
        toast('Tersimpan lokal (Google: ' + (res.error || 'gagal') + ')');
      }
    } else {
      toast(isGcalRo ? 'Disimpan sebagai acara lokal' : isNew ? (kind === 'task' ? 'Tugas masuk ke Kalender & To-do' : 'Acara ditambahkan') : 'Diperbarui');
    }
  };
  $('#e-save', s).onclick = submit;
  $('#e-title', s).onkeydown = (e) => { if (e.key === 'Enter') submit(); };
}

// ---------- Agenda ----------
function agenda() {
  const t = today(); const items = [];
  for (let i = 0; i < 90 && items.length < 60; i++) {
    const d = new Date(t); d.setDate(t.getDate() + i);
    for (const e of eventsOn(d)) items.push({ d, e });
  }
  const s = openSheet(`<h3>Agenda 90 hari ke depan</h3>
    ${items.length ? items.map(({ d, e }) => `<div class="row click" data-id="${e.id}" data-date="${ymd(d)}"><span class="bar" style="background:${e.color}"></span>
      <div class="grow"><div>${esc(e.title)}</div><div class="sub">${longDate(d)}${e.time ? ' · ' + e.time : ''}</div></div></div>`).join('')
      : '<div class="empty" style="padding:30px">Belum ada acara mendatang.</div>'}
    <div class="actions"><button class="btn ghost" id="ag-c">Tutup</button></div>`);
  $('#ag-c', s).onclick = () => closeSheet();
  $$('.row', s).forEach((r) => r.onclick = () => { selected = r.dataset.date; const d = parseYmd(selected); cursor = new Date(d.getFullYear(), d.getMonth(), 1); closeSheet(); render(); });
}

// ---------- Kustomisasi ----------
export function customize() {
  const holOn = settings.showHolidays !== false;
  const opt = (key, val, label) => `<button class="chip-opt ${(key === 'showHolidays' ? holOn === val : settings[key] === val) ? 'on' : ''}" data-k="${key}" data-v='${JSON.stringify(val)}'>${label}</button>`;
  const s = openSheet(`
    <h3>Sesuaikan kalender</h3>
    <div class="field"><label>Warna utama</label><div class="swatches">${ACCENTS.map((c) => `<button class="sw ${c === settings.calAccent ? 'on' : ''}" data-acc="${c}" style="background:${c}"></button>`).join('')}
      <label class="sw" style="background:conic-gradient(red,yellow,lime,cyan,blue,magenta,red);position:relative;overflow:hidden" title="Warna lain"><input type="color" id="cz-col" value="${settings.calAccent}" style="opacity:0;position:absolute;inset:0;width:100%;height:100%"></label></div></div>
    <div class="field"><label>Minggu dimulai hari</label><div class="chips">${opt('weekStart', 1, 'Senin')}${opt('weekStart', 0, 'Minggu')}${opt('weekStart', 6, 'Sabtu')}</div></div>
    <div class="field"><label>Penanda hari ini</label><div class="chips">${opt('todayStyle', 'bar', 'Blok penuh')}${opt('todayStyle', 'round', 'Bulat')}</div></div>
    <div class="field"><label>Tampilan acara</label><div class="chips">${opt('eventStyle', 'label', 'Label judul')}${opt('eventStyle', 'dot', 'Titik warna')}</div></div>
    <div class="field"><label>Nomor minggu</label><div class="chips">${opt('weekNumbers', false, 'Sembunyikan')}${opt('weekNumbers', true, 'Tampilkan')}</div></div>
    <div class="field"><label>Tanggal bulan lain</label><div class="chips">${opt('showOther', true, 'Tampilkan')}${opt('showOther', false, 'Sembunyikan')}</div></div>
    <div class="field"><label>Hari Minggu merah</label><div class="chips">${opt('redSunday', true, 'Ya')}${opt('redSunday', false, 'Tidak')}</div></div>
    <div class="field"><label>Hari libur nasional (Indonesia)</label><div class="chips">${opt('showHolidays', true, 'Tampilkan')}${opt('showHolidays', false, 'Sembunyikan')}</div></div>
    <div class="actions"><button class="btn primary" id="cz-ok">Selesai</button></div>`);
  const apply = () => { invalidateEventIndex(); saveSettings(); applyAccent(); render(); window.dispatchEvent(new CustomEvent('cherry:gcal')); };
  $$('[data-acc]', s).forEach((b) => b.onclick = () => { settings.calAccent = b.dataset.acc; $$('[data-acc]', s).forEach((x) => x.classList.toggle('on', x === b)); apply(); });
  $('#cz-col', s).oninput = (e) => { settings.calAccent = e.target.value; $$('[data-acc]', s).forEach((x) => x.classList.remove('on')); apply(); };
  $$('[data-k]', s).forEach((b) => b.onclick = () => {
    settings[b.dataset.k] = JSON.parse(b.dataset.v);
    $$(`[data-k="${b.dataset.k}"]`, s).forEach((x) => x.classList.toggle('on', x === b)); apply();
  });
  $('#cz-ok', s).onclick = () => closeSheet();
}
