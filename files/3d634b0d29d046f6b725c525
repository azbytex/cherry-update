export function getAppsScriptCode() {
  const token = getGcalBridgeToken();
  return `// Cherry <-> Google Calendar 2-Way Bridge
// Tempel di script.google.com -> Deploy -> Web app (Execute as: Me, Access: Anyone)
const TOKEN = '${token}';

function doPost(e) {
  try {
    const req = JSON.parse((e && e.postData && e.postData.contents) || '{}');
    if (req.token !== TOKEN) return out({ ok: false, error: 'Token tidak cocok' });
    const cal = CalendarApp.getDefaultCalendar();
    const act = req.action;
    if (act === 'ping') {
      return out({ ok: true, calendar: cal.getName() });
    }
    const d = req.event || {};
    if (act === 'delete') {
      const ev = findEv(cal, d.gcalUid);
      if (!ev) return out({ ok: false, error: 'Acara tidak ditemukan' });
      const ser = ev.isRecurringEvent && ev.isRecurringEvent() ? ev.getEventSeries() : null;
      if (ser) ser.deleteEventSeries(); else ev.deleteEvent();
      return out({ ok: true });
    }
    if (act === 'update' && d.gcalUid) {
      const ev = findEv(cal, d.gcalUid);
      if (ev) {
        ev.setTitle(d.title || '');
        ev.setLocation(d.location || '');
        ev.setDescription(d.note || '');
        if (!(ev.isRecurringEvent && ev.isRecurringEvent())) {
          if (d.time) {
            const st = mkDt(d.date, d.time);
            const en = mkEnd(d, st);
            ev.setTime(st, en);
          } else {
            const st = mkDt(d.date);
            const endD = d.endDate && d.endDate > d.date ? d.endDate : '';
            if (endD) { const ex = mkDt(endD); ex.setDate(ex.getDate() + 1); ev.setAllDayDates(st, ex); }
            else ev.setAllDayDate(st);
          }
        }
        return out({ ok: true, gcalUid: ev.getId() });
      }
    }
    if (act === 'create' || act === 'update') {
      const opts = {};
      if (d.location) opts.location = d.location;
      if (d.note) opts.description = d.note;
      const rec = mkRec(d.repeat);
      let created;
      if (d.time) {
        const st = mkDt(d.date, d.time);
        const en = mkEnd(d, st);
        created = rec ? cal.createEventSeries(d.title, st, en, rec, opts) : cal.createEvent(d.title, st, en, opts);
      } else {
        const st = mkDt(d.date);
        if (rec) {
          created = cal.createAllDayEventSeries(d.title, st, rec, opts);
        } else if (d.endDate && d.endDate > d.date) {
          const ex = mkDt(d.endDate); ex.setDate(ex.getDate() + 1);
          created = cal.createAllDayEvent(d.title, st, ex, opts);
        } else {
          created = cal.createAllDayEvent(d.title, st, opts);
        }
      }
      return out({ ok: true, gcalUid: created.getId() });
    }
    return out({ ok: false, error: 'Aksi tidak dikenal' });
  } catch (err) {
    return out({ ok: false, error: String(err && err.message ? err.message : err) });
  }
}

function findEv(cal, uid) {
  if (!uid) return null;
  try { return cal.getEventById(uid); } catch (e) { return null; }
}
function mkDt(ds, tm) {
  const p = String(ds).split('-').map(Number);
  if (tm) {
    const t = String(tm).split(':').map(Number);
    return new Date(p[0], p[1] - 1, p[2], t[0] || 0, t[1] || 0, 0);
  }
  return new Date(p[0], p[1] - 1, p[2]);
}
function mkEnd(d, st) {
  const en = d.end ? mkDt(d.endDate || d.date, d.end) : new Date(st.getTime() + 3600000);
  return en > st ? en : new Date(st.getTime() + 3600000);
}
function mkRec(rep) {
  if (!rep || rep === 'none') return null;
  const r = CalendarApp.newRecurrence();
  if (rep === 'daily') return r.addDailyRule();
  if (rep === 'weekly') return r.addWeeklyRule();
  if (rep === 'monthly') return r.addMonthlyRule();
  if (rep === 'yearly') return r.addYearlyRule();
  return null;
}
function out(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}`;
}

async function pushGcalAction(action, eventData) {
  const url = getGcalBridgeUrl();
  if (!url) return { ok: false, skipped: true };
  if (!navigator.onLine) return { ok: false, error: 'Offline' };
  const payload = JSON.stringify({ token: getGcalBridgeToken(), action, event: eventData || {} });
  const capHttp = window.Capacitor?.Plugins?.CapacitorHttp;
  if (capHttp?.post) {
    try {
      const r = await capHttp.post({
        url,
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        data: payload,
      });
      const data = typeof r.data === 'string' ? JSON.parse(r.data) : r.data;
      if (data && typeof data.ok === 'boolean') return data;
    } catch {}
  }
  try {
    const res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: payload,
      redirect: 'follow',
      signal: AbortSignal.timeout(15000),
    });
    const text = await res.text();
    return JSON.parse(text);
  } catch (err) {
    return { ok: false, error: err.message || 'Gagal menghubungi Google Apps Script' };
  }
}

