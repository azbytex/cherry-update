// ---------- Pengulangan & Rentang ----------
export function occursOn(ev, d, key) {
  if (key < ev.date) return false;
  if (ev.until && key > ev.until) return false;
  if (ev.exdates?.includes(key)) return false;
  const s = parseYmd(ev.date);
  const iv = ev.interval || 1;
  switch (ev.repeat) {
    case 'daily': {
      if (iv === 1) return true;
      const diff = Math.round((d - s) / 86400000);
      return diff >= 0 && diff % iv === 0;
    }
    case 'weekly': {
      const dayMatch = ev.byday?.length ? ev.byday.includes(d.getDay()) : d.getDay() === s.getDay();
      if (!dayMatch) return false;
      if (iv === 1) return true;
      const diffW = Math.floor((d - s) / (7 * 86400000));
      return diffW >= 0 && diffW % iv === 0;
    }
    case 'monthly': {
      if (d.getDate() !== s.getDate()) return false;
      if (iv === 1) return true;
      const diffM = (d.getFullYear() - s.getFullYear()) * 12 + (d.getMonth() - s.getMonth());
      return diffM >= 0 && diffM % iv === 0;
    }
    case 'yearly': {
      if (d.getDate() !== s.getDate() || d.getMonth() !== s.getMonth()) return false;
      const diffY = d.getFullYear() - s.getFullYear();
      return diffY >= 0 && diffY % iv === 0;
    }
    default: return key >= ev.date && key <= (ev.endDate || ev.date);
  }
}
const byTime = (a, b) => (a._holiday ? 1 : 0) - (b._holiday ? 1 : 0) || (a.time || '').localeCompare(b.time || '') || a.title.localeCompare(b.title);
export function eventsOn(d) {
  ensureIndex();
  const key = ymd(d);
  const exact = _dateMap.get(key);
  const rec = _recList.length ? _recList.filter((e) => occursOn(e, d, key)) : null;
  if (!exact && (!rec || !rec.length)) return [];
  const list = exact && rec?.length ? [...exact, ...rec] : exact ? [...exact] : rec;
  return list.length > 1 ? list.sort(byTime) : list;
}
export function formatEventWhen(e) {
  const isTask = e.kind === 'task';
  const tStr = e.time ? (isTask ? `Tenggat ${e.time}` : e.time + (e.end ? ' – ' + e.end : '')) : (isTask ? 'Tenggat hari ini' : 'Sepanjang hari');
  let base = tStr;
  if (e.endDate && e.endDate > e.date) {
    const a = parseYmd(e.date), b = parseYmd(e.endDate);
    const sameM = a.getMonth() === b.getMonth() && a.getFullYear() === b.getFullYear();
    const dStr = sameM ? `${a.getDate()}–${b.getDate()} ${MONTHS[b.getMonth()]}` : `${a.getDate()} ${MONTHS[a.getMonth()]} – ${b.getDate()} ${MONTHS[b.getMonth()]}`;
    base = `${dStr} · ${tStr}`;
  }
  return e.location ? `${base} · 📍 ${e.location}` : base;
}

function googleCalTemplateUrl(d) {
  const d8 = (s) => s.replace(/-/g, '');
  const t6 = (t) => t.replace(':', '') + '00';
  const endD = d.endDate && d.endDate >= d.date ? d.endDate : d.date;
  let dates;
  if (d.time) {
    dates = `${d8(d.date)}T${t6(d.time)}/${d8(endD)}T${t6(d.end || d.time)}`;
  } else {
    const next = parseYmd(endD); next.setDate(next.getDate() + 1);
    dates = `${d8(d.date)}/${d8(ymd(next))}`;
  }
  const p = new URLSearchParams({ action: 'TEMPLATE', text: d.title || '', dates });
  if (d.location) p.set('location', d.location);
  if (d.note) p.set('details', d.note);
  return 'https://calendar.google.com/calendar/render?' + p.toString();
}

function isoWeek(d) {
  const t = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
  const day = t.getUTCDay() || 7; t.setUTCDate(t.getUTCDate() + 4 - day);
  const y0 = new Date(Date.UTC(t.getUTCFullYear(), 0, 1));
  return Math.ceil(((t - y0) / 864e5 + 1) / 7);
}

// ---------- Render ----------
export function render(dir = 0, wave = false, quiet = false) {
  if (!root) return;
  const s = settings;
  const t = today(), tKey = ymd(t);
  $('#c-title', root).textContent = `${(innerWidth < 500 ? MONTHS : MONTHS_LONG)[cursor.getMonth()]} ${cursor.getFullYear()}`;
  const cols = s.weekNumbers ? '44px repeat(7, 1fr)' : 'repeat(7, 1fr)';
  const order = [...Array(7)].map((_, i) => (i + s.weekStart) % 7);
  const wd = $('#c-wd', root);
  wd.style.gridTemplateColumns = cols;
  const curMonth = cursor.getMonth() === t.getMonth() && cursor.getFullYear() === t.getFullYear();
  wd.innerHTML = (s.weekNumbers ? '<div class="wk">Mg</div>' : '') + order.map((d) =>
    `<div class="${curMonth && d === t.getDay() ? 'now' : ''} ${s.redSunday && d === 0 ? 'red' : ''}">${DAYS[d]}</div>`).join('');

  const offset = (cursor.getDay() - s.weekStart + 7) % 7;
  const start = new Date(cursor); start.setDate(1 - offset);
  const grid = $('#c-grid', root);
  grid.style.gridTemplateColumns = cols;
  grid.classList.toggle('cal-round', s.todayStyle === 'round');
  let html = '';
  for (let i = 0; i < 42; i++) {
    const d = new Date(start); d.setDate(start.getDate() + i);
    const key = ymd(d);
    if (s.weekNumbers && i % 7 === 0) html += `<div class="cell wk">${isoWeek(d)}</div>`;
    const cls = ['cell'];
    const other = d.getMonth() !== cursor.getMonth();
    if (other) cls.push('other');
    if (other && !s.showOther) cls.push('hideother');
    if (key === tKey) cls.push('today');
    if (key === selected) cls.push('sel');
    const evs = eventsOn(d);
    if ((s.redSunday && d.getDay() === 0) || evs.some((e) => e._holiday)) cls.push('red');
    if (i % 7 === 6) cls.push('endcol');
    let body = '';
    if (s.eventStyle === 'dot') {
      body = evs.length ? `<div class="dots">${evs.slice(0, 6).map((e) => `<i style="background:${e.color}"></i>`).join('')}</div>` : '';
    } else {
      const max = 3;
      body = `<div class="evs">${evs.slice(0, max).map((e) => `<div class="ev ${e.done ? 'done' : ''}" style="background:${e.color}">${e.kind === 'task' ? (e.done ? '✓ ' : '○ ') : ''}${e.time ? e.time + ' ' : ''}${esc(e.title)}</div>`).join('')}${evs.length > max ? `<div class="more">+${evs.length - max}</div>` : ''}</div>`;
    }
    const hasNote = findDay(key)?.ink ? `<i class="has-note" title="Ada catatan">${ICON.pen}</i>` : '';
    html += `<button class="${cls.join(' ')}" style="--i:${i}" data-date="${key}"><span class="num"><span>${d.getDate()}</span>${hasNote}</span>${body}</button>`;
  }
  grid.innerHTML = html;
  grid.classList.toggle('quiet', quiet);
  grid.classList.remove('anim', 'wave');
  if (dir || wave) {
    void grid.offsetWidth;
    grid.style.setProperty('--dir', dir > 0 ? '36px' : '-36px');
    grid.classList.add(wave ? 'wave' : 'anim');
  }
}

