  const boxW = t.w || Math.max(0, ...widths);
  lines.forEach((line, i) => {
    const lw = widths[i];
    const dx = t.al === 'center' ? (boxW - lw) / 2 : t.al === 'right' ? boxW - lw : 0;
    const x = t.x + dx, y = t.y + off + i * lh;
