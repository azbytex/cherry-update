export const DEFAULT_MONTH_STYLE = { accent: '#ff6b8b', accent2: '#8b5cf6', cell: '#fff6f8', line: '#f3d2da', ink: '#2a2a33', font: 'Fredoka', shape: 'circle' };

const MG = { L: 34, R: 966, top: 186, head: 60, bottom: 1260, gap: 8 };
function monthGeom(meta) {
  const ws = meta?.weekStart ?? 0;
