    if (t.hl && lw) { ctx.save(); ctx.globalAlpha = 0.42; ctx.fillStyle = t.hl; ctx.fillRect((x - 2) * s, (top - t.z * 0.04) * s, (lw + 4) * s, t.z * 1.08 * s); ctx.restore(); }
