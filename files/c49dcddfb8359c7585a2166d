const CUTE_FONTS = ['Cherry Bomb One', 'Fredoka', 'Baloo 2', 'Grandstander', 'Lilita One', 'Pacifico', 'Chewy', 'Mochiy Pop One', 'Sniglet', 'Coiny', 'Bubblegum Sans', 'Luckiest Guy', 'Righteous', 'Lobster', 'Sour Gummy'];
