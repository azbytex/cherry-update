}

// ---------- Peta interaktif template: kotak centang & area isian ----------
// checks: [{x,y,s}] kotak yang bisa dicentang; areas: tempat teks otomatis rapi (base0 = garis dasar pertama)
const layoutCache = new Map();
export function templateLayout(tpl, meta) {
  if (tpl !== 'monthly' && tpl !== 'daily') return null;
  const key = `${tpl}|${meta?.month || ''}|${meta?.weekStart ?? 0}`;
  if (layoutCache.has(key)) return layoutCache.get(key);
  const checks = [], areas = [];
  if (tpl === 'monthly') {
    // areas[0] = cadangan (dulu kotak to-do); kotak tanggal mulai indeks 1
    areas.push({ x: -1e4, y: -1e4, w: 0, h: 0, base0: 0, lh: 1, z: 1 });
    const g = monthGeom(meta);
    for (let r = 0; r < g.rows; r++) for (let c = 0; c < 7; c++) {
      const b = g.cell(r, c);
      areas.push({ x: b.x + 10, y: b.y, w: b.w - 20, h: b.h, base0: b.y + 66, lh: 25, z: 18, icon: iconRect(b) });
    }
  } else {
    for (let i = 0; i < 8; i++) checks.push({ x: 600, y: 278 + i * 52, s: 22 });
    areas.push({ x: 148, y: 240, w: 405, h: 1130, base0: 290, lh: 64, z: 24 });
    areas.push({ x: 640, y: 262, w: 295, h: 416, base0: 300, lh: 52, z: 22 });
    areas.push({ x: 604, y: 772, w: 330, h: 600, base0: 810, lh: 44, z: 22 });
  }
  const out = { checks, areas };
