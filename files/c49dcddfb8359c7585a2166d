    ctx.lineCap = bullet || hb === 'round' ? 'round' : 'butt';
    ctx.lineWidth = (hb === 'under' ? st.w * 0.32 : bullet ? st.w * 0.5 : st.w) * s;
    if (hb === 'under') { ctx.translate(0, st.w * 0.42 * s); }
    if (hb === 'metal') {
      // dasar metalik + garis kilau di atasnya
      ctx.beginPath(); ctx.moveTo(p[0] * s, p[1] * s);
      for (let i = 1; i < n; i++) ctx.lineTo(p[i * 3] * s, p[i * 3 + 1] * s);
      if (n === 1) ctx.lineTo(p[0] * s + 0.1, p[1] * s);
      ctx.stroke();
      ctx.globalAlpha = 0.5; ctx.strokeStyle = '#ffffff'; ctx.lineWidth = ctx.lineWidth * 0.22;
      ctx.translate(0, -st.w * (bullet ? 0.1 : 0.2) * s);
