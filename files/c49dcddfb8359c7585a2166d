export function drawTemplate(ctx, cw, ch, tpl, paper, meta) {
  const p = PAPERS[paper] || PAPERS.white;
  const s = cw / PAGE_W;
  ctx.fillStyle = p.bg;
  ctx.fillRect(0, 0, cw, ch);
  const ink = paper === 'dark' ? '#e6e6e8' : '#26262a';
