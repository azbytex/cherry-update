// tulisan di kertas ikut bahasa aplikasi (dipanggil sekali saat mulai)
export function setPaperLang(en) {
  if (!en) return;
  MON_NICE.splice(0, 12, ...MON_EN.map((m) => m[0] + m.slice(1).toLowerCase()));
