// ---------- Teks ----------
// text = { x, y, z: ukuran, c: warna, v: isi }
export const TEXT_LH = 1.3;
export const TEXT_FONT = '"Segoe UI", Roboto, system-ui, sans-serif';
// t.base = true → t.y adalah garis dasar baris pertama (teks duduk di garis kertas), t.lh = jarak baris
export const BASE_LIFT = 7;
let measureCtx;
export const textFont = (t) => t.f ? `"${t.f}", ${TEXT_FONT}` : TEXT_FONT;
export function measurer(z, t) { measureCtx ||= document.createElement('canvas').getContext('2d'); measureCtx.font = `${t?.it ? 'italic ' : ''}${t?.b ? '700 ' : ''}${z}px ${t ? textFont(t) : TEXT_FONT}`; return measureCtx; }

// Pecah teks jadi baris sesuai lebar maksimum (t.w); pindah baris otomatis.
export function wrapLines(t) {
  const m = measurer(t.z, t);
  const max = t.w || Infinity;
  const out = [];
  for (const para of t.v.split('\n')) {
    if (m.measureText(para).width <= max) { out.push(para); continue; }
    let line = '';
    for (const word of para.split(/(\s+)/)) {
      const test = line + word;
      if (m.measureText(test).width <= max || !line.trim()) {
        if (m.measureText(test).width > max) {
          // kata terlalu panjang: potong per huruf
          for (const ch of word) { if (m.measureText(line + ch).width > max && line) { out.push(line); line = ''; } line += ch; }
        } else line = test;
      } else { out.push(line.replace(/\s+$/, '')); line = word.replace(/^\s+/, ''); }
    }
    out.push(line);
  }
  return out;
}
const lineH = (t) => t.lh || t.z * TEXT_LH;

export function drawText(ctx, t, s) {
  ctx.save();
  if (t.r) { // putar terhadap titik tengah kotak teks
    const b = textBox(t), cx = (b.x + b.w / 2) * s, cy = (b.y + b.h / 2) * s;
    ctx.translate(cx, cy); ctx.rotate(t.r); ctx.translate(-cx, -cy);
  }
  ctx.fillStyle = t.c;
  ctx.font = `${t.it ? 'italic ' : ''}${t.b ? '700 ' : ''}${t.z * s}px ${textFont(t)}`;
  ctx.textBaseline = t.base ? 'alphabetic' : 'top';
