}

// ---------- Uji tabrak penghapus ----------
function segDist2(px, py, ax, ay, bx, by) {
  const dx = bx - ax, dy = by - ay;
  const l = dx * dx + dy * dy;
  let t = l ? ((px - ax) * dx + (py - ay) * dy) / l : 0;
  t = Math.max(0, Math.min(1, t));
  const x = ax + t * dx - px, y = ay + t * dy - py;
  return x * x + y * y;
}
export function strokeHit(st, x, y, r) {
  const p = st.p, n = p.length / 3;
  const rr = r + st.w / 2;
  const rr2 = rr * rr;
  if (n === 1) return (p[0] - x) ** 2 + (p[1] - y) ** 2 <= rr2;
  for (let i = 1; i < n; i++) if (segDist2(x, y, p[i * 3 - 3], p[i * 3 - 2], p[i * 3], p[i * 3 + 1]) <= rr2) return true;
