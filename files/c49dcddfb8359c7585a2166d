}
export function textHit(t, x, y, r = 0) {
  const b = textBox(t);
  if (t.r) { // titik → koordinat lokal teks yang belum diputar
    const cx = b.x + b.w / 2, cy = b.y + b.h / 2, c = Math.cos(-t.r), sn = Math.sin(-t.r);
    const dx = x - cx, dy = y - cy;
    x = cx + dx * c - dy * sn; y = cy + dx * sn + dy * c;
  }
  return x >= b.x - r && x <= b.x + b.w + r && y >= b.y - r && y <= b.y + b.h + r;
}

