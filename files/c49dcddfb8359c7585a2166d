}
export function textBox(t) {
  const m = measurer(t.z, t);
  const lines = wrapLines(t);
  const ws = lines.map((l) => m.measureText(l).width);
  const w = Math.max(...ws, 10);
  // sama dengan drawText: rata tengah/kanan menggeser baris di dalam lebar t.w
  const boxW = t.w || Math.max(0, ...ws);
  const ox = !t.al || t.al === 'left' ? 0 : Math.min(...ws.map((lw) => t.al === 'center' ? (boxW - lw) / 2 : boxW - lw));
  const top = t.base ? t.y - lineH(t) : t.y;
  return { x: t.x + Math.max(0, Math.min(ox, boxW - w)), y: top, w, h: lines.length * lineH(t) };
}

// Posisi garis kertas untuk teks: kembalikan {x, y(garis dasar), lh} atau null kalau kertas polos.
export function snapToLines(tpl, x, y, z, meta) {
  const lay = templateLayout(tpl, meta);
  if (lay) {
    const a = lay.areas.find((r) => x >= r.x - 8 && x <= r.x + r.w + 8 && y >= r.y && y <= r.y + r.h);
    if (!a) return null;
    const k = Math.max(0, Math.ceil((y - a.base0) / a.lh));
    return { x: a.x, y: a.base0 + k * a.lh, lh: a.lh, w: a.w, z: a.z, a0: a.base0, ab: a.y + a.h };
  }
  const gap = 40;
  const lh = gap * Math.max(1, Math.ceil(z * 1.05 / gap));
  if (tpl === 'lined') {
    const k = Math.max(0, Math.ceil((y - 130) / gap));
    return { x: x < 130 ? 122 : x, y: 130 + k * gap, lh };
  }
  if (tpl === 'grid' || tpl === 'dot') {
    return { x: Math.max(gap, Math.round(x / gap) * gap) + 4, y: Math.max(gap, Math.ceil(y / gap) * gap), lh };
