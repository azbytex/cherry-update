    }
    ctx.beginPath();
    ctx.moveTo(p[0] * s, p[1] * s);
    for (let i = 1; i < n; i++) ctx.lineTo(p[i * 3] * s, p[i * 3 + 1] * s);
    if (n === 1) ctx.lineTo(p[0] * s + 0.1, p[1] * s);
    ctx.stroke();
    ctx.restore();
    return;
  }
  if (n === 1) {
    const b = st.b || 'pen';
    const bp = brushProps(st, p[2] || 0.5);
    ctx.globalAlpha = bp.alpha;
    if (b === 'calligraphy') {
      const r = Math.max(1, bp.w * s / 2);
      ctx.translate(p[0] * s, p[1] * s);
      ctx.rotate(NIB_ANGLE);
      ctx.fillRect(-r * 0.4, -r * 1.3, r * 0.8, r * 2.6);
    } else {
      ctx.beginPath();
      ctx.arc(p[0] * s, p[1] * s, Math.max(0.5, bp.w * s / 2), 0, 7);
      ctx.fill();
    }
    ctx.restore();
    return;
  }
  if (st.sharp) {
    const bp = brushProps(st, p[2] || 0.5);
    ctx.globalAlpha = bp.alpha;
    ctx.lineWidth = bp.w * s;
    ctx.beginPath();
    ctx.moveTo(p[0] * s, p[1] * s);
    for (let i = 1; i < n; i++) ctx.lineTo(p[i * 3] * s, p[i * 3 + 1] * s);
    ctx.stroke(); ctx.restore(); return;
  }

  const b = st.b || 'pen';
  if (b === 'pencil') {
    ctx.globalAlpha = Math.max(0.35, Math.min(0.9, 0.32 + p[2] * 0.65));
  } else if (b === 'brush') {
    ctx.globalAlpha = 0.95;
  }

  let px = p[0], py = p[1];
  for (let i = 1; i < n; i++) {
    const x = p[i * 3], y = p[i * 3 + 1];
    const mx = i < n - 1 ? (x + p[i * 3 + 3]) / 2 : x, my = i < n - 1 ? (y + p[i * 3 + 4]) / 2 : y;
    const dx = x - px, dy = y - py;
    const pr = (p[i * 3 - 1] + p[i * 3 + 2]) / 2;
    const bp = brushProps(st, pr, dx, dy);
    ctx.lineWidth = bp.w * s;
    ctx.beginPath();
    ctx.moveTo(px * s, py * s);
    ctx.quadraticCurveTo(x * s, y * s, mx * s, my * s);
    ctx.stroke();
    px = mx; py = my;
  }
  ctx.restore();
}

// Gambar segmen terakhir saja (untuk tinta live yang cepat)
export function drawLastSegment(ctx, st, s) {
  const p = st.p, n = p.length / 3;
  if (n < 2) { drawStroke(ctx, st, s); return; }
  const i = n - 1;
  const x0 = n > 2 ? (p[(i - 2) * 3] + p[(i - 1) * 3]) / 2 : p[0], y0 = n > 2 ? (p[(i - 2) * 3 + 1] + p[(i - 1) * 3 + 1]) / 2 : p[1];
  const cx = p[(i - 1) * 3], cy = p[(i - 1) * 3 + 1];
  const x1 = (cx + p[i * 3]) / 2, y1 = (cy + p[i * 3 + 1]) / 2;
  const dx = cx - x0, dy = cy - y0;
  const bp = brushProps(st, p[i * 3 + 2] || 0.5, dx, dy);
  ctx.save();
  ctx.lineCap = bp.cap; ctx.lineJoin = bp.join;
  ctx.strokeStyle = st.c;
  ctx.globalAlpha = bp.alpha;
