export function defaultInk(paper) { return paper === 'dark' ? '#f4f4f5' : '#1f1f22'; }

// ---------- Coretan ----------
// stroke = { t: 'pen'|'hl', b: 'pen'|'ballpoint'|'pencil'|'calligraphy'|'brush', c: warna, w: tebal, p: [x, y, tekanan, ...] } dalam satuan halaman (lebar 1000)
const NIB_ANGLE = 0.75; // sudut miring kaligrafi (~43 derajat)

export function brushProps(st, pr, dx = 0, dy = 0) {
  const b = st.b || 'pen';
  if (b === 'ballpoint') {
    return { w: st.w * (0.85 + (pr || 0.5) * 0.3), alpha: 1, cap: 'round', join: 'round' };
  }
  if (b === 'pencil') {
    const alpha = Math.max(0.35, Math.min(0.9, 0.32 + (pr || 0.5) * 0.65));
    return { w: st.w * (0.6 + (pr || 0.5) * 0.7), alpha, cap: 'round', join: 'round' };
  }
  if (b === 'calligraphy') {
    let factor = 0.7;
    if (dx !== 0 || dy !== 0) {
      const angle = Math.atan2(dy, dx);
      factor = Math.max(0.22, Math.abs(Math.sin(angle - NIB_ANGLE)));
    }
    return { w: st.w * (0.28 + 1.22 * factor) * (0.65 + (pr || 0.5) * 0.7), alpha: 1, cap: 'round', join: 'round' };
  }
  if (b === 'brush') {
    return { w: st.w * (0.25 + Math.pow(pr || 0.5, 1.4) * 2.2), alpha: 0.95, cap: 'round', join: 'round' };
  }
  // default: fountain pen
  return { w: st.w * (0.45 + (pr || 0.5) * 1.1), alpha: 1, cap: 'round', join: 'round' };
}

export function drawStroke(ctx, st, s) {
  const p = st.p;
  const n = p.length / 3;
  if (!n) return;
  ctx.save();
  ctx.lineCap = 'round';
  ctx.lineJoin = 'round';
  ctx.strokeStyle = st.c;
  ctx.fillStyle = st.c;
  if (st.fill) {
    ctx.beginPath();
    for (let i = 0; i < n; i++) ctx.lineTo(p[i * 3] * s, p[i * 3 + 1] * s);
    ctx.closePath();
    ctx.globalAlpha = 0.35; ctx.fill();
    ctx.globalAlpha = 1; ctx.lineWidth = st.w * s; ctx.stroke();
    ctx.restore();
    return;
  }
  if (st.t === 'hl') {
    const hb = st.b || 'pen', bullet = st.tip === 'bullet';
    // tinta: neon cerah, mild lembut, pastel tipis, metalik menutup + kilau
