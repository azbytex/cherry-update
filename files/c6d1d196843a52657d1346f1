.cover.s-kraft { background-image: radial-gradient(rgba(0,0,0,.08) 1px, transparent 1.2px), radial-gradient(rgba(255,255,255,.12) 1px, transparent 1.2px), linear-gradient(rgba(150,110,60,.25), rgba(150,110,60,.25)); background-size: 7px 7px, 11px 11px, auto; background-position: 0 0, 3px 5px, 0 0; }
.cover.s-leather { background-image: radial-gradient(circle at 30% 20%, rgba(255,255,255,.18), transparent 60%), radial-gradient(rgba(0,0,0,.12) 1px, transparent 1.3px); background-size: auto, 5px 5px; box-shadow: inset 0 0 0 5px rgba(0,0,0,.08), inset 0 0 0 6px rgba(255,255,255,.25), 0 2px 4px rgba(0,0,0,.12), 0 8px 18px rgba(0,0,0,.1); }
.cover.s-tape::after { content: ""; position: absolute; left: 30%; top: -4%; width: 42%; height: 13%; background: repeating-linear-gradient(90deg, rgba(255,255,255,.75) 0 6px, rgba(255,255,255,.55) 6px 12px); transform: rotate(-6deg); box-shadow: 0 1px 2px rgba(0,0,0,.1); }
.cover.s-corner::after { content: ""; position: absolute; right: 0; bottom: 0; width: 26%; aspect-ratio: 1; background: linear-gradient(135deg, transparent 50%, #e8c66a 50%, #b88a2c); }
.cover.s-frame::after { content: ""; position: absolute; inset: 7% 8% 7% 14%; border: 2px solid rgba(255,255,255,.6); border-radius: 4px; outline: 1px solid rgba(255,255,255,.35); outline-offset: 3px; }
.cv-motifs { display: grid; grid-template-columns: repeat(auto-fill, minmax(54px, 1fr)); gap: 8px; max-height: 196px; overflow-y: auto; padding: 2px; }
.cv-motif { display: flex; flex-direction: column; align-items: center; gap: 3px; padding: 4px 2px; border-radius: 10px; border: 2px solid transparent; font-size: 10.5px; color: var(--soft); }
.cv-motif .cover { width: 34px; height: 45px; flex: none; }
.cv-motif.on { border-color: var(--accent, #ffcc00); background: var(--rail); color: var(--ink); }
.cv-motif:active .cover { transform: scale(.92); }
/* sampul foto: tetap terlihat seperti buku — punggung jilid, kilap laminasi, label judul */
.cover.img { background: #fff; }
.cover.img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
.cover.img::before { z-index: 2; background: linear-gradient(90deg, rgba(0,0,0,.34), rgba(0,0,0,.08) 70%, rgba(255,255,255,.22)); }
.cover.img::after { content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none;
  background: linear-gradient(115deg, rgba(255,255,255,.22) 0%, rgba(255,255,255,0) 32%, rgba(255,255,255,0) 68%, rgba(0,0,0,.14) 100%);
  box-shadow: inset 0 0 0 1px rgba(255,255,255,.18), inset -3px 0 6px rgba(0,0,0,.12); border-radius: inherit; }
.cover.img .label { z-index: 3; box-shadow: 0 2px 8px rgba(0,0,0,.18); }

/* Sampul PDF: tampilan buku dengan jendela preview isi PDF di tengah */
.cover.pdf { position: relative; }
.cover.pdf .pdf-window {
  position: absolute;
  left: 19%;
  right: 11%;
  top: 13%;
  bottom: 15%;
  background: #fff;
  border-radius: 4px;
  overflow: hidden;
  box-shadow: 0 3px 10px rgba(0,0,0,.22), 0 1px 2px rgba(0,0,0,.12);
  border: 2px solid rgba(255,255,255,.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}
.cover.pdf .pdf-window img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  display: block;
  background: #fff;
}

/* ================= Editor ================= */
.editor { position: fixed; inset: 0; background: #e9e9ec; z-index: 40; display: none; flex-direction: column; padding-top: var(--sat); padding-bottom: var(--sab); }
[data-theme="dark"] .editor { background: #0f0f11; }
.editor.open { display: flex; }
.etop { flex: none; display: flex; align-items: center; gap: 4px; padding: 6px 10px; background: var(--card); border-bottom: 1px solid var(--line); min-height: 60px; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
.etop::-webkit-scrollbar { display: none; }
.etitle { font-size: 17px; font-weight: 500; padding: 6px 8px; border-radius: 8px; max-width: 220px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: none; }
.tool { width: 42px; height: 42px; border-radius: 10px; display: grid; place-items: center; flex: none; color: var(--soft); position: relative; }
.tool svg { width: 24px; height: 24px; }
.tool.on { background: color-mix(in srgb, var(--note) 22%, transparent); color: var(--text); }
.tool:disabled { opacity: .35; }
.sep { width: 1px; height: 28px; background: var(--line); margin: 0 6px; flex: none; }
.pcolor { width: 26px; height: 26px; border-radius: 50%; flex: none; margin: 0 3px; border: 3px solid var(--card); box-shadow: 0 0 0 1.5px var(--line); }
.pcolor.on { box-shadow: 0 0 0 2.5px var(--text); }
.sizes { display: flex; align-items: center; gap: 2px; flex: none; }
.sizebtn { width: 32px; height: 42px; display: grid; place-items: center; border-radius: 8px; }
.sizebtn i { background: var(--soft); border-radius: 50%; display: block; }
.sizebtn.on { background: var(--rail); }
.sizebtn.on i { background: var(--text); }
.pages { flex: 1; overflow: auto; touch-action: none; position: relative; }
.pages-inner { position: relative; display: flex; flex-direction: column; align-items: center; gap: 40px; padding: 20px 0 120px; transform-origin: 0 0; }
.page { position: relative; background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.12), 0 6px 20px rgba(0,0,0,.08); flex: none; }
.page canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
.page canvas.c-hi { inset: auto; pointer-events: none; }
.page .pno { position: absolute; bottom: -22px; right: 40px; font-size: 12px; color: var(--muted); }
.page .pdel { position: absolute; bottom: -34px; right: 0; width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; color: var(--muted); background: var(--card); box-shadow: 0 1px 3px rgba(0,0,0,.12); transition: color .15s, transform .15s; }
.page .pdel svg { width: 17px; height: 17px; }
.page .pdel:hover, .page .pdel:active { color: var(--danger); transform: scale(1.08); }
.page .pdel[hidden] { display: none; }

/* Mode Dua Halaman (Two-Page Book Spread) Horizontal dengan Fisika Buku */
.pages.spread-mode {
  overflow-x: auto !important;
  overflow-y: hidden !important;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
}

.pages-inner.spread-mode {
  display: flex !important;
  flex-direction: row !important;
  flex-wrap: nowrap !important;
  align-items: center !important;
  justify-content: flex-start !important;
  min-height: 100% !important;
  height: 100% !important;
  gap: 0 !important;
  padding: 16px var(--spread-pad, 40px) 70px !important;
  box-sizing: border-box !important;
}

.pages-inner.spread-mode .page {
  flex: none;
  transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.25, 1), box-shadow 0.3s;
}

.pages-inner.spread-mode .page:nth-child(odd) {
  border-radius: 6px 1px 1px 6px;
  box-shadow: -8px 8px 24px rgba(0,0,0,.16), inset -16px 0 24px -10px rgba(0,0,0,.24);
  border-right: 1px solid rgba(0,0,0,.08);
  margin-right: 0;
  transform-origin: right center;
}

.pages-inner.spread-mode .page:nth-child(odd)::before {
  content: "";
  position: absolute;
  top: 0; bottom: 0; right: 0; width: 36px;
  background: linear-gradient(90deg, transparent 60%, rgba(0,0,0,.06) 80%, rgba(0,0,0,.24));
  pointer-events: none;
  z-index: 5;
}

.pages-inner.spread-mode .page:nth-child(odd) .pno {
  left: 28px; right: auto;
}

.pages-inner.spread-mode .page:nth-child(odd) .pdel {
  left: 0; right: auto;
}

.pages-inner.spread-mode .page:nth-child(even) {
  border-radius: 1px 6px 6px 1px;
  box-shadow: 8px 8px 24px rgba(0,0,0,.16), inset 16px 0 24px -10px rgba(0,0,0,.24);
  margin-right: var(--spread-gap, 80px);
  transform-origin: left center;
}

.pages-inner.spread-mode .page:nth-child(even)::before {
  content: "";
  position: absolute;
  top: 0; bottom: 0; left: 0; width: 36px;
  background: linear-gradient(90deg, rgba(0,0,0,.24), rgba(0,0,0,.06) 20%, transparent 40%);
  pointer-events: none;
  z-index: 5;
}

.pages-inner.spread-mode .page:nth-child(even) .pno {
  right: 28px; left: auto;
}

.pages-inner.spread-mode .page:nth-child(even) .pdel {
  right: 0; left: auto;
}

.pages-inner.spread-mode .page:nth-child(odd):last-child {
  border-radius: 6px;
  border-right: none;
  margin-right: var(--spread-gap, 80px);
}

/* Tombol Balik Halaman Buku Fisik (Floating Book Page Turn Buttons) */
.pflip-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 44px;
  height: 64px;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text);
  z-index: 10;
  cursor: pointer;
  transition: opacity .2s, transform .2s var(--spring), background .2s;
  user-select: none;
}
.pflip-btn:hover {
  background: #fff;
  transform: translateY(-50%) scale(1.06);
}
.pflip-btn:active {
  transform: translateY(-50%) scale(0.95);
}
.pflip-prev {
  left: 14px;
  border-radius: 8px 18px 18px 8px;
}
.pflip-next {
  right: 14px;
  border-radius: 18px 8px 8px 18px;
}
.pflip-btn[hidden] {
  display: none !important;
}

.pill.on { background: var(--note); color: var(--note-ink); font-weight: 600; border-color: transparent; }
.ebottom { position: absolute; right: 18px; bottom: calc(18px + var(--sab)); display: flex; gap: 10px; z-index: 2; }
.pill { background: var(--card); border: 1px solid var(--line); box-shadow: var(--shadow); border-radius: 999px; padding: 8px 14px; font-size: 13px; display: flex; align-items: center; gap: 6px; }
.pill svg { width: 18px; height: 18px; }
.paper-opts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
.paper-opt { aspect-ratio: 3/4; border-radius: 8px; border: 2px solid var(--line); position: relative; overflow: hidden; }
.paper-opt.on { border-color: var(--note); box-shadow: 0 0 0 2px var(--note); }
.paper-opt span { position: absolute; bottom: 0; left: 0; right: 0; font-size: 12px; padding: 4px; background: rgba(255,255,255,.85); color: #333; text-align: center; }
.paper-opt canvas { width: 100%; height: 100%; display: block; }
.text-input { position: absolute; z-index: 5; min-width: 0; background: rgba(255,255,255,.9); border: 0; outline: 1.5px dashed var(--note); outline-offset: 2px; padding: 0; margin: 0; font-family: inherit; color: #222; white-space: pre-wrap; word-break: break-word; resize: none; overflow: hidden; line-height: 1.25; box-sizing: content-box; }
.text-input.on-lines { background: transparent; }

.ebody { position: relative; flex: 1; display: flex; flex-direction: column; min-height: 0; }

/* header halaman harian */
.dayhead { flex: none; display: flex; align-items: center; gap: 10px; padding: 8px 14px; background: var(--card); border-bottom: 1px solid var(--line); overflow: hidden; }
.dh-date { display: flex; align-items: center; gap: 10px; flex: none; }
.dh-date b { font-size: 38px; font-weight: 800; color: var(--cal); line-height: 1; }
.dh-date span { font-size: 15px; font-weight: 600; line-height: 1.2; }
.dh-date small { font-weight: 400; color: var(--soft); }
.dh-evs { flex: 1; display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; min-width: 0; padding: 0 6px; }
.dh-ev { flex: none; padding: 6px 12px; border-radius: 999px; font-size: 13px; background: color-mix(in srgb, var(--c) 16%, var(--card)); border-left: 4px solid var(--c); white-space: nowrap; }
.dh-ev small { color: var(--soft); }
.dh-none { color: var(--muted); font-size: 13px; align-self: center; white-space: nowrap; }

/* popup catatan berformat (ala Word) */
.sheet.wide { width: min(780px, 100%); }
.rn-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
.rn-sub { color: var(--soft); font-size: 14px; margin-top: 2px; }
.rn-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 2px; padding: 6px; background: var(--rail); border-radius: 12px; position: sticky; top: -22px; z-index: 2; }
.rn-b { width: 38px; height: 38px; border-radius: 8px; display: grid; place-items: center; color: var(--text); transition: background-color .15s, transform .2s var(--spring); }
.rn-b svg { width: 20px; height: 20px; }
.rn-b:hover { background: var(--card); }
.rn-b.on { background: color-mix(in srgb, var(--note) 55%, var(--card)); }
.rn-b:active { transform: scale(.88); }
.rn-sep { width: 1px; height: 24px; background: var(--line); margin: 0 4px; }
.rn-body { min-height: 260px; max-height: 52vh; overflow: auto; margin-top: 10px; padding: 16px 18px; border: 1px solid var(--line); border-radius: 12px; background: var(--bg); font-size: 16px; line-height: 1.6; outline: none; user-select: text; -webkit-user-select: text; word-break: break-word; }
.rn-body:focus { border-color: var(--note); box-shadow: 0 0 0 3px color-mix(in srgb, var(--note) 35%, transparent); }
.rn-body:empty::before { content: attr(data-ph); color: var(--muted); }
.rn-body img { max-width: 100%; border-radius: 10px; display: inline-block; margin: 6px 0; cursor: pointer; box-shadow: 0 2px 10px rgba(0,0,0,.12); }
.rn-body h2 { font-size: 22px; margin: 8px 0 4px; }
.rn-body ul, .rn-body ol { padding-left: 24px; margin: 4px 0; }
.rn-wrap { position: relative; }
.rn-layer { position: absolute; left: 1px; right: 1px; top: 11px; bottom: 1px; overflow: hidden; pointer-events: none; border-radius: 11px; }
.rn-inner { position: absolute; left: 0; top: 0; width: 100%; }
.rn-float { position: absolute; pointer-events: auto; touch-action: none; cursor: grab; transform-origin: center; user-select: none; -webkit-user-select: none; }
.rn-float img { width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 6px; pointer-events: none; }
.rn-float:not(.is-stk) img { border: 5px solid #fff; box-shadow: 0 4px 14px rgba(0,0,0,.25); box-sizing: border-box; }
.rn-float.is-stk img { object-fit: contain; filter: drop-shadow(0 2px 3px rgba(0,0,0,.2)); }
.rn-float.is-txt { height: auto; }
.rn-txt { white-space: pre-wrap; word-break: break-word; line-height: 1.25; padding: 2px 4px; outline: none; min-height: 1em; }
.rn-float.editing { cursor: text; }
.rn-float.editing .rn-txt { outline: 2px dashed var(--note); outline-offset: 3px; background: rgba(255,255,255,.6); border-radius: 4px; user-select: text; -webkit-user-select: text; }
.emo { display: grid; place-items: center; width: 100%; height: 100%; line-height: 1; filter: drop-shadow(0 2px 2px rgba(0,0,0,.18)); }

/* kotak seleksi: geser, ubah ukuran, putar, hapus, duplikasi */
.tbox { position: absolute; border: 1.5px dashed #0a99f0; z-index: 5; border-radius: 6px; touch-action: none; cursor: move; transform-origin: center; pointer-events: auto; background: rgba(10, 153, 240, 0.04); }
.tbox.pop { animation: fadeIn .15s; }
.tb-h { position: absolute; width: 12px; height: 12px; background: #fff; border: 2px solid #0a99f0; border-radius: 50%; touch-action: none; transition: transform .15s var(--spring); box-shadow: 0 1px 3px rgba(0,0,0,.2); }
.tb-h::after, .tb-rot::after { content: ""; position: absolute; inset: -14px; }
.tbox.dragging .tb-h, .tb-h:hover { transform: scale(1.3); }
.tb-h.h-nw { left: -7px; top: -7px; cursor: nwse-resize; } .tb-h.h-se { right: -7px; bottom: -7px; cursor: nwse-resize; }
.tb-h.h-ne { right: -7px; top: -7px; cursor: nesw-resize; } .tb-h.h-sw { left: -7px; bottom: -7px; cursor: nesw-resize; }
.tb-h.h-n { left: calc(50% - 6px); top: -7px; cursor: ns-resize; } .tb-h.h-s { left: calc(50% - 6px); bottom: -7px; cursor: ns-resize; }
.tb-h.h-e { right: -7px; top: calc(50% - 6px); cursor: ew-resize; } .tb-h.h-w { left: -7px; top: calc(50% - 6px); cursor: ew-resize; }
.tbox.small .tb-h.h-n, .tbox.small .tb-h.h-s, .tbox.small .tb-h.h-e, .tbox.small .tb-h.h-w { display: none; }
.tbox.small .tb-size { display: none; }
.tb-rot { position: absolute; left: calc(50% - 9px); top: -38px; width: 18px; height: 18px; border-radius: 50%; background: #0a99f0; border: 3px solid #fff; box-shadow: 0 1px 4px rgba(0,0,0,.3); cursor: grab; touch-action: none; }
.tb-rot::before { content: ""; position: absolute; left: calc(50% - 1px); top: 15px; width: 2px; height: 17px; background: #0a99f0; }
.tb-size { position: absolute; left: 4px; bottom: 4px; background: rgba(0,0,0,.7); color: #fff; font-size: 11px; padding: 1px 7px; border-radius: 999px; pointer-events: none; }
.tb-size:empty { display: none; }
.tb-dup, .tb-copy { position: absolute; left: -16px; top: -40px; width: 28px; height: 28px; border-radius: 50%; background: #fff; color: var(--ink, #222); display: grid; place-items: center; box-shadow: 0 2px 6px rgba(0,0,0,.3); border: none; cursor: pointer; touch-action: manipulation; z-index: 2; }
.tb-dup svg, .tb-copy svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; }
.tb-del { position: absolute; right: -16px; top: -40px; width: 28px; height: 28px; border-radius: 50%; background: #e5484d; color: #fff; display: grid; place-items: center; box-shadow: 0 2px 6px rgba(0,0,0,.3); border: none; cursor: pointer; touch-action: manipulation; z-index: 2; }
.tb-lock { position: absolute; right: 18px; top: -40px; width: 28px; height: 28px; border-radius: 50%; background: #fff; color: var(--ink, #222); display: grid; place-items: center; box-shadow: 0 2px 6px rgba(0,0,0,.3); border: none; cursor: pointer; touch-action: manipulation; z-index: 2; }
.tb-lock svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
.tbox.locked { border-style: solid; border-color: #9aa3ad; background: rgba(120,130,140,.05); cursor: default; }
.tbox.locked .tb-h, .tbox.locked .tb-rot, .tbox.locked .tb-del, .tbox.locked .tb-dup, .tbox.locked .tb-size { display: none !important; }
.tbox.locked .tb-lock { right: -16px; background: #2b2f36; color: #fff; }
.tb-del svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 2; }

/* pemilih stiker */
.stk-dock { position: absolute; z-index: 6; left: 50%; top: 10px; transform: translateX(-50%); width: min(560px, calc(100% - 20px)); margin: 0 !important; box-shadow: var(--shadow); }
.stk-dock .stk-tab[data-photo] { background: color-mix(in srgb, var(--note) 35%, var(--card)); }
.rn-stk, .stk-dock { margin-top: 8px; background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 8px; animation: sheetIn .3s var(--spring); }
.stk-dock { animation: dockIn .32s var(--spring); }
/* panel stiker membuka ke bawah (expand), bukan membesar/zoom */
@keyframes dockIn {
  from { opacity: .4; clip-path: inset(0 0 100% 0 round 14px); }
  to { opacity: 1; clip-path: inset(0 0 0 0 round 14px); }
}
.stk-dock > * { animation: dockContentIn .34s var(--spring) both; }
@keyframes dockContentIn { from { opacity: 0; transform: translateY(-10px); } }
@media (prefers-reduced-motion: reduce) { .stk-dock, .stk-dock > * { animation: none; } }
.stk-tabs { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; padding-bottom: 6px; }
.stk-tab { padding: 6px 12px; border-radius: 999px; background: var(--rail); font-size: 13px; white-space: nowrap; flex: none; }
.stk-tab.on { background: var(--note); color: var(--note-ink); font-weight: 600; }
.stk-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(44px, 1fr)); gap: 4px; max-height: 170px; overflow-y: auto; }
.stk-grid.big { grid-template-columns: repeat(auto-fill, minmax(76px, 1fr)); }
.stk { height: 46px; border-radius: 10px; display: grid; place-items: center; font-size: 28px; transition: background-color .15s; }
.stk-grid.big .stk { height: 64px; padding: 4px; }
.stk:hover { background: var(--rail); }
.stk { overflow: hidden; min-width: 0; }
.stk img { width: 100%; height: 100%; min-height: 0; object-fit: contain; display: block; }
.stk .emo { filter: none; }
.stk { position: relative; }
.fl-bar { padding: 0 0 6px; }
.fl-bar .inp { padding: 8px 12px; font-size: 14px; }
.fl-grid { grid-template-columns: repeat(auto-fill, minmax(54px, 1fr)); max-height: 210px; }
.fl-grid .stk { height: 54px; padding: 4px; }
/* pemilih font: pagination horizontal dengan titik (tanpa scrollbar) */
.fp-tabs { display: flex; align-items: center; gap: 6px; overflow-x: auto; padding-bottom: 8px; scrollbar-width: none; }
.fp-tabs::-webkit-scrollbar { display: none; }
.fp-pages { display: flex; overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
.fp-pages::-webkit-scrollbar { display: none; }
.fp-page { flex: 0 0 100%; width: 100%; min-width: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 6px; scroll-snap-align: start; align-content: start; box-sizing: border-box; }
.fp-empty { width: 100%; text-align: center; color: var(--soft); font-size: 13px; padding: 28px 12px; }
.fp-pager { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 10px; }
.fp-pager[hidden] { display: none; }
.fp-dots { margin: 0 !important; flex-wrap: nowrap; align-items: center; }
.fp-dots button.edge { transform: scale(.65); opacity: .7; }
.fp-nav { width: 28px; height: 28px; border-radius: 50%; background: var(--rail); color: var(--text); font-size: 18px; line-height: 1; display: grid; place-items: center; transition: opacity .15s, transform .15s; flex: none; }
.fp-nav:disabled { opacity: .3; pointer-events: none; }
.fp-nav:active { transform: scale(.9); }
.fp-count { font-size: 12px; color: var(--soft); font-variant-numeric: tabular-nums; margin-left: 2px; }
.font-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 6px; }
.font-item { display: flex; flex-direction: column; align-items: flex-start; gap: 1px; padding: 7px 10px; border-radius: 11px; background: var(--rail); border: 2px solid transparent; text-align: left; min-width: 0; transition: transform .2s var(--spring); }
.font-item .fs { font-size: 16.5px; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
.font-item small { font-size: 10.5px; color: var(--soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
.font-item.on { border-color: var(--note); background: color-mix(in srgb, var(--note) 25%, var(--card)); }
.font-item:active { transform: scale(.95); }
.fontbtn { height: 36px; min-width: 44px; padding: 0 10px; border-radius: 10px; background: var(--rail); font-size: 18px; margin-left: 4px; }
/* gaya Monthly Plan */
.ms-preview { display: grid; place-items: center; background: var(--rail); border-radius: 14px; padding: 12px; margin-bottom: 14px; }
.ms-preview canvas { max-width: 100%; height: auto; border-radius: 6px; box-shadow: 0 4px 16px rgba(0,0,0,.12); }
.ms-row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; flex-wrap: wrap; }
.ms-row > span { width: 130px; font-size: 13px; color: var(--soft); flex: none; }
.sw.sm { width: 24px; height: 24px; border-width: 2px; }
.ms-any { position: relative; overflow: hidden; outline: 2px dashed var(--muted); outline-offset: 1px; }
.ms-any input { position: absolute; inset: 0; opacity: 0; width: 100%; height: 100%; cursor: pointer; }
.ms-all { display: flex; gap: 8px; align-items: center; font-size: 14px; color: var(--soft); margin-top: 4px; }
.stk-mine-bar { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 2px 0 8px; }
.stk-import { padding: 7px 14px; border-radius: 999px; background: var(--note); color: var(--note-ink); font-weight: 600; font-size: 13px; }
.stk-manage { padding: 7px 12px; border-radius: 999px; background: var(--rail); font-size: 13px; }
.stk-manage.on { background: var(--danger); color: #fff; }
.stk-hint { font-size: 12px; color: var(--muted); }
.stk-empty { grid-column: 1 / -1; color: var(--muted); font-size: 13px; padding: 16px; text-align: center; }
.stk-x { position: absolute; top: 2px; right: 2px; width: 20px; height: 20px; border-radius: 50%; background: var(--danger); color: #fff; font-size: 11px; font-style: normal; display: grid; place-items: center; }
.managing .stk { animation: wiggle .3s ease-in-out infinite alternate; }
@keyframes wiggle { from { transform: rotate(-3deg); } to { transform: rotate(3deg); } }
.rn-body .rn-todo input { width: 18px; height: 18px; vertical-align: -3px; accent-color: #16a34a; }

/* popup tanggal */
.dp-head { display: flex; align-items: center; gap: 14px; margin-bottom: 4px; }
.dp-num { width: 58px; height: 58px; border-radius: 16px; display: grid; place-items: center; font-size: 28px; font-weight: 700; background: var(--rail); flex: none; animation: numPop .45s var(--spring); }
@keyframes numPop { from { transform: scale(.4) rotate(-12deg); opacity: 0; } }
.dp-day { font-size: 19px; font-weight: 600; }
.dp-month { color: var(--soft); font-size: 14px; }
.dp-empty { color: var(--muted); font-size: 14px; padding: 4px 2px 8px; }
.dp-item { animation: cardIn .35s var(--ease) both; animation-delay: calc(var(--i, 0) * 45ms + 80ms); }

/* animasi tanggal membesar */
.zoomer { position: fixed; z-index: 45; background: var(--bg); border: 1px solid var(--line); overflow: hidden; display: flex; align-items: flex-start; gap: 16px; padding: 8px 12px; box-shadow: var(--shadow); pointer-events: none; }
.zoomer .zn { font-size: 26px; font-weight: 700; color: var(--cal); transition: font-size .36s cubic-bezier(.2,.8,.2,1); line-height: 1; }
.zoomer .zd { opacity: 0; font-weight: 600; font-size: 22px; transition: opacity .3s .12s; line-height: 1.25; padding-top: 10px; }
.zoomer .zd small { font-weight: 400; color: var(--soft); font-size: 16px; }
.zoomer.grow .zn { font-size: 96px; }
.zoomer.grow .zd { opacity: 1; }
.cell .has-note { display: inline-grid; margin-left: 4px; color: var(--cal); align-self: center; }
.cell.today .has-note { color: #fff; }
.cell .has-note svg { width: 14px; height: 14px; }

/* ================= Animasi ================= */
:root { --spring: cubic-bezier(.32, .72, 0, 1); --ease: cubic-bezier(.32, .72, 0, 1); --ios: cubic-bezier(.32, .72, 0, 1); }
.view.active { animation: viewIn .38s var(--ease); }
@keyframes viewIn { from { opacity: 0; transform: translateY(14px) scale(.99); } to { opacity: 1; transform: none; } }

/* tanggal muncul bergelombang */
.cal-grid { contain: layout style; }
.cal-grid.wave .cell { animation: cellIn .42s var(--ease) backwards; animation-delay: calc(var(--i) * 9ms); }
@keyframes cellIn { from { opacity: 0; transform: translateY(10px) scale(.96); } to { opacity: 1; transform: none; } }
.cal-grid.anim { animation: monthSlide .34s var(--ease); }
@keyframes monthSlide { from { opacity: 0; transform: translateY(var(--dir, 24px)); } to { opacity: 1; transform: none; } }
.cell { transition: background-color .2s, transform .15s; contain: layout style; }
.cell:active:not(.wk) { transform: scale(.97); }
.cell .ev { animation: evIn .3s var(--spring) both; }
.cal-grid.quiet .ev { animation: none; }
@keyframes evIn { from { opacity: 0; transform: scaleX(.6); transform-origin: left; } to { opacity: 1; transform: none; } }

/* indikator menu meluncur */
.rail button::before { transition: opacity .25s; opacity: 0; }
.rail button.active::before { opacity: 1; animation: railIn .35s var(--spring); }
@keyframes railIn { from { transform: scaleY(0); } to { transform: none; } }
.rail button svg { transition: transform .3s var(--spring); }
.rail button.active svg { transform: translateY(-2px) scale(1.08); }
.rail button:active svg { transform: scale(.88); }

/* sheet, popover, toast */
.scrim.open { animation: fadeIn .3s var(--ios); }
.scrim.open .sheet { animation: sheetIn .5s var(--ios); }
@keyframes fadeIn { from { opacity: 0; } }
@keyframes sheetIn { from { opacity: 0; transform: translateY(26px) scale(.975); } }
.popover.open { animation: popIn .34s var(--ios); transform-origin: top right; }
@keyframes popIn { from { opacity: 0; transform: scale(.92) translateY(-4px); } }
.popover.open button { animation: fadeIn .25s both; }
.toast { transition: opacity .25s, transform .35s var(--spring); transform: translateX(-50%) translateY(16px); }
.toast.show { transform: translateX(-50%) translateY(0); }

/* tombol */
.fab { transition: transform .25s var(--spring), box-shadow .25s; animation: fabIn .5s var(--spring) .15s both; }
@keyframes fabIn { from { transform: scale(0) rotate(-90deg); } }
.fab:hover { transform: scale(1.07); }
.fab:active { transform: scale(.92); }
.fab svg { transition: transform .45s cubic-bezier(.34,1.56,.64,1); }
.fab.open svg { transform: rotate(135deg); }
.fab.open { box-shadow: 0 6px 20px rgba(0,0,0,.22); }
.btn, .ib, .tool, .chip-opt, .sw, .pcolor { transition: transform .2s var(--spring), background-color .2s, box-shadow .2s; }
.btn:active, .ib:active, .tool:active, .chip-opt:active, .sw:active, .pcolor:active { transform: scale(.9); }
.tool.on svg { animation: toolPop .35s var(--spring); }
@keyframes toolPop { 50% { transform: scale(1.25) rotate(-8deg); } }

/* kartu buku catatan */
.ngrid .nb { animation: cardIn .45s var(--ease) both; animation-delay: calc(var(--i, 0) * 35ms); }
@keyframes cardIn { from { opacity: 0; transform: translateY(18px) scale(.95); } }
.nb .cover, .newcard { transition: transform .3s var(--spring), box-shadow .3s; }
.nb .cover-box:hover .cover { transform: translateY(-4px) rotate(-1deg); box-shadow: 0 4px 8px rgba(0,0,0,.12), 0 18px 30px rgba(0,0,0,.16); }
.nb .cover-box:active .cover { transform: scale(.96); }
.newcard:hover { transform: scale(1.03); border-color: var(--note); }
.bookfx { position: fixed; inset: 0; z-index: 45; pointer-events: none; perspective: 1800px; background: radial-gradient(circle at 50% 50%, rgba(0,0,0,.18), rgba(0,0,0,.32)); animation: fadeIn .3s both; }
.bf-book { position: absolute; transform-style: preserve-3d; will-change: transform; }
.bf-pages { position: absolute; inset: 0; background: #fff; border-radius: 2px 6px 6px 2px; overflow: hidden; transform-origin: center;
  box-shadow: 2px 0 0 #f1efe9, 4px 0 0 #e6e3dc, 6px 1px 0 #f1efe9, 8px 2px 0 #dcd8cf, 0 18px 40px rgba(0,0,0,.28); }
.bf-paper, .bf-paper canvas { width: 100%; height: 100%; display: block; object-fit: cover; object-position: top; }
.bf-pages::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,.14), transparent 9%); }
.bf-cover { position: absolute; inset: 0; transform-origin: left center; transform-style: preserve-3d; will-change: transform; }
.bf-front, .bf-back { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
.bf-front .cover { width: 100%; height: 100%; }
.bf-front .cover .label { font-size: clamp(13px, 2.4vh, 22px); }
.bf-back { transform: rotateY(180deg); border-radius: 6px 2px 2px 6px; background: var(--c, #ffd93b); box-shadow: 0 18px 40px rgba(0,0,0,.25); }
.bf-back::after { content: ""; position: absolute; inset: 6px 6px 6px 8px; border-radius: 3px; background: #fbf8f2; box-shadow: inset -10px 0 18px rgba(0,0,0,.12); }

/* editor */
.editor.open { animation: edIn .3s var(--ease); }
@keyframes edIn { from { opacity: 0; } }
.page { animation: pageIn .45s var(--ease) both; }
@keyframes pageIn { from { opacity: 0; transform: translateY(24px); } }

@media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }

/* ================= Responsive (HP) ================= */
@media (max-width: 760px) {
  .app { flex-direction: column-reverse; }
  .rail { width: 100%; height: calc(60px + var(--sab)); flex-direction: row; gap: 0; border-top: 1px solid var(--line); justify-content: space-around; }
  .rail button { flex: 1; font-size: 11px; gap: 2px; }
  .rail button svg { width: 24px; height: 24px; }
  .rail button.active::before { left: 30%; right: 30%; top: 0; bottom: auto; width: auto; height: 3px; border-radius: 0 0 3px 3px; }
  .view { padding-bottom: 0; }
  .topbar { height: 60px; padding: 0 8px 0 12px; gap: 4px; }
  .topbar .title { font-size: 20px; }
  .weekdays { height: 32px; font-size: 12px; }
  .cell .num { font-size: 14px; padding: 3px 5px; }
  .ev { font-size: 9px; padding: 0 3px; border-radius: 3px; }
  .evs { padding: 2px; gap: 1px; }
  .dots { padding: 2px 5px; }
  .dots i { width: 5px; height: 5px; }
  .fab { right: 18px; bottom: 18px; width: 58px; height: 58px; }
  .pad { padding: 14px 14px 110px; }
  .nside { display: none; }
  .ngrid { grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 20px 14px; padding: 12px 14px 110px; }
  .nb .name { font-size: 13px; }
  .cover .label { font-size: 10px; }
  .mchips { display: flex !important; }
  .toast { bottom: calc(90px + var(--sab)); }
  .dh-date b { font-size: 28px; }
  .dh-date span { font-size: 12px; }
  .dayhead { gap: 4px; padding: 6px 8px; flex-wrap: wrap; }
  .dh-evs { order: 5; flex-basis: 100%; padding: 4px 0 0; }
  .cell .has-note svg { width: 10px; height: 10px; }
  .etitle { max-width: 120px; }
}
.mchips { display: none; gap: 8px; padding: 10px 14px 0; overflow-x: auto; flex: none; scrollbar-width: none; }
.mchips .chip-opt { white-space: nowrap; }
.mchips .chip-opt.on { border-color: var(--note); background: color-mix(in srgb, var(--note) 30%, var(--card)); }

/* Scrollbar: tanpa batang kiri-kanan, batang atas-bawah tipis */
::-webkit-scrollbar { width: 5px; height: 0; background: transparent; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: rgba(120,120,130,.35); border-radius: 99px; }
::-webkit-scrollbar-thumb:hover { background: rgba(120,120,130,.55); }
::-webkit-scrollbar-button, ::-webkit-scrollbar-corner { display: none; }
.stk-grid, .cv-motifs, .font-list, .sheet, .rn-body { overflow-x: hidden; }
.icon-btn { display: inline-flex; align-items: center; gap: 6px; }
.icon-btn svg { width: 1.25em; height: 1.25em; flex: none; }
.stk-x svg { width: 12px; height: 12px; stroke-width: 3; }

/* Pratinjau foto catatan */
.pv { position: fixed; inset: 0; z-index: 80; background: #101014; display: flex; flex-direction: column; color: #fff; animation: pvFade .38s cubic-bezier(.22,1,.36,1) both; padding-top: var(--sat, 0px); padding-bottom: var(--sab, 0px); }
.pv.out { animation: pvOut .28s cubic-bezier(.4,0,.2,1) forwards; pointer-events: none; }
@keyframes pvFade { from { opacity: 0; } }
@keyframes pvOut { to { opacity: 0; } }
.pv-top { display: flex; align-items: center; gap: 8px; padding: 12px 14px; }
.pv-title { flex: 1; min-width: 0; font-weight: 600; font-size: 16px; line-height: 1.25; }
.pv-title small { display: block; font-weight: 400; font-size: 12.5px; opacity: .65; }
.pv-btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 999px; background: rgba(255,255,255,.12); color: #fff; font-size: 14px; }
.pv-btn svg { width: 18px; height: 18px; }
.pv-btn.round { padding: 8px; }
.pv-btn:active { background: rgba(255,255,255,.22); }
@keyframes pvIn { from { opacity: 0; transform: scale(.94); } }
.pv-stage { flex: 1; min-height: 0; position: relative; overflow: hidden; touch-action: none; display: grid; place-items: center; }
.pv-deck { display: grid; place-items: center; }
.pv-card { grid-area: 1 / 1; background: #fff; padding: 12px 12px 14px; border-radius: 3px; box-shadow: 0 2px 4px rgba(0,0,0,.25), 0 14px 34px rgba(0,0,0,.45); cursor: pointer; will-change: transform; user-select: none; }
.pv-card img { display: block; object-fit: cover; background: #1d1d20; pointer-events: none; -webkit-user-drag: none; }
.pv-hint { text-align: center; font-size: 12.5px; opacity: .55; padding: 10px 16px 20px; min-height: 16px; }
@media (max-width: 600px) { .pv-btn span { display: none; } .pv-btn { padding: 8px; } .pv-card { padding: 8px 8px 10px; } }

.rot-chip { display: inline-flex; align-items: center; gap: 5px; font-variant-numeric: tabular-nums; animation: popIn .25s cubic-bezier(.22,1,.36,1); }
.rot-chip[hidden] { display: none; }
.rot-chip svg { width: 16px; height: 16px; }

/* Logo di layar Saya */
.brand { display: flex; justify-content: center; padding: 4px 0 8px; }
.brand img { height: 64px; animation: brandIn .7s cubic-bezier(.22,1,.36,1) both; }
@keyframes brandIn { from { opacity: 0; transform: translateY(8px) scale(.94); } }
.inp-time { border: 1px solid var(--line); border-radius: 8px; padding: 2px 6px; font: inherit; font-size: 13px; background: var(--card); color: var(--ink); margin-left: 4px; }

/* Banner notifikasi di dalam aplikasi */
.nbanner { position: fixed; top: calc(10px + var(--sat, 0px)); left: 50%; translate: -50% 0; z-index: 900; width: min(420px, calc(100% - 20px)); display: flex; gap: 12px; align-items: center; padding: 12px 14px; border-radius: 20px; background: color-mix(in srgb, var(--card) 88%, transparent); backdrop-filter: blur(18px) saturate(1.4); -webkit-backdrop-filter: blur(18px) saturate(1.4); box-shadow: 0 10px 34px rgba(0,0,0,.18), 0 0 0 1px rgba(0,0,0,.05); cursor: pointer; animation: nbIn .5s cubic-bezier(.22,1,.36,1) both; }
.nbanner.out { animation: nbOut .3s cubic-bezier(.4,0,1,1) forwards; }
@keyframes nbIn { from { opacity: 0; transform: translateY(-120%) scale(.96); } }
@keyframes nbOut { to { opacity: 0; transform: translateY(-120%) scale(.96); } }
.nbanner img { width: 40px; height: 40px; flex: none; padding: 6px; border-radius: 12px; background: #ffe4e9; box-sizing: border-box; }
.nb-txt { min-width: 0; flex: 1; }
.nb-head { display: flex; justify-content: space-between; font-size: 12px; color: var(--soft); }
.nb-head b { color: #e0001b; font-weight: 700; letter-spacing: .2px; }
.nb-title { font-weight: 650; font-size: 15px; margin-top: 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.nb-body { font-size: 13.5px; color: var(--soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* Kunci PIN */
.lock-badge { position: absolute; right: 8%; bottom: 8%; width: 30px; height: 30px; border-radius: 50%; background: rgba(20,20,24,.72); color: #fff; display: grid; place-items: center; backdrop-filter: blur(4px); box-shadow: 0 2px 6px rgba(0,0,0,.25); pointer-events: none; }
.lock-badge svg { width: 16px; height: 16px; stroke-width: 2; }
.nb .cover-box { position: relative; }
.pin { text-align: center; padding: 6px 0 2px; }
.pin-lock { width: 52px; height: 52px; margin: 0 auto 8px; border-radius: 16px; background: #ffe4e9; color: #e0001b; display: grid; place-items: center; }
.pin-lock svg { width: 26px; height: 26px; stroke-width: 2; }
.pin h3 { margin: 0; }
.pin-sub { color: var(--soft); font-size: 14px; margin: 4px 0 18px; min-height: 18px; }
.pin-dots { display: flex; justify-content: center; gap: 16px; }
.pin-dots i { width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--line); transition: background .15s, border-color .15s, transform .2s cubic-bezier(.34,1.56,.64,1); }
.pin-dots i.on { background: #e0001b; border-color: #e0001b; transform: scale(1.12); }
.pin-dots.ok i { background: #16a34a; border-color: #16a34a; }
.pin-dots.shake { animation: pinShake .38s cubic-bezier(.36,.07,.19,.97); }
@keyframes pinShake { 15%, 55% { transform: translateX(-9px); } 35%, 75% { transform: translateX(9px); } 90% { transform: translateX(-3px); } }
.pin-msg { color: var(--danger); font-size: 13px; min-height: 20px; margin: 10px 0 6px; }
.pin-pad { display: grid; grid-template-columns: repeat(3, 72px); gap: 12px 22px; justify-content: center; margin-top: 4px; }
.pin-pad button { width: 72px; height: 72px; border-radius: 50%; background: var(--rail); font-size: 26px; font-weight: 500; color: var(--ink); display: grid; place-items: center; transition: transform .12s, background .12s; }
.pin-pad button:active { transform: scale(.92); background: var(--line); }
.pin-pad .pin-txt { background: none; font-size: 15px; color: var(--soft); }
.pin-pad .pin-txt svg { width: 26px; height: 26px; }

/* Peringatan "belum disimpan" di atas lembar */
.mconf { position: fixed; inset: 0; z-index: 120; background: rgba(0,0,0,.32); display: grid; place-items: center; padding: 20px; animation: fadeIn .2s both; }
.mconf.out { animation: pvOut .2s forwards; }
.mconf-card { background: var(--card); border-radius: 18px; padding: 20px; width: min(360px, 100%); box-shadow: 0 16px 50px rgba(0,0,0,.28); animation: popIn .32s cubic-bezier(.22,1,.36,1) both; }
.mconf-card h3 { margin: 0 0 6px; }
.mconf-card p { margin: 0 0 16px; color: var(--soft); line-height: 1.5; }
.mconf-act { display: flex; flex-direction: column; gap: 8px; }
.mconf-act .btn { width: 100%; justify-content: center; }
.btn.danger-ghost { background: transparent; color: var(--danger); border: 1px solid color-mix(in srgb, var(--danger) 35%, transparent); }

/* ===== Balik halaman realistis (mode buku 2 halaman) ===== */
.bflip { position: fixed; z-index: 44; overflow: hidden; perspective: 2600px; pointer-events: none; }
.bflip.done { opacity: 0; transition: opacity .08s linear; }
.bf-book { position: absolute; transform-style: preserve-3d; }
.bf-book.mirror { transform: scaleX(-1); }
.bf-base { position: absolute; top: 0; overflow: hidden; background: #fff; }
.bf-base.l { border-radius: 6px 1px 1px 6px; box-shadow: -8px 8px 24px rgba(0,0,0,.16); }
.bf-base.r { border-radius: 1px 6px 6px 1px; box-shadow: 8px 8px 24px rgba(0,0,0,.16); }
.bf-base.empty { background: transparent; box-shadow: none; }
.bf-base canvas, .bf-face canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
/* lipatan di tengah buku */
.bf-base.l::after, .bf-base.r::after { content: ""; position: absolute; top: 0; bottom: 0; width: 36px; pointer-events: none; }
.bf-base.l::after { right: 0; background: linear-gradient(90deg, transparent 60%, rgba(0,0,0,.06) 80%, rgba(0,0,0,.24)); }
.bf-base.r::after { left: 0; background: linear-gradient(90deg, rgba(0,0,0,.24), rgba(0,0,0,.06) 20%, transparent 40%); }
/* bayangan lembar yang sedang dibalik */
.bf-shade { position: absolute; inset: 0; pointer-events: none; opacity: 0; }
.bf-base.r .bf-shade { background: linear-gradient(90deg, rgba(0,0,0,.55), rgba(0,0,0,.18) 35%, transparent 80%); }
.bf-base.l .bf-shade { background: linear-gradient(270deg, rgba(0,0,0,.5), rgba(0,0,0,.15) 40%, transparent 85%); }
.bf-strip { position: absolute; top: 0; transform-style: preserve-3d; transform-origin: 0 50%; will-change: transform; }
.bf-face { position: absolute; top: 0; left: 0; width: calc(100% + 1px); height: 100%; backface-visibility: hidden; -webkit-backface-visibility: hidden; overflow: hidden; background: #fff; }
.bf-face.back { transform: rotateY(180deg); }
.bf-face.empty { background: transparent; }
/* cahaya: sisi depan menggelap saat terangkat, sisi belakang sedikit teduh */
.bf-light { position: absolute; inset: 0; pointer-events: none; opacity: 0; }
.bf-face.front .bf-light { background: linear-gradient(90deg, rgba(0,0,0,.35), rgba(0,0,0,.08) 60%, rgba(255,255,255,.05)); }
.bf-face.back .bf-light { background: linear-gradient(270deg, rgba(0,0,0,.3), rgba(0,0,0,.05) 70%); }


/* Format teks di toolbar alat T */
.tf-sep { width: 1px; height: 22px; background: var(--line); margin: 0 4px; flex: none; }
.tfbtn { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; font-size: 16px; color: var(--ink); flex: none; transition: background .15s, transform .15s; }
.tfbtn svg { width: 18px; height: 18px; }
.tfbtn.on { background: var(--note); color: var(--note-ink); }
.tfbtn:active { transform: scale(.9); }
.tf-hl { padding: 0 3px; border-radius: 3px; font-size: 14px; box-shadow: inset 0 0 0 1px rgba(0,0,0,.12); }

/* Popup foto kotak tanggal */
.cp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 12px; margin: 14px 0 4px; min-height: 120px; max-height: 52vh; overflow-y: auto; padding: 4px; }
.cp-item { position: relative; background: #fff; padding: 6px 6px 8px; border-radius: 3px; box-shadow: 0 2px 6px rgba(0,0,0,.14); transform: rotate(calc((var(--i) * 37 % 7 - 3) * 1deg)); animation: popIn .35s cubic-bezier(.22,1,.36,1) both; }
.cp-item img { width: 100%; aspect-ratio: 1; object-fit: cover; display: block; cursor: zoom-in; }
.cp-del { position: absolute; top: -8px; right: -8px; width: 24px; height: 24px; border-radius: 50%; background: var(--danger); color: #fff; display: grid; place-items: center; box-shadow: 0 2px 5px rgba(0,0,0,.2); }
.cp-del svg { width: 13px; height: 13px; stroke-width: 2.6; }
.cp-empty { grid-column: 1 / -1; text-align: center; color: var(--soft); padding: 30px 10px; line-height: 1.6; }
#cp-cam, #cp-gal { display: inline-flex; align-items: center; gap: 6px; }
#cp-cam svg, #cp-gal svg { width: 18px; height: 18px; }

/* Slider & Kontrol Ukuran Kuas */

.size-pill {
  display: flex;
  align-items: center;
  gap: 6px;
  background: var(--rail, rgba(0,0,0,.05));
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 4px 10px;
  font-size: 13px;
  font-weight: 500;
  color: var(--text);
  cursor: pointer;
  flex: none;
  transition: background .15s, transform .15s;
}
.size-pill:hover, .size-pill:active {
  background: var(--line);
}
.size-pill-dot {
  width: 18px;
  height: 18px;
  display: grid;
  place-items: center;
}
.size-pill-dot i {
  display: block;
  border-radius: 50%;
  border: 1px solid rgba(0,0,0,.15);
}
.size-pill-num {
  font-variant-numeric: tabular-nums;
  font-size: 12px;
}
.size-pill-caret {
  font-size: 9px;
  opacity: 0.6;
}

.bsize { display: flex; align-items: center; gap: 6px; padding: 0 4px; flex: none; }
.bsize-inline { display: flex; align-items: center; }
@media (max-width: 600px) {
  .bsize-inline { display: none; }
}

.bsize-dot { width: 28px; height: 28px; display: grid; place-items: center; flex: none; }
.bsize-dot i { display: block; border-radius: 50%; border: 1px solid rgba(0,0,0,.25); transition: width .08s, height .08s; }
.bsize input[type=range] { -webkit-appearance: none; appearance: none; width: 100px; height: 28px; background: transparent; touch-action: none; }
.bsize input[type=range]::-webkit-slider-runnable-track { height: 6px; border-radius: 3px; background: linear-gradient(90deg, var(--note, #ffd93b) var(--p, 50%), var(--line) var(--p, 50%)); }
.bsize input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 20px; height: 20px; margin-top: -7px; border-radius: 50%; background: #fff; box-shadow: 0 1px 4px rgba(0,0,0,.35); }
.bsize-val { min-width: 26px; font-size: 12px; color: var(--soft); font-variant-numeric: tabular-nums; }

/* Modal Pengatur Ukuran Kuas Kustom */
.bsize-sheet {
  padding: 6px 4px 10px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.bsize-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.bsize-title {
  font-size: 16px;
  font-weight: 600;
  color: var(--text);
}
.bsize-curr-val {
  font-size: 16px;
  font-weight: 700;
  color: var(--text);
  font-variant-numeric: tabular-nums;
  background: var(--rail);
  padding: 3px 10px;
  border-radius: 8px;
}
.bsize-preview-box {
  width: 100%;
  height: 96px;
  background: var(--rail, rgba(0,0,0,.03));
  border-radius: 14px;
  border: 1px dashed var(--line);
  display: grid;
  place-items: center;
  overflow: hidden;
}
.bsize-preview-circle {
  border-radius: 50%;
  border: 1px solid rgba(0,0,0,.2);
  transition: width .06s, height .06s;
}
.bsize-slider-row {
  display: flex;
  align-items: center;
  gap: 12px;
}
.bsize-minmax {
  font-size: 12px;
  color: var(--muted);
  min-width: 22px;
  text-align: center;
}
.bsize-range-lg {
  flex: 1;
  -webkit-appearance: none;
  appearance: none;
  height: 36px;
  background: transparent;
  touch-action: none;
}
.bsize-range-lg::-webkit-slider-runnable-track {
  height: 8px;
  border-radius: 4px;
  background: linear-gradient(90deg, var(--note, #ffd93b) var(--p, 50%), var(--line) var(--p, 50%));
}
.bsize-range-lg::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 24px;
  height: 24px;
  margin-top: -8px;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2px 8px rgba(0,0,0,.35);
  border: 2px solid var(--line);
}
.bsize-presets {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  justify-content: center;
  padding-top: 4px;
}

/* Ukuran teks: − angka + */
.tsize { display: flex; align-items: stretch; height: 36px; border-radius: 10px; background: var(--rail); border: 1px solid var(--line); overflow: hidden; flex: none; margin: 0 2px; }
.tsize-btn { width: 32px; font-size: 20px; line-height: 1; color: var(--text); display: grid; place-items: center; touch-action: manipulation; user-select: none; -webkit-user-select: none; }
.tsize-btn:active { background: var(--line); }
.tsize-num { width: 46px; min-width: 0; padding: 0 2px; margin: 0; border: 0; border-left: 1px solid var(--line); border-right: 1px solid var(--line); border-radius: 0; background: transparent; font: inherit; font-size: 14px; font-weight: 600; font-variant-numeric: tabular-nums; text-align: center; color: var(--text); outline: none; -webkit-appearance: none; appearance: none; }
.tsize-num:focus { background: var(--card); box-shadow: inset 0 0 0 2px var(--cal, #2f80ed); }

/* Panel Stabilo */
.hl-sheet { gap: 12px; }
.hl-stage { position: relative; height: 176px; border-radius: 14px; background: var(--rail); border: 1px dashed var(--line); overflow: hidden; }
.hl-prev { position: absolute; left: 0; right: 0; top: 0; width: 100%; height: 72px; }
.hl-tips { position: absolute; left: 0; right: 0; bottom: 0; display: flex; justify-content: center; gap: 28px; }
.hl-tip { display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 6px 14px 8px; border-radius: 12px 12px 0 0; color: var(--soft); font-size: 12px; opacity: .75; transform: translateY(8px); transition: transform .25s var(--spring, ease), color .2s, background-color .2s, opacity .2s; }
.hl-tip svg { width: 40px; height: 76px; }
.hl-tip .mk-tip, .hl-tip .mk-band { fill: var(--mk, #ffe14d); }
.hl-tip .mk-body { fill: var(--card, #fff); stroke: var(--line); stroke-width: 1.5; }
.hl-tip.on { opacity: 1; transform: translateY(0); color: var(--text); font-weight: 600; background: color-mix(in srgb, var(--card) 70%, transparent); }
.hl-label { font-size: 13px; font-weight: 600; color: var(--soft); margin-bottom: -4px; }
.hl-switch { display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 14px; color: var(--text); cursor: pointer; }
.hl-switch small { display: block; font-size: 12px; color: var(--soft); margin-top: 2px; }
.hl-switch input { position: absolute; opacity: 0; pointer-events: none; }
.hl-switch i { flex: none; width: 44px; height: 26px; border-radius: 13px; background: var(--line); position: relative; transition: background-color .2s; }
.hl-switch i::after { content: ''; position: absolute; left: 3px; top: 3px; width: 20px; height: 20px; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.3); transition: transform .2s var(--spring, ease); }
.hl-switch input:checked + i { background: var(--cal, #2f80ed); }
.hl-switch input:checked + i::after { transform: translateX(18px); }
.hl-switch input:focus-visible + i { outline: 2px solid var(--cal, #2f80ed); outline-offset: 2px; }
.hl-inks, .hl-colors { display: flex; gap: 8px; flex-wrap: wrap; }
.hl-colors .pcolor { width: 32px; height: 32px; }

/* Atur urutan toolbar */
.tbs .tbs-hint { font-size: 13px; margin: -8px 0 12px; }
.tbs-list { display: flex; flex-direction: column; gap: 4px; margin-bottom: 16px; }
.tbs-row { display: flex; align-items: center; gap: 12px; height: 44px; padding: 0 4px 0 12px; border-radius: 12px; background: var(--rail); color: var(--text); transition: box-shadow .15s, transform .15s; }
.tbs-row.is-sep { height: 34px; background: transparent; border: 1px dashed var(--line); color: var(--soft); }
.tbs-row.dragging { position: relative; z-index: 2; background: var(--card); box-shadow: 0 6px 18px rgba(0,0,0,.18); transform: scale(1.02); }
.tbs-row.locked { background: transparent; border: 1px solid var(--line); color: var(--soft); }
.tbs-ic { width: 24px; height: 24px; display: grid; place-items: center; flex: none; }
.tbs-ic svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.tbs-name { flex: 1; font-size: 15px; }
.tbs-grip, .tbs-lock { width: 40px; height: 40px; display: grid; place-items: center; flex: none; color: var(--soft); }
.tbs-grip { cursor: grab; touch-action: none; border-radius: 10px; }
.tbs-grip:active { cursor: grabbing; background: var(--line); }
.tbs-grip svg { width: 20px; height: 20px; }
.tbs-lock svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; }

/* Tombol salin di kotak seleksi teks */
.tb-copy { position: absolute; left: -16px; top: -40px; width: 28px; height: 28px; border-radius: 50%; background: #fff; color: var(--ink, #222); display: grid; place-items: center; box-shadow: 0 2px 6px rgba(0,0,0,.3); }
.tb-copy svg { width: 16px; height: 16px; }

/* Penjelasan Scribble untuk pengguna baru */
.scr-intro h3 { margin: 14px 0 6px; }
.scr-intro p { color: var(--soft); line-height: 1.55; margin: 0 0 10px; }
.scr-demo { display: flex; align-items: center; justify-content: center; gap: 14px; padding: 18px; border-radius: 16px; background: var(--rail); }
.scr-ink { display: inline-flex; align-items: center; gap: 6px; font: 26px/1 'Shadows Into Light', cursive; color: #444; }
.scr-ink svg { width: 22px; height: 22px; color: var(--soft); }
.scr-arrow { color: var(--soft); font-size: 20px; animation: scrNudge 1.4s ease-in-out infinite; }
@keyframes scrNudge { 50% { transform: translateX(4px); } }
.scr-text { font: 600 22px/1 'Fredoka', sans-serif; padding: 4px 10px; border-radius: 8px; background: var(--card); box-shadow: 0 1px 3px rgba(0,0,0,.1); }
.scr-facts { margin: 6px 0 14px; padding-left: 18px; line-height: 1.6; font-size: 14px; }
.scr-note { font-size: 14px; }
.scr-state { display: flex; flex-direction: column; gap: 10px; padding: 12px 14px; border-radius: 12px; background: var(--rail); font-size: 14px; margin-bottom: 8px; }
.scr-state.ok { background: color-mix(in srgb, #16a34a 14%, var(--card)); color: #157a3a; }
.scr-state.err { background: color-mix(in srgb, var(--danger) 12%, var(--card)); color: var(--danger); }
.scr-bar { height: 6px; border-radius: 3px; background: var(--line); overflow: hidden; }
.scr-bar i { display: block; height: 100%; width: 35%; border-radius: 3px; background: var(--note, #ffd93b); animation: scrBar 1.2s ease-in-out infinite; }
@keyframes scrBar { from { transform: translateX(-100%); } to { transform: translateX(300%); } }
.scr-state[hidden], #scr-act[hidden] { display: none; }

.find-bar { position: absolute; top: 62px; left: 50%; transform: translateX(-50%); z-index: 46; display: flex; align-items: center; gap: 4px; background: var(--card, #fff); border-radius: 14px; box-shadow: 0 6px 22px rgba(0,0,0,.18); padding: 6px 6px 6px 12px; width: min(460px, calc(100% - 32px)); }
.find-bar input { flex: 1; min-width: 0; border: none; outline: none; background: transparent; font: inherit; color: inherit; padding: 6px 0; }
.find-n { font-size: 12px; opacity: .65; min-width: 34px; text-align: center; }
.find-bar button { width: 32px; height: 32px; border: none; border-radius: 9px; background: transparent; color: inherit; font-size: 20px; display: grid; place-items: center; cursor: pointer; }
.find-bar button:hover { background: rgba(0,0,0,.06); }
.find-bar button svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 2; }
.find-hl { position: absolute; background: rgba(255, 214, 0, .38); border-radius: 2px; pointer-events: none; z-index: 3; mix-blend-mode: multiply; }
.find-hl.on { background: rgba(255, 140, 0, .55); outline: 2px solid #ff8c00; }

/* baris pilihan alat (pena / penghapus / bentuk) di bawah toolbar */
.esub { flex: none; display: flex; gap: 6px; padding: 0 12px; background: var(--card); border-bottom: 1px solid transparent; overflow-x: auto; scrollbar-width: none; max-height: 0; opacity: 0; transition: max-height .28s cubic-bezier(.2,.8,.2,1), opacity .2s, padding .28s, border-color .2s; }
.esub::-webkit-scrollbar { display: none; }
.esub.open { max-height: 64px; opacity: 1; padding: 7px 12px; border-bottom-color: var(--line); }
.subopt { flex: none; display: flex; align-items: center; gap: 7px; height: 38px; padding: 0 14px 0 10px; border-radius: 999px; border: 1px solid var(--line); background: transparent; color: var(--soft); font: inherit; font-size: 13.5px; cursor: pointer; transition: background .18s, color .18s, transform .18s, border-color .18s; }
.subopt svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.subopt:active { transform: scale(.95); }
.subopt.on { background: color-mix(in srgb, var(--note) 45%, transparent); border-color: color-mix(in srgb, var(--note) 80%, transparent); color: var(--text); font-weight: 600; }
.esub.open .subopt { animation: subIn .3s both; }
.esub.open .subopt:nth-child(2) { animation-delay: .03s; } .esub.open .subopt:nth-child(3) { animation-delay: .06s; } .esub.open .subopt:nth-child(4) { animation-delay: .09s; } .esub.open .subopt:nth-child(5) { animation-delay: .12s; }
@keyframes subIn { from { opacity: 0; transform: translateY(-6px); } }
/* tanda kecil: alat ini punya pilihan */
.tool.has-opt::after { content: ""; position: absolute; right: 4px; bottom: 4px; width: 5px; height: 5px; background: currentColor; clip-path: polygon(100% 0, 100% 100%, 0 100%); opacity: .45; pointer-events: none; transition: opacity .2s; }
.tool.has-opt.opt-open::after { opacity: .9; }

/* tutup halus ala iOS: salinan popup memudar, mengecil sedikit, tanpa pantulan */
.fx-ghost { pointer-events: none !important; }
.scrim.fx-ghost.closing { display: flex; animation: fadeOut .26s var(--ios) forwards; }
.scrim.fx-ghost.closing .sheet { animation: sheetOut .26s var(--ios) forwards; }
.popover.fx-ghost.closing { display: block; animation: popOut .2s var(--ios) forwards; transform-origin: top right; }
@keyframes fadeOut { to { opacity: 0; } }
@keyframes sheetOut { to { opacity: 0; transform: translateY(14px) scale(.975); } }
@keyframes popOut { to { opacity: 0; transform: scale(.94); } }
.sheet, .popover { will-change: transform, opacity; }
.popover { backdrop-filter: saturate(1.6) blur(18px); -webkit-backdrop-filter: saturate(1.6) blur(18px); background: color-mix(in srgb, var(--card) 88%, transparent); border-radius: 14px; }
.tool.on svg { animation: none; }
@media (prefers-reduced-motion: reduce) { .scrim.open .sheet, .popover.open { animation: fadeIn .15s; } }

/* baris pilihan alat: kontrol bersegmen dengan sorotan yang meluncur (ala iOS) */
.esub { background: color-mix(in srgb, var(--card) 92%, transparent); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); justify-content: center; }
.esub.open { padding: 8px 12px; }
.seg { position: relative; display: inline-flex; gap: 2px; padding: 3px; border-radius: 13px; background: color-mix(in srgb, var(--text) 7%, transparent); flex: none; margin: 0 auto; }
.seg-thumb { position: absolute; top: 3px; bottom: 3px; left: 0; border-radius: 10px; background: var(--card); box-shadow: 0 1px 2px rgba(0,0,0,.08), 0 3px 10px rgba(0,0,0,.10); transition: transform .42s var(--ios), width .42s var(--ios); pointer-events: none; }
.esub .subopt { position: relative; z-index: 1; height: 34px; border: none; border-radius: 10px; background: transparent !important; padding: 0 14px 0 11px; font-size: 13.5px; color: var(--soft); animation: none !important; transition: color .25s var(--ios), transform .2s var(--ios); }
.esub .subopt.on { color: var(--text); font-weight: 600; }
.esub .subopt.on svg { color: var(--accent, #e5484d); }
.esub .subopt:active { transform: scale(.96); }

/* baris pilihan melayang di atas buku: membuka/menutup tidak membuat buku mengecil */
.esub { position: absolute; top: 0; left: 0; right: 0; z-index: 6; box-shadow: 0 6px 16px rgba(0,0,0,.06); }
.esub:not(.open) { box-shadow: none; pointer-events: none; }

/* pengaturan diperbarui di tempat: tanpa animasi masuk ulang */
.still, .still * { animation: none !important; }

/* ---------- Pemilih warna Cherry ---------- */
.cpk { position: fixed; z-index: 90; width: min(300px, calc(100vw - 20px)); background: var(--card); color: var(--text); border-radius: 18px; padding: 6px 14px 14px; box-shadow: 0 12px 40px rgba(0,0,0,.22), 0 0 0 1px var(--line); opacity: 0; transform: scale(.94); transition: opacity .28s cubic-bezier(.32,.72,0,1), transform .34s cubic-bezier(.32,.72,0,1); touch-action: none; }
.cpk.in { opacity: 1; transform: none; }
.cpk.out { opacity: 0; transform: scale(.95); transition-duration: .2s; pointer-events: none; }
.cpk.peek { opacity: .12; pointer-events: none; }
.cpk-tabs { position: relative; display: flex; justify-content: center; gap: 22px; border-bottom: 1px solid var(--line); margin: 0 -2px 12px; }
.cpk-tabs button { padding: 12px 2px 10px; font: inherit; font-size: 14px; color: var(--soft); background: none; border: none; transition: color .25s; }
.cpk-tabs button.on { color: #2f86d6; font-weight: 600; }
.cpk-ink { position: absolute; bottom: -1px; height: 2px; border-radius: 2px; background: #2f86d6; transition: left .35s cubic-bezier(.32,.72,0,1), width .35s cubic-bezier(.32,.72,0,1); }
.cpk-sv { position: relative; height: 170px; border-radius: 12px; cursor: crosshair; }
.cpk-svk { position: absolute; width: 16px; height: 16px; margin: -8px 0 0 -8px; border-radius: 5px; border: 2px solid #fff; box-shadow: 0 0 0 1px rgba(0,0,0,.25), 0 2px 6px rgba(0,0,0,.25); pointer-events: none; }
.cpk-row { display: flex; align-items: center; gap: 10px; margin-top: 12px; }
.cpk-drop { width: 32px; height: 32px; border-radius: 9px; border: none; background: transparent; color: var(--text); display: grid; place-items: center; flex: none; }
.cpk-drop svg, .cpk-save svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.cpk-sliders { flex: 1; display: flex; flex-direction: column; gap: 12px; }
.cpk-hue, .cpk-alpha { position: relative; height: 8px; border-radius: 99px; cursor: pointer; }
.cpk-hue { background: linear-gradient(to right, #f00, #ff0, #0f0, #0ff, #00f, #f0f, #f00); }
.cpk-alpha { background: repeating-conic-gradient(#ddd 0 25%, #fff 0 50%) 0 0 / 8px 8px; }
.cpk-alpha b { position: absolute; inset: 0; border-radius: inherit; }
.cpk-hue i, .cpk-alpha i { position: absolute; top: 50%; width: 16px; height: 16px; margin: -8px 0 0 -8px; border-radius: 5px; border: 2px solid #fff; box-shadow: 0 0 0 1px rgba(0,0,0,.2), 0 2px 5px rgba(0,0,0,.25); pointer-events: none; }
.cpk-hue::after, .cpk-alpha::after { content: ""; position: absolute; inset: -10px 0; }
.cpk-io { gap: 8px; }
.cpk-lbl { font-size: 12px; color: var(--soft); width: 32px; flex: none; }
.cpk-field { flex: 1; min-width: 0; display: flex; border: 1px solid var(--line); border-radius: 11px; overflow: hidden; }
.cpk-field input { min-width: 0; border: none; outline: none; background: transparent; color: inherit; font: inherit; font-size: 14px; padding: 9px 10px; text-align: center; }
.cpk-hex { flex: 1.6; text-transform: uppercase; border-right: 1px solid var(--line) !important; }
.cpk-pct { flex: 1; }
.cpk-save { width: 76px; height: 38px; border: none; border-radius: 11px; display: grid; place-items: center; flex: none; transition: transform .2s cubic-bezier(.32,.72,0,1); }
.cpk-save:active { transform: scale(.94); }
.cpk-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 10px; margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--line); }
.cpk-set .cpk-grid { grid-template-columns: repeat(8, 1fr); gap: 7px; margin-top: 6px; padding-top: 0; border: none; }
.cpk-set { margin-bottom: 12px; }
.cpk-set span { font-size: 12px; color: var(--soft); }
