.pp-colors span { font-size: 13px; color: var(--soft); margin-right: 4px; }
.pp-col { width: 24px; height: 24px; border-radius: 50%; background: var(--c); border: 1px solid color-mix(in srgb, var(--text) 18%, transparent); transition: transform .25s var(--ios), box-shadow .25s var(--ios); }
.pp-col.on { box-shadow: 0 0 0 2px var(--card), 0 0 0 4px var(--note); transform: scale(1.06); }
.pp-cats { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; padding: 12px 0 6px; }
