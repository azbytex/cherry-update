.ddots { display: flex; gap: 2px; height: 5px; }
.ddots i { width: 5px; height: 5px; border-radius: 50%; }
.dday.on .ddots i { box-shadow: 0 0 0 1px #fff; }
.drows { display: flex; flex-direction: column; }
.drow { display: flex; align-items: center; gap: 12px; padding: 9px 6px; border-radius: 12px; width: 100%; text-align: left; color: var(--text); }
.drow:hover { background: var(--rail); }
.drow + .drow { border-top: 1px solid var(--line); border-radius: 0; }
.drow .grow { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; cursor: pointer; }
.drow-t { font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.drow-s { font-size: 12px; color: var(--muted); }
.drow-s.late { color: #d93a3a; font-weight: 500; }
.dbar { width: 4px; align-self: stretch; border-radius: 2px; flex: none; }
.dcheck { width: 24px; height: 24px; flex: none; border-radius: 8px; border: 2px solid var(--soft); display: grid; place-items: center; color: transparent; transition: background-color .2s, border-color .2s, color .2s, transform .2s var(--spring, ease); }
.dcheck svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
.dcheck:hover { border-color: #22a861; color: color-mix(in srgb, #22a861 50%, transparent); }
.dcheck.ticking { background: #22a861; border-color: #22a861; color: #fff; transform: scale(1.12); }
.dtask.p3 .dcheck { border-color: #e5484d; }
.dtask.p2 .dcheck { border-color: #f59e0b; }
.dnone { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; padding: 6px 4px 10px; color: var(--soft); font-size: 14px; }
.dnone .dchip { background: var(--rail); box-shadow: none; }

/* rak buku terakhir dibuka */
.dshelf { display: flex; flex-direction: column; gap: 14px; animation: dIn .5s ease .28s both; }
.dshelf-row { display: grid; grid-auto-flow: column; grid-auto-columns: 118px; gap: 18px; overflow-x: auto; padding: 4px 4px 18px; scrollbar-width: thin; border-bottom: 10px solid color-mix(in srgb, var(--line) 70%, transparent); border-radius: 0 0 6px 6px; }
.dshelf-nb { display: flex; flex-direction: column; gap: 8px; text-align: left; color: var(--text); }
.dshelf-nb .cover-box { display: block; aspect-ratio: 3/4; transition: transform .25s var(--spring, ease); }
.dshelf-nb:hover .cover-box { transform: translateY(-5px); }
.dshelf-nb .cover .label { font-size: 10px; }
.dshelf-n { font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.dside-h { font-size: 12px; font-weight: 600; color: var(--muted); padding: 16px 12px 4px; }
.dside .nitem:hover { background: var(--rail); }
.dside .nitem[data-act] { color: var(--soft); font-size: 15px; }
.dside .nitem[data-act] svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
.d-home { flex: none; }

@keyframes dIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
@keyframes dBob { 0%, 100% { transform: translateY(0) rotate(-3deg); } 50% { transform: translateY(-6px) rotate(3deg); } }
@media (prefers-reduced-motion: reduce) { .dhero, .dcard, .dpanel, .dshelf, .dhero-art { animation: none; } }
.dmain.quiet .dcard, .dmain.quiet .dpanel, .dmain.quiet .dshelf { animation: none; } /* render ulang diam-diam */
/* agenda: hari dipilih + petunjuk berdenyut 2 kali */
.dday.today:not(.on) { box-shadow: inset 0 0 0 2px var(--cal); }
/* panel Agenda & Tugas: susunan identik supaya simetris */
.dpanel header { min-height: 36px; }
.dadd { width: 36px; height: 36px; border-radius: 12px; display: grid; place-items: center; background: color-mix(in srgb, var(--cal) 12%, var(--card)); color: var(--cal); transition: transform .2s var(--spring, ease), background-color .2s; }
.dadd:hover { background: color-mix(in srgb, var(--cal) 20%, var(--card)); }
.dadd:active { transform: scale(.9); }
.dadd svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; }
.dtiles { display: grid; gap: 6px; }
.dstats { grid-template-columns: repeat(3, 1fr); }
.dstat { cursor: default; }
.dstat:active { transform: none; }
.dstat small { white-space: nowrap; }
.dstat.warn b { color: #d93a3a; }
.dsub { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 32px; font-size: 13px; font-weight: 600; color: var(--soft); padding: 0 2px; }
.dseg { display: inline-flex; padding: 3px; border-radius: 10px; background: var(--rail); }
.dseg button { height: 26px; padding: 0 12px; border-radius: 8px; font-size: 12.5px; font-weight: 500; color: var(--soft); transition: background-color .2s, color .2s; }
.dseg button.on { background: var(--card); color: var(--text); box-shadow: 0 1px 2px rgba(0,0,0,.08), 0 2px 6px rgba(0,0,0,.06); }
.dlistbox { display: flex; flex-direction: column; min-height: calc(3 * 56px); flex: 1; }
.dlistbox .drow { min-height: 56px; }
.dlistbox .dnone { flex: 1; justify-content: center; align-items: center; text-align: center; padding: 8px; }
.dmore { display: flex; align-items: center; justify-content: center; gap: 2px; height: 40px; margin: 0 -18px -12px; border-top: 1px solid var(--line); border-radius: 0 0 20px 20px; font-size: 13px; font-weight: 600; color: var(--cal); }
.dmore:hover { background: var(--rail); }
.dmore svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
.hint { animation: dReveal .28s cubic-bezier(.22, 1, .36, 1) calc(var(--ri, 0) * 35ms) both; }
@keyframes dReveal {
  from { opacity: .25; transform: translateY(6px); }
  to { opacity: 1; transform: none; }
}
.ev.done { opacity: .6; text-decoration: line-through; }

/* Modal Acara / Tugas bergaya Google Calendar */
.gcal-mhead { display: flex; flex-direction: column; gap: 10px; margin-bottom: 12px; }
.gcal-title-inp { width: 100%; border: none; border-bottom: 2px solid var(--cal); background: transparent; padding: 6px 2px 8px; font-size: 21px; font-weight: 500; color: var(--text); outline: none; }
.gcal-title-inp::placeholder { color: var(--muted); font-weight: 400; }
.gcal-tabs { display: flex; gap: 6px; }
.gcal-tab { padding: 6px 14px; border-radius: 10px; font-size: 13.5px; font-weight: 500; color: var(--soft); background: transparent; transition: background-color .2s, color .2s, transform .15s; }
.gcal-tab.on { background: color-mix(in srgb, var(--cal) 16%, var(--card)); color: var(--cal); font-weight: 600; }
.gcal-tab:active { transform: scale(.96); }
.gcal-ro-note { font-size: 12px; color: var(--soft); background: var(--rail); padding: 8px 11px; border-radius: 10px; margin-bottom: 8px; line-height: 1.4; }
.gcal-row { display: flex; align-items: flex-start; gap: 12px; padding: 10px 2px; border-top: 1px solid color-mix(in srgb, var(--line) 70%, transparent); }
.gcal-ic { width: 20px; height: 20px; flex: none; margin-top: 4px; fill: none; stroke: var(--soft); stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
.gcal-row-body { flex: 1; min-width: 0; }
.gcal-sum-line { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.gcal-sum-txt { font-size: 14px; color: var(--text); line-height: 1.35; }
.gcal-sum-txt small { display: block; font-size: 12px; color: var(--soft); }
.gcal-pill-btn { flex: none; padding: 6px 12px; border-radius: 999px; border: 1px solid var(--line); background: var(--card); color: var(--text); font-size: 13px; font-weight: 500; transition: border-color .2s, background-color .2s, transform .15s; }
.gcal-pill-btn.on { border-color: var(--cal); color: var(--cal); background: color-mix(in srgb, var(--cal) 10%, var(--card)); }
.gcal-pill-btn:active { transform: scale(.95); }
.gcal-time-opts { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin: 2px 0 6px; }
.gcal-chk { display: inline-flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--text); cursor: pointer; }
.gcal-chk input { width: 17px; height: 17px; accent-color: var(--cal); }
.gcal-sel { border: none; border-radius: 10px; background: var(--rail); color: var(--text); padding: 7px 10px; font-size: 13px; outline: none; }
.gcal-sel.full { width: 100%; }
.gcal-line-inp { width: 100%; border: none; background: transparent; color: var(--text); font: inherit; font-size: 14.5px; padding: 4px 0; outline: none; resize: none; }
.gcal-line-inp::placeholder { color: var(--muted); }
.gcal-pane { display: none; }
.gcal-pane.show { display: block; animation: dReveal .22s ease; }
.gcal-subh { font-size: 12.5px; font-weight: 600; color: var(--soft); }

/* Accordion halus untuk rentang tanggal & jam saat buat/ubah acara */
.cal-expand { display: grid; grid-template-rows: 0fr; opacity: 0; transition: grid-template-rows .28s cubic-bezier(.22, 1, .36, 1), opacity .22s ease; }
.cal-expand.open { grid-template-rows: 1fr; opacity: 1; }
.cal-expand-in { overflow: hidden; padding-top: 2px; }

