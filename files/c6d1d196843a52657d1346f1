/* ================= Tokens ================= */
:root {
  --bg: #ffffff;
  --rail: #f4f4f5;
  --panel: #fafafa;
  --line: #ececee;
  --text: #1f1f22;
  --muted: #a3a3a8;
  --soft: #6b6b72;
  --card: #ffffff;
  --head: #f8f8f9;
  --cal: #0a99f0;          /* aksen kalender (bisa diubah) */
  --note: #ffd93b;         /* aksen catatan */
  --note-ink: #1f1f22;
  --danger: #e5484d;
  --shadow: 0 8px 28px rgba(0,0,0,.14);
  --sat: var(--safe-area-inset-top, env(safe-area-inset-top, 0px));
  --sab: var(--safe-area-inset-bottom, env(safe-area-inset-bottom, 0px));
  --sal: var(--safe-area-inset-left, env(safe-area-inset-left, 0px));
  --sar: var(--safe-area-inset-right, env(safe-area-inset-right, 0px));
  color-scheme: light;
}
[data-theme="dark"] {
  --bg: #161618;
  --rail: #1e1e21;
  --panel: #1a1a1d;
  --line: #2b2b30;
  --text: #ececef;
  --muted: #5f5f66;
  --soft: #9a9aa2;
  --card: #222226;
  --head: #1b1b1e;
  --shadow: 0 8px 28px rgba(0,0,0,.55);
  color-scheme: dark;
}

* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
html, body { height: 100%; margin: 0; overscroll-behavior: none; }
body {
  font-family: "Segoe UI", Roboto, system-ui, -apple-system, sans-serif;
  background: var(--bg); color: var(--text); overflow: hidden;
  user-select: none; -webkit-user-select: none;
}
input, textarea, [contenteditable] { user-select: text; -webkit-user-select: text; }
button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; padding: 0; }
svg { fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }

/* ================= Shell ================= */
.app { display: flex; height: 100%; padding-top: var(--sat); padding-left: var(--sal); padding-right: var(--sar); }
.rail {
  width: 104px; flex: none; background: var(--rail);
  display: flex; flex-direction: column; justify-content: center; gap: 44px;
  padding-bottom: var(--sab);
}
.rail button { position: relative; display: flex; flex-direction: column; align-items: center; gap: 6px; color: var(--muted); font-size: 13px; padding: 8px 0; }
.rail button svg { width: 30px; height: 30px; }
.rail button.active { color: var(--text); }
.rail button.active .acc { stroke: var(--cal); }
.rail button[data-view="notes"].active .acc { stroke: var(--note); }
.rail button.active::before { content: ""; position: absolute; left: 0; top: 4px; bottom: 4px; width: 4px; background: var(--cal); border-radius: 0 3px 3px 0; }
main { flex: 1; min-width: 0; position: relative; }
.view { position: absolute; inset: 0; display: none; flex-direction: column; padding-bottom: var(--sab); }
.view.active { display: flex; }

.topbar { height: 84px; flex: none; display: flex; align-items: center; gap: 10px; padding: 0 24px; border-bottom: 1px solid var(--line); }
.topbar .title { font-size: 26px; font-weight: 500; padding: 6px 8px; border-radius: 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
button.title:hover { background: var(--rail); }
.spacer { flex: 1; }
.ib { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; color: var(--text); flex: none; }
.ib:hover { background: var(--rail); }
.ib svg { width: 26px; height: 26px; }
.ib.sm { width: 36px; height: 36px; }
.ib.sm svg { width: 20px; height: 20px; }

.fab {
  position: absolute; right: 36px; bottom: calc(36px + var(--sab)); width: 68px; height: 68px; border-radius: 50%;
  background: var(--cal); color: #fff; box-shadow: var(--shadow); display: grid; place-items: center; z-index: 3;
  transition: transform .15s;
}
.fab:active { transform: scale(.94); }
.fab svg { width: 32px; height: 32px; stroke-width: 2; }
.fab.yellow { background: var(--note); color: var(--note-ink); }

.scroll { flex: 1; overflow: auto; -webkit-overflow-scrolling: touch; }
.pad { padding: 20px 28px 120px; }
.h2 { font-weight: 500; font-size: 15px; color: var(--soft); margin: 18px 0 10px; text-transform: uppercase; letter-spacing: .04em; }
.empty { color: var(--muted); text-align: center; padding: 70px 20px; font-size: 16px; line-height: 1.6; }

.row { display: flex; align-items: center; gap: 14px; padding: 14px 16px; border-radius: 12px; background: var(--card); border: 1px solid var(--line); margin-bottom: 8px; font-size: 16px; }
.row .grow { flex: 1; min-width: 0; }
.row .sub { font-size: 13px; color: var(--soft); margin-top: 2px; }
.row.click { cursor: pointer; }
.bar { width: 5px; align-self: stretch; border-radius: 3px; flex: none; }
.check { width: 24px; height: 24px; border-radius: 50%; border: 2px solid var(--muted); flex: none; display: grid; place-items: center; color: #fff; }
.check svg { width: 14px; height: 14px; stroke-width: 3; }
.row.done .check { background: var(--cal); border-color: var(--cal); }
.row.done .ttl { text-decoration: line-through; color: var(--muted); }

/* ================= Sheet / Popover / Toast ================= */
.scrim { position: fixed; inset: 0; background: rgba(0,0,0,.38); display: none; align-items: center; justify-content: center; z-index: 50; padding: 16px; }
.scrim.open { display: flex; }
.sheet { background: var(--card); width: min(520px, 100%); max-height: calc(100% - 32px); overflow: auto; border-radius: 18px; padding: 22px; box-shadow: var(--shadow); }
.sheet h3 { margin: 0 0 16px; font-size: 20px; font-weight: 600; }
.sheet p { color: var(--soft); line-height: 1.55; margin: 0 0 14px; }
.field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }
.field > label { font-size: 13px; color: var(--soft); }
.inp { font: inherit; font-size: 16px; padding: 10px 12px; border-radius: 10px; border: 1px solid var(--line); background: var(--bg); color: var(--text); outline: none; width: 100%; }
.inp:focus { border-color: var(--cal); }
textarea.inp { resize: vertical; }
.two { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.swatches { display: flex; flex-wrap: wrap; gap: 10px; }
.sw { width: 32px; height: 32px; border-radius: 50%; border: 3px solid transparent; box-shadow: inset 0 0 0 1px rgba(0,0,0,.08); }
.sw.on { border-color: var(--text); }
.actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
.btn { padding: 10px 18px; border-radius: 10px; font-size: 15px; font-weight: 500; }
.btn.primary { background: var(--cal); color: #fff; }
.btn.yellow { background: var(--note); color: var(--note-ink); }
.btn.ghost { background: var(--rail); }
.btn.danger { color: var(--danger); }
.btn.left { margin-right: auto; }
.chips { display: flex; flex-wrap: wrap; gap: 8px; }
.chip-opt { padding: 8px 14px; border-radius: 999px; background: var(--rail); font-size: 14px; border: 2px solid transparent; }
.chip-opt.on { border-color: var(--cal); background: color-mix(in srgb, var(--cal) 12%, var(--card)); }

.popover { position: fixed; z-index: 60; background: var(--card); border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--shadow); padding: 6px; display: none; min-width: 200px; }
.popover.open { display: block; }
.popover button { display: flex; align-items: center; gap: 12px; width: 100%; text-align: left; padding: 11px 14px; border-radius: 8px; font-size: 15px; }
.popover button:hover { background: var(--rail); }
.popover button svg { width: 20px; height: 20px; color: var(--soft); }
.popover button.danger { color: var(--danger); }
.popover button.danger svg { color: var(--danger); }
.popover hr { border: 0; border-top: 1px solid var(--line); margin: 4px 0; }

.toast { position: fixed; left: 50%; bottom: calc(100px + var(--sab)); transform: translateX(-50%); background: #26262a; color: #fff; padding: 10px 18px; border-radius: 999px; font-size: 14px; opacity: 0; transition: opacity .2s; pointer-events: none; z-index: 70; white-space: nowrap; }
.toast.show { opacity: 1; }

/* ================= Kalender ================= */
.weekdays { display: grid; height: 44px; align-items: center; text-align: center; font-size: 15px; color: var(--soft); background: var(--head); border-bottom: 1px solid var(--line); flex: none; }
.weekdays .now { color: var(--cal); font-weight: 600; }
.weekdays .wk, .cell.wk { color: var(--muted); font-size: 12px; }
.weekdays .red, .cell.red .num { color: #e5484d; }
.cal-grid { flex: 1; display: grid; grid-template-rows: repeat(6, 1fr); min-height: 0; touch-action: pan-x pan-y; }
.cell { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); overflow: hidden; display: flex; flex-direction: column; text-align: left; min-height: 0; min-width: 0; }
.cell:last-child, .cell.endcol { border-right: 0; }
.cell.wk { display: grid; place-items: start center; padding-top: 8px; background: var(--head); cursor: default; }
.cell .num { font-size: 18px; padding: 2px 6px 1px 8px; line-height: 1.2; flex: none; display: flex; align-items: center; gap: 4px; }
.cell.other .num { color: var(--muted); }
.cell.other.hideother .num, .cell.other.hideother .evs { visibility: hidden; }
.cell.today .num { background: var(--cal); color: #fff; }
.cal-round .cell.today .num { background: none; }
.cal-round .cell .num { display: flex; }
.cal-round .cell.today .num span { background: var(--cal); color: #fff; border-radius: 999px; min-width: 1.6em; text-align: center; padding: 0 .3em; }
.cell.sel:not(.today) { background: color-mix(in srgb, var(--cal) 7%, transparent); }
.evs { display: flex; flex-direction: column; gap: 1px; padding: 1px 4px; min-height: 0; overflow: hidden; }
.ev { font-size: 12px; padding: 1px 5px; border-radius: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #fff; flex: none; }
.dots { display: flex; gap: 3px; padding: 2px 10px; flex-wrap: wrap; }
.dots i { width: 7px; height: 7px; border-radius: 50%; }
.more { font-size: 11px; color: var(--soft); padding-left: 5px; }
.month-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }

/* ================= Catatan: library ================= */
.notes-wrap { flex: 1; display: flex; min-height: 0; }
.nside { width: 280px; flex: none; border-right: 1px solid var(--line); padding: 18px 14px; display: flex; flex-direction: column; gap: 4px; overflow: auto; background: var(--bg); }
.nside .stats { background: linear-gradient(135deg, color-mix(in srgb, var(--note) 14%, var(--card)), color-mix(in srgb, var(--note) 30%, var(--card))); color: color-mix(in srgb, var(--note) 55%, var(--text)); border-radius: 16px; padding: 14px 16px; margin-bottom: 14px; font-size: 13px; line-height: 1.5; }
[data-theme="dark"] .nside .stats { background: linear-gradient(135deg, color-mix(in srgb, var(--note) 16%, var(--card)), color-mix(in srgb, var(--note) 30%, var(--card))); color: color-mix(in srgb, var(--note) 45%, #fff); }
.nside .stats b { font-size: 22px; display: block; }
.nitem { display: flex; align-items: center; gap: 12px; padding: 11px 12px; border-radius: 10px; font-size: 16px; width: 100%; text-align: left; }
.nitem svg { width: 22px; height: 22px; flex: none; }
.nitem .grow { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.nitem .cnt { font-size: 13px; color: var(--muted); }
.nitem.on { background: color-mix(in srgb, var(--note) 18%, transparent); color: color-mix(in srgb, var(--note) 60%, var(--text)); font-weight: 500; }
.nitem.sub { padding-left: 34px; font-size: 15px; }
.nitem .add { color: var(--soft); }
.ngrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 28px 22px; padding: 22px 28px 130px; align-content: start; }
.nb { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
.nb .cover-box { aspect-ratio: 3/4; display: flex; align-items: center; justify-content: center; cursor: pointer; }
.nb .meta { display: flex; gap: 4px; align-items: flex-start; }
.nb .meta .grow { flex: 1; min-width: 0; }
.nb .name { font-size: 15px; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; word-break: break-word; }
.nb .date { font-size: 12px; color: var(--muted); margin-top: 4px; }
.nb .caret { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 6px; color: var(--soft); flex: none; }
.nb .caret:hover { background: var(--rail); }
.nb .caret svg { width: 16px; height: 16px; fill: currentColor; stroke: none; }
.newcard { width: 100%; height: 100%; border: 2px dashed var(--muted); border-radius: 6px; display: grid; place-items: center; color: var(--note); background: var(--panel); }
.newcard svg { width: 40px; height: 40px; }
.folder-card { width: 100%; height: 100%; display: grid; place-items: center; }
.folder-card svg { width: 80%; height: 80%; stroke: none; }

/* sampul buku */
.cover { width: 100%; height: 100%; border-radius: 3px 8px 8px 3px; position: relative; overflow: hidden; box-shadow: 0 2px 4px rgba(0,0,0,.12), 0 8px 18px rgba(0,0,0,.1); background: var(--c, #ffd93b); }
.cover::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 9%; background: linear-gradient(90deg, rgba(0,0,0,.18), rgba(0,0,0,.04) 70%, rgba(255,255,255,.15)); z-index: 2; pointer-events: none; }
.cover .label { position: absolute; left: 22%; right: 12%; top: 18%; background: rgba(255,255,255,.92); color: #222; border-radius: 4px; padding: 8% 6%; font-size: 13px; font-weight: 600; text-align: center; line-height: 1.3; word-break: break-word; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
.cover.s-lines { background-image: repeating-linear-gradient(0deg, rgba(255,255,255,.14) 0 2px, transparent 2px 14px); }
.cover.s-dots { background-image: radial-gradient(rgba(255,255,255,.35) 1.5px, transparent 1.6px); background-size: 14px 14px; }
.cover.s-band::after { content: ""; position: absolute; right: 14%; top: 0; bottom: 0; width: 7%; background: rgba(0,0,0,.18); }
/* motif sampul tambahan */
.cover.s-grid { background-image: linear-gradient(rgba(255,255,255,.22) 1.5px, transparent 1.5px), linear-gradient(90deg, rgba(255,255,255,.22) 1.5px, transparent 1.5px); background-size: 14px 14px; }
.cover.s-diag { background-image: repeating-linear-gradient(45deg, rgba(255,255,255,.2) 0 6px, transparent 6px 14px); }
