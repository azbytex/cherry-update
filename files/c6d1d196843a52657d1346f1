/* Agenda: gumpalan penanda hari terpilih (pindah seperti slime, strip tidak dibangun ulang) */
.dweek { position: relative; isolation: isolate; --slime: var(--cal); --slime-r: 16px; --slime-box: 0 4px 10px color-mix(in srgb, var(--cal) 28%, transparent); }
.dweek .dday > * { position: relative; z-index: 2; }
.dweek .dday { transition: color .25s ease; }
.dweek .dday:active { transform: none; }
.dweek .dday.on { background: var(--rail); color: #fff; }
.dweek .dday small { transition: color .25s ease; }

/* ===== Slime: penanda pilihan untuk semua switch (lihat js/slime.js) ===== */
.slime { position: absolute; inset: 0; z-index: 0; pointer-events: none; contain: layout style; }
.slime i { position: absolute; left: 0; top: 0; background: var(--slime, var(--cal)); border-radius: var(--slime-r, 12px); transform-origin: center; }
.slime:not(.moving):not(.line) .sl-head { box-shadow: var(--slime-box, none); }
.slime.moving i { will-change: transform; }
.slime .sl-neck { opacity: 0; border-radius: 999px; }
.slime.line i { border-radius: 2px; }
/* segmen Terbaru/Terlama di Dashboard */
.dseg { position: relative; isolation: isolate; --slime: var(--card); --slime-r: 8px; --slime-box: 0 1px 3px rgba(0,0,0,.14); }
.dseg button { position: relative; z-index: 1; }
.dseg button.on { background: transparent; box-shadow: none; }
/* sub-toolbar editor (jenis pena, tinta stabilo, penghapus, bentuk) */
.esub .seg { isolation: isolate; --slime: var(--card); --slime-r: 10px; --slime-box: 0 2px 5px rgba(0,0,0,.13); }
/* tab pemilih warna: garis bawah yang melar */
.cpk-tabs { --slime: #2f86d6; }
.cpk-tabs .slime.line i { top: auto !important; bottom: -1px; height: 3px !important; }
/* toggle on/off: bulatan melar ke arah tujuan dulu, lalu ekornya menyusul */
.hl-switch i::after { left: 3px; border-radius: 10px; transform: none !important; transition: left .3s var(--spring, ease); }
.hl-switch input:checked + i::after { left: 21px; }
.hl-switch i.pop-on::after { animation: knobOn .42s both; }
.hl-switch i.pop-off::after { animation: knobOff .42s both; }
@keyframes knobOn { 0% { left: 3px; width: 20px; } 45% { left: 3px; width: 38px; animation-timing-function: cubic-bezier(.6,0,.3,1); } 100% { left: 21px; width: 20px; } }
@keyframes knobOff { 0% { left: 21px; width: 20px; } 45% { left: 3px; width: 38px; animation-timing-function: cubic-bezier(.6,0,.3,1); } 100% { left: 3px; width: 20px; } }
@media (prefers-reduced-motion: reduce) { .hl-switch i.pop-on::after, .hl-switch i.pop-off::after { animation: none; } }

/* halaman PDF yang sedang digambar (impor bertahap) */
.pdf-loading::after { content: 'Memuat halaman…'; position: absolute; left: 50%; top: 40%; transform: translate(-50%, -50%); padding: 8px 14px; border-radius: 999px; background: color-mix(in srgb, var(--card) 92%, transparent); color: var(--soft); font-size: 13px; box-shadow: 0 2px 10px rgba(0,0,0,.08); pointer-events: none; animation: pdfBlink 1.2s ease-in-out infinite; z-index: 3; }
@keyframes pdfBlink { 50% { opacity: .55; } }

/* ===== Buku besar: halaman jauh dilewati browser, animasi masuk hanya untuk halaman awal ===== */
.page.far { content-visibility: hidden; }
.page:nth-child(n+7) { animation: none; }
.bf-pages, .bf-cover, .bf-book { will-change: transform; }
/* indikator halaman bisa diketuk → pemilih halaman */
#ed-ind { cursor: pointer; font-variant-numeric: tabular-nums; }
#ed-ind:hover { background: var(--line); }
.gp-main { display: flex; gap: 18px; align-items: center; margin-bottom: 18px; }
.gp-prev { width: 120px; aspect-ratio: 1 / 1.414; flex: none; border-radius: 6px; background: #fff; box-shadow: 0 2px 10px rgba(0,0,0,.14); display: grid; place-items: center; overflow: hidden; color: var(--muted); font-size: 12px; transition: opacity .15s; }
.gp-prev canvas { width: 100%; height: 100%; object-fit: contain; display: block; }
.gp-prev.loading { opacity: .55; }
.gp-side { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 14px; }
.gp-num { display: flex; align-items: center; gap: 10px; font-size: 18px; color: var(--soft); font-variant-numeric: tabular-nums; }
.gp-num .inp { width: 96px; font-size: 22px; font-weight: 700; text-align: center; padding: 8px; }
.gp-quick { display: flex; gap: 6px; flex-wrap: wrap; }
.gp-quick .chip-opt { padding: 7px 12px; font-size: 13px; }
@media (max-width: 600px) { .gp-prev { width: 84px; } .gp-main { gap: 12px; } }

/* ===== Catatan: label folder, pilih banyak, seret tumpukan ke folder ===== */
.nb .cover-box { position: relative; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }
.nb-folder { position: absolute; left: 50%; top: 0; transform: translate(-50%, -55%); z-index: 3; display: inline-flex; align-items: center; gap: 4px; max-width: 86%; padding: 3px 9px 3px 7px; border-radius: 999px; background: var(--card); color: var(--text); font-size: 11.5px; box-shadow: 0 1px 2px rgba(0,0,0,.08), 0 3px 10px rgba(0,0,0,.12); pointer-events: none; }
.nb-folder svg { width: 13px; height: 13px; flex: none; fill: none; stroke: currentColor; stroke-width: 2; color: var(--note); }
.nb-folder b { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.nb-check { position: absolute; right: 7%; top: 5%; z-index: 4; width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: rgba(255,255,255,.92); border: 2px solid rgba(0,0,0,.18); color: transparent; opacity: 0; transform: scale(.6); transition: opacity .2s, transform .25s var(--spring, ease), background-color .2s, border-color .2s, color .2s; pointer-events: none; }
.nb-check svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
.ngrid.picking .nb-check { opacity: 1; transform: scale(1); }
.nb.picked .nb-check { background: var(--cal); border-color: var(--cal); color: #fff; }
.ngrid.picking .nb .cover { transition: transform .25s var(--spring, ease), box-shadow .25s, filter .25s; }
.ngrid.picking .nb:not(.picked) .cover { filter: saturate(.7) brightness(.97); }
.ngrid.picking .nb.picked .cover { transform: scale(.94); box-shadow: 0 0 0 3px var(--cal), 0 8px 18px rgba(0,0,0,.14); }
.ngrid.picking .nb.picked .cover-box { touch-action: none; } /* seret tanpa menggulir halaman */
.nb.drag-src .cover { opacity: .28; transform: scale(.9) !important; }
.pickbar { display: flex; align-items: center; gap: 10px; margin: 12px 28px 0; padding: 8px 10px 8px 8px; border-radius: 14px; background: color-mix(in srgb, var(--cal) 10%, var(--card)); border: 1px solid color-mix(in srgb, var(--cal) 25%, var(--line)); animation: dIn .25s ease both; }
.pickbar[hidden] { display: none; }
.pickbar b { font-size: 15px; white-space: nowrap; }
.pickbar .pick-hint { flex: 1; min-width: 0; font-size: 13px; color: var(--soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pickbar .btn { padding: 8px 14px; font-size: 14px; }
.pickstack { position: fixed; inset: 0; z-index: 9000; pointer-events: none; }
.pickstack .ps-card { position: absolute; border-radius: 3px 8px 8px 3px; box-shadow: 0 6px 18px rgba(0,0,0,.22); will-change: transform; transition: none !important; animation: none !important; }
.pickstack .ps-card .label { font-size: 9px; }
.ps-badge { position: absolute; left: 0; top: 0; min-width: 28px; height: 28px; padding: 0 8px; border-radius: 999px; background: var(--cal); color: #fff; font-size: 14px; font-weight: 700; display: grid; place-items: center; box-shadow: 0 3px 10px rgba(0,0,0,.25); }
.drop-hover { background: color-mix(in srgb, var(--cal) 18%, transparent) !important; box-shadow: inset 0 0 0 2px var(--cal); transform: scale(1.04); transition: transform .15s var(--spring, ease), background-color .15s; }
@media (max-width: 600px) { .pickbar { margin: 10px 14px 0; } .pickbar .pick-hint, #l-pick-all { display: none; } }

/* pilihan font judul sampul & expand ke samping tanpa scroll */
.cv-fontbtn { display: inline-flex; align-items: center; gap: 8px; height: 36px; padding: 0 12px; border-radius: 10px; background: var(--rail); color: var(--text); font-size: 15px; }
.cv-fontbtn svg { width: 14px; height: 14px; fill: currentColor; stroke: none; transition: transform .2s; }
.cv-fontbtn.open svg { transform: rotate(180deg); }
.cv-fp { margin-top: 8px; border: 1px solid var(--line); border-radius: 14px; padding: 8px 10px; min-width: 0; overflow: hidden; animation: cvFpIn .26s cubic-bezier(.22,1,.36,1) both; }
.cv-fp[hidden] { display: none; }
@keyframes cvFpIn { from { opacity: 0; transform: translateX(12px); } }
.cv-dialog { display: grid; grid-template-columns: 1fr; gap: 0; }
.cv-left { min-width: 0; }
.sheet.cv-sheet { padding: 18px 20px 20px; max-height: calc(100% - 20px); transition: width .32s cubic-bezier(.22,1,.36,1); }
.sheet.cv-sheet h3 { margin: 0 0 10px; font-size: 18px; }
.sheet.cv-sheet .field { margin-bottom: 8px; }
.sheet.cv-sheet .field label { font-size: 12.5px; margin-bottom: 5px; }
.sheet.cv-sheet #cv-prev { width: 78px !important; margin: 0 auto 10px !important; }
.sheet.cv-sheet .swatches { gap: 7px; }
.sheet.cv-sheet .sw { width: 26px; height: 26px; border-width: 2px; }
.sheet.cv-sheet .cv-motif { padding: 3px 1px; font-size: 10px; }
.sheet.cv-sheet .cv-motif .cover { width: 28px; height: 37px; }
.sheet.cv-sheet .cv-dots { margin: 6px 0 2px; }
.sheet.cv-sheet .actions { margin-top: 8px; }
@media (min-width: 720px) {
  .sheet.cv-sheet { width: min(440px, 100%); }
  .sheet.cv-sheet.cv-expanded { width: min(860px, 100%); }
  .sheet.cv-sheet.cv-expanded .cv-dialog { grid-template-columns: 330px 1fr; gap: 20px; align-items: start; }
  .sheet.cv-sheet.cv-expanded .cv-fp { margin-top: 0; }
}

/* gestur & pintasan: dropdown akordeon 2 kolom */
.g-item { border-bottom: 1px solid var(--line); }
.g-item:last-of-type { border-bottom: 0; }
.g-head { display: flex; align-items: center; gap: 10px; padding: 14px 4px; cursor: pointer; user-select: none; }
.g-head .grow { font-weight: 600; font-size: 15px; }
.g-head .g-val { color: var(--soft); font-size: 13.5px; transition: color .2s; }
.g-head .g-chev { width: 18px; height: 18px; color: var(--soft); transition: transform .26s cubic-bezier(.22,1,.36,1), color .2s; flex: none; }
.g-item.open .g-head .g-chev { transform: rotate(90deg); color: var(--cal); }
.g-item.open .g-head .g-val { color: var(--cal); font-weight: 600; }
.g-drop { display: grid; grid-template-rows: 0fr; opacity: 0; transition: grid-template-rows .26s cubic-bezier(.22,1,.36,1), opacity .2s ease; }
.g-item.open .g-drop { grid-template-rows: 1fr; opacity: 1; }
.g-drop-in { overflow: hidden; }
.g-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; padding: 2px 2px 14px; }
.g-opt { display: flex; align-items: center; justify-content: space-between; gap: 6px; padding: 10px 12px; border-radius: 12px; border: 1.5px solid var(--line); background: var(--bg); color: var(--text); font-size: 13px; font-weight: 500; text-align: left; transition: transform .15s, border-color .18s, background-color .18s, color .18s; }
.g-opt:active { transform: scale(.97); }
.g-opt.on { border-color: var(--cal); background: color-mix(in srgb, var(--cal) 12%, var(--card)); color: var(--cal); font-weight: 600; }
.g-opt .g-dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor; opacity: 0; transform: scale(.5); transition: opacity .18s, transform .2s; flex: none; }
.g-opt.on .g-dot { opacity: 1; transform: scale(1); }

/* ===== Kalkulator editor: mode floating popout + split sidebar kanan ===== */
.ed-work { flex: 1; display: flex; min-height: 0; overflow: hidden; position: relative; }
.ed-stage { flex: 1; position: relative; display: flex; flex-direction: column; min-width: 0; min-height: 0; }
.ed-split { width: 0; flex: none; overflow: hidden; background: var(--card); border-left: 0 solid var(--line); transition: width .28s cubic-bezier(.22,1,.36,1), border-left-width .2s; display: flex; flex-direction: column; }
.ed-split.open { width: min(304px, 44vw); border-left-width: 1px; }
.ed-split.open.wide-split { width: min(350px, 48vw); }
@media (max-width: 600px) { .ed-split.open, .ed-split.open.wide-split { width: min(275px, 60vw); } }

.calc-float { position: fixed; z-index: 48; border-radius: 18px; background: var(--card); border: 1px solid var(--line); box-shadow: 0 14px 40px rgba(0,0,0,.22), 0 2px 8px rgba(0,0,0,.08); overflow: hidden; animation: cvFpIn .22s cubic-bezier(.22,1,.36,1); }
.calc-float[hidden] { display: none; }
.calc-box { position: relative; display: flex; flex-direction: column; width: 100%; height: 100%; min-width: 224px; padding: 10px 12px 12px; gap: 8px; box-sizing: border-box; user-select: none; -webkit-user-select: none; }
.calc-box.in-split { min-width: 0; padding: 12px; }
.calc-head { display: flex; align-items: center; justify-content: space-between; gap: 6px; cursor: grab; touch-action: none; }
.calc-box.in-split .calc-head { cursor: default; }
.calc-head:active { cursor: grabbing; }
.calc-title { display: inline-flex; align-items: center; gap: 6px; font-size: 13.5px; color: var(--soft); }
.calc-title svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 2; }
.calc-acts { display: flex; align-items: center; gap: 2px; }
.calc-ib { width: 28px; height: 28px; border-radius: 8px; display: grid; place-items: center; color: var(--soft); transition: background-color .15s, color .15s; }
.calc-ib:hover { background: var(--rail); color: var(--text); }
.calc-ib svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 2; }
.calc-disp { background: var(--rail); border-radius: 12px; padding: 8px 12px; text-align: right; cursor: pointer; min-height: 74px; display: flex; flex-direction: column; justify-content: flex-end; gap: 2px; overflow: hidden; }
.calc-disp:active { filter: brightness(.97); }
.calc-expr { font-size: 12.5px; color: var(--soft); min-height: 16px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-variant-numeric: tabular-nums; will-change: transform, opacity; }
.calc-val { font-size: clamp(22px, 5cqw, 30px); font-weight: 700; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-variant-numeric: tabular-nums; line-height: 1.15; transform-origin: right center; will-change: transform, opacity; }
.calc-prev { font-size: 14px; font-weight: 600; color: var(--cal); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-variant-numeric: tabular-nums; line-height: 1.2; will-change: transform, opacity; }
.calc-prev[hidden] { display: none; }
.calc-grid { flex: 1; min-height: 0; display: grid; grid-template-columns: repeat(4, 1fr); grid-template-rows: repeat(5, 1fr); gap: 6px; }
.calc-k { border-radius: 11px; background: var(--rail); color: var(--text); font-size: 16px; font-weight: 600; display: grid; place-items: center; transition: transform .12s, background-color .15s; }
.calc-k:active { transform: scale(.93); }
.calc-k.fn { background: color-mix(in srgb, var(--text) 9%, var(--rail)); color: var(--soft); font-size: 14.5px; }
.calc-k.op { background: color-mix(in srgb, var(--cal) 16%, var(--card)); color: var(--cal); font-size: 18px; }
.calc-k.eq { background: var(--note); color: var(--note-ink); font-size: 18px; }
.calc-rz { position: absolute; right: 2px; bottom: 2px; width: 20px; height: 20px; cursor: nwse-resize; touch-action: none; opacity: .45; background: radial-gradient(circle at 13px 13px, var(--soft) 1.5px, transparent 1.6px), radial-gradient(circle at 8px 13px, var(--soft) 1.5px, transparent 1.6px), radial-gradient(circle at 13px 8px, var(--soft) 1.5px, transparent 1.6px); }
.calc-box.in-split .calc-rz { display: none; }

/* ===== Chatbot AI Groq (floating + split sidebar kanan) ===== */
.chat-box { position: relative; display: flex; flex-direction: column; width: 100%; height: 100%; min-width: 240px; padding: 10px 12px 12px; gap: 8px; box-sizing: border-box; }
.chat-box.in-split { min-width: 0; }
.chat-box.in-split .calc-head { cursor: default; }
.chat-box.in-split .calc-rz { display: none; }
.chat-model { font-size: 11px; font-weight: 600; color: var(--cal); background: color-mix(in srgb, var(--cal) 12%, var(--card)); padding: 2px 8px; border-radius: 999px; max-width: 130px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.chat-body { flex: 1; min-height: 0; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; padding: 4px 2px; scrollbar-width: none; }
.chat-body::-webkit-scrollbar { display: none; }
.chat-setup { margin: auto 0; display: flex; flex-direction: column; gap: 10px; text-align: center; padding: 10px 6px; }
.chat-setup-ic { width: 44px; height: 44px; border-radius: 14px; background: color-mix(in srgb, var(--note) 26%, var(--card)); color: var(--text); display: grid; place-items: center; margin: 0 auto; }
.chat-setup-ic svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2; }
.chat-setup h4 { margin: 0; font-size: 16px; }
.chat-setup p { margin: 0; font-size: 12.5px; color: var(--soft); line-height: 1.45; }
.chat-empty { margin: auto 0; text-align: center; padding: 8px 4px; }
.chat-empty p { margin: 0 0 10px; font-size: 13px; color: var(--soft); }
.chat-quick { display: flex; flex-direction: column; gap: 6px; }
.chat-quick .chip-opt { font-size: 13px; padding: 8px 12px; text-align: center; }
.chat-msg { display: flex; flex-direction: column; gap: 4px; max-width: 92%; }
.chat-msg.user { align-self: flex-end; }
.chat-msg.ai { align-self: flex-start; }
.chat-bub { padding: 9px 12px; border-radius: 14px; font-size: 13.5px; line-height: 1.48; word-break: break-word; user-select: text; -webkit-user-select: text; }
.chat-msg.user .chat-bub { background: var(--cal); color: #fff; border-bottom-right-radius: 4px; }
.chat-msg.ai .chat-bub { background: var(--rail); color: var(--text); border-bottom-left-radius: 4px; }
.chat-code { background: rgba(0,0,0,.07); padding: 8px 10px; border-radius: 8px; overflow-x: auto; font-size: 12px; margin: 6px 0; }
.chat-ic { background: rgba(0,0,0,.07); padding: 1px 5px; border-radius: 5px; font-size: 12.5px; }
.chat-macts { display: flex; gap: 6px; padding-left: 4px; }
.chat-macts button { font-size: 11.5px; color: var(--soft); padding: 3px 8px; border-radius: 999px; background: var(--rail); }
.chat-macts button:hover { color: var(--text); }
.chat-dots { display: inline-flex; gap: 4px; padding: 4px 2px; }
.chat-dots i { width: 6px; height: 6px; border-radius: 50%; background: var(--soft); animation: chatBlink 1.1s infinite ease-in-out; }
.chat-dots i:nth-child(2) { animation-delay: .18s; }
.chat-dots i:nth-child(3) { animation-delay: .36s; }
@keyframes chatBlink { 0%, 80%, 100% { opacity: .25; transform: scale(.85); } 40% { opacity: 1; transform: scale(1); } }
.chat-foot { flex: none; display: flex; flex-direction: column; gap: 6px; border-top: 1px solid var(--line); padding-top: 8px; }
.chat-foot[hidden] { display: none; }
.chat-ctx-row { display: flex; align-items: center; gap: 6px; }
.chat-ctx { font-size: 12px; padding: 4px 10px; }
.chat-inp-wrap { display: flex; flex-direction: column; gap: 6px; }
.chat-inp-row { display: flex; gap: 6px; align-items: center; justify-content: space-between; }
.chat-inp-tools { display: flex; gap: 6px; align-items: center; }
.chat-inp { width: 100%; box-sizing: border-box; min-width: 0; resize: none; padding: 8px 10px; font-size: 13.5px; line-height: 1.4; min-height: 58px; max-height: 130px; }
.chat-send { height: 34px; padding: 0 14px; font-size: 13.5px; flex: none; display: inline-flex; align-items: center; justify-content: center; }
.chat-send.danger-btn { background: var(--danger); color: #fff; }
.chat-ctx-row { flex-wrap: wrap; }
.chat-ctx { display: inline-flex; align-items: center; gap: 4px; }
.chat-ctx svg, .chat-cap-tag svg { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; flex: none; }
.chat-cap-tag { display: flex; align-items: center; gap: 4px; width: fit-content; font-size: 10.5px; font-weight: 600; opacity: .78; margin-bottom: 4px; padding: 2px 7px; border-radius: 999px; background: rgba(0, 0, 0, .08); }
[data-theme="dark"] .chat-cap-tag { background: rgba(255, 255, 255, .12); }

/* Selection box AI button & Circle to Ask */
.tb-ai { position: absolute; left: 18px; top: -40px; width: 28px; height: 28px; border-radius: 50%; background: linear-gradient(135deg, #ec4899, #8b5cf6); color: #fff; display: grid; place-items: center; box-shadow: 0 2px 6px rgba(0,0,0,.3); border: none; cursor: pointer; touch-action: manipulation; z-index: 2; }
.tbox:not(.has-dup) .tb-ai { left: -16px; }
.tb-ai svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; }

.lasso-ai-pop { position: absolute; z-index: 18; display: flex; gap: 6px; padding: 5px; border-radius: 999px; background: var(--card); border: 1px solid var(--line); box-shadow: 0 6px 20px rgba(0,0,0,.22); transform: translateX(-50%); animation: fadeIn .14s; }
.lasso-ai-pop button { display: inline-flex; align-items: center; gap: 5px; padding: 6px 11px; border-radius: 999px; font-size: 12.5px; font-weight: 600; background: var(--rail); color: var(--text); white-space: nowrap; }
.lasso-ai-pop button.ai-pri { background: linear-gradient(135deg, #ec4899, #8b5cf6); color: #fff; }
.lasso-ai-pop svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2; }

.ed-circle-hint { position: absolute; top: 64px; left: 50%; transform: translateX(-50%); z-index: 42; display: flex; align-items: center; gap: 10px; padding: 7px 10px 7px 14px; border-radius: 999px; background: var(--card); border: 1px solid var(--line); box-shadow: 0 6px 20px rgba(0,0,0,.18); font-size: 13px; font-weight: 600; animation: fadeIn .15s; white-space: nowrap; }
.ed-circle-hint button { padding: 4px 10px; border-radius: 999px; background: var(--rail); color: var(--text); font-size: 12px; font-weight: 600; }

/* Chat attachments & previews */
.chat-ib { width: 32px; height: 34px; border-radius: 10px; display: grid; place-items: center; color: var(--soft); background: var(--rail); flex: none; transition: background .15s, color .15s; }
.chat-ib:hover { color: var(--text); background: color-mix(in srgb, var(--rail) 70%, var(--line)); }
.chat-ib svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
.chat-atts { display: flex; flex-direction: column; gap: 6px; padding-bottom: 2px; }
.chat-atts[hidden] { display: none; }
.chat-att-list { display: flex; gap: 6px; flex-wrap: wrap; }
.chat-att-thumb { position: relative; width: 52px; height: 52px; border-radius: 10px; overflow: hidden; border: 1px solid var(--line); background: var(--rail); flex: none; }
.chat-att-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
.chat-att-rm { position: absolute; top: 2px; right: 2px; width: 18px; height: 18px; border-radius: 50%; background: rgba(0,0,0,.68); color: #fff; display: grid; place-items: center; padding: 0; }
.chat-att-rm svg { width: 11px; height: 11px; fill: none; stroke: currentColor; stroke-width: 2.4; }
.chat-att-q { display: flex; gap: 5px; flex-wrap: wrap; }
.chat-att-q .chip-opt { font-size: 11.5px; padding: 3px 9px; }
.chat-att-q .chip-opt.ai-pri { background: linear-gradient(135deg, #ec4899, #8b5cf6); color: #fff; border-color: transparent; }
.chat-msg-imgs { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 6px; }
.chat-msg-imgs img { max-width: 180px; max-height: 130px; border-radius: 10px; object-fit: contain; background: rgba(255,255,255,.92); cursor: zoom-in; border: 1px solid rgba(255,255,255,.25); }
.chat-zoom { position: fixed; inset: 0; z-index: 220; background: rgba(0,0,0,.82); display: grid; place-items: center; padding: 20px; cursor: zoom-out; animation: fadeIn .15s; }
.chat-zoom img { max-width: 96vw; max-height: 92vh; border-radius: 12px; box-shadow: 0 12px 40px rgba(0,0,0,.5); background: #fff; }

/* Math & formatted responses in chat */
.chat-h { font-weight: 700; font-size: 13.5px; margin: 6px 0 2px; }
.chat-tbl-wrap { overflow-x: auto; margin: 6px 0; border-radius: 8px; border: 1px solid var(--line); }
.chat-tbl { width: 100%; border-collapse: collapse; font-size: 12.5px; line-height: 1.4; text-align: left; }
.chat-tbl th, .chat-tbl td { padding: 5px 8px; border-bottom: 1px solid var(--line); border-right: 1px solid var(--line); vertical-align: top; }
.chat-tbl th:last-child, .chat-tbl td:last-child { border-right: none; }
.chat-tbl tr:last-child td { border-bottom: none; }
.chat-tbl th { background: color-mix(in srgb, var(--text) 6%, transparent); font-weight: 700; }
.math-in { font-variant-numeric: tabular-nums; font-weight: 500; padding: 0 1px; }
.math-blk { display: block; text-align: center; margin: 7px 0; padding: 7px 10px; border-radius: 10px; background: rgba(0,0,0,.045); font-variant-numeric: tabular-nums; font-weight: 500; overflow-x: auto; line-height: 1.4; }
[data-theme="dark"] .math-blk { background: rgba(255,255,255,.07); }
.chat-msg.user .math-blk { background: rgba(255,255,255,.16); }
.math-in sup, .math-blk sup, .chat-bub sup { font-size: .74em; line-height: 0; vertical-align: super; margin-left: .5px; }
.math-in sub, .math-blk sub, .chat-bub sub { font-size: .74em; line-height: 0; vertical-align: sub; margin-left: .5px; }
.m-frac { display: inline-flex; flex-direction: column; align-items: center; vertical-align: middle; margin: 0 3px; font-size: .88em; line-height: 1.15; }
.m-num { padding: 0 3px 1px; border-bottom: 1.3px solid currentColor; text-align: center; }
.m-den { padding: 2px 3px 0; text-align: center; }
.m-rad { margin-right: 0; font-weight: 600; }
.m-sqrt { border-top: 1.3px solid currentColor; padding: 1px 3px 0 2px; }
.m-rt { margin-right: -2px; }
.m-bar { border-top: 1.2px solid currentColor; padding-top: 1px; }
.m-fn, .m-txt { font-style: normal; font-weight: 500; }

/* Capture Shelf (Clipboard Sidebar) */
.ed-shelf { width: 0; flex: none; overflow: hidden; background: var(--card); border-left: 0 solid var(--line); transition: width .26s cubic-bezier(.22,1,.36,1), border-left-width .2s; display: flex; flex-direction: column; }
.ed-shelf.open { width: min(224px, 42vw); border-left-width: 1px; }
@media (max-width: 600px) { .ed-shelf.open { width: min(176px, 46vw); } }
.shelf-head { flex: none; display: flex; align-items: center; justify-content: space-between; gap: 6px; padding: 10px 10px 8px; border-bottom: 1px solid var(--line); }
.shelf-title { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--text); min-width: 0; }
.shelf-title svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; color: var(--cal); flex: none; }
.shelf-title b { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.shelf-cnt { font-size: 11px; font-weight: 700; padding: 1px 6px; border-radius: 999px; background: var(--rail); color: var(--soft); }
.shelf-acts { display: flex; gap: 2px; flex: none; }
.shelf-body { flex: 1; min-height: 0; overflow-y: auto; padding: 8px; display: flex; flex-direction: column; gap: 8px; }
.shelf-empty { margin: auto 4px; text-align: center; font-size: 12.5px; line-height: 1.45; color: var(--soft); padding: 12px 6px; }
.shelf-card { border-radius: 12px; border: 1px solid var(--line); background: var(--bg); overflow: hidden; display: flex; flex-direction: column; animation: fadeIn .18s; flex: none; }
.shelf-img-wrap { position: relative; background: #fff; cursor: zoom-in; }
.shelf-img-wrap img { width: 100%; max-height: 124px; object-fit: contain; display: block; padding: 4px; box-sizing: border-box; }
.shelf-meta { position: absolute; left: 6px; bottom: 5px; padding: 1px 6px; border-radius: 999px; background: rgba(0,0,0,.62); color: #fff; font-size: 10px; pointer-events: none; }
.shelf-rm { position: absolute; top: 5px; right: 5px; width: 20px; height: 20px; border-radius: 50%; background: rgba(0,0,0,.62); color: #fff; display: grid; place-items: center; padding: 0; }
.shelf-rm svg { width: 11px; height: 11px; fill: none; stroke: currentColor; stroke-width: 2.3; }
.shelf-card-acts { display: flex; align-items: center; gap: 4px; padding: 6px; border-top: 1px solid var(--line); background: var(--card); }
.shelf-btn { height: 26px; padding: 0 7px; border-radius: 8px; background: var(--rail); color: var(--text); font-size: 11px; font-weight: 600; display: inline-flex; align-items: center; justify-content: center; gap: 3px; flex: none; }
.shelf-btn.pri { background: var(--note); color: var(--note-ink); flex: 1; }
.shelf-btn.ai { background: linear-gradient(135deg, #ec4899, #8b5cf6); color: #fff; padding: 0 8px; }
.shelf-btn svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 2; }
.shelf-peek { position: absolute; right: 10px; top: 50%; transform: translateY(-50%); z-index: 20; display: flex; flex-direction: column; align-items: center; gap: 3px; padding: 9px 7px; border-radius: 14px; background: var(--card); border: 1px solid var(--line); box-shadow: 0 4px 16px rgba(0,0,0,.16); color: var(--text); font-size: 11.5px; font-weight: 700; }
.shelf-peek[hidden] { display: none; }
.shelf-peek svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; color: var(--cal); }

/* pinch: area halaman jadi lapisan GPU sendiri, diskalakan tanpa menggambar ulang isinya */
.pages.gesturing { will-change: transform; }

/* pratinjau pinch (kanvas seukuran area halaman) */
.pinch-proxy { position: fixed; pointer-events: none; z-index: 1; }
