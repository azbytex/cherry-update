  .etools { order: 10; flex: 0 0 calc(100% + 12px); display: flex; align-items: center; gap: 2px; overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: none; margin: 2px -6px 0; padding: 4px 6px 6px; border-top: 1px solid var(--line); }
