  background: linear-gradient(120deg, color-mix(in srgb, var(--cal) 16%, var(--card)), color-mix(in srgb, #fe0000 12%, var(--card)) 60%, color-mix(in srgb, #ffe4e9 70%, var(--card))); animation: dIn .5s ease both; }
