/* ---------- Pemilih kertas ---------- */
.pp-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: -6px -4px 10px; }
.pp-head h3 { margin: 0; font-size: 17px; color: var(--note); }
.pp-x { background: none; border: none; color: var(--note); font: inherit; font-size: 15px; padding: 8px 4px; }
.pp { margin-bottom: 14px; }
