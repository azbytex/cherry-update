// Penyimpanan lokal (IndexedDB) — semua data tersimpan di perangkat.
const DB_NAME = 'cherry';
const VERSION = 1;
export const STORES = ['folders', 'notebooks', 'pages', 'blobs', 'events', 'todos', 'kv'];

let opening;
function open() {
  return opening ||= new Promise((resolve, reject) => {
    const req = indexedDB.open(DB_NAME, VERSION);
    req.onupgradeneeded = () => {
      const d = req.result;
      for (const s of STORES) if (!d.objectStoreNames.contains(s)) d.createObjectStore(s, { keyPath: 'id' });
    };
    req.onsuccess = () => resolve(req.result);
    req.onerror = () => reject(req.error);
  });
}

async function run(store, mode, fn) {
  const d = await open();
  return new Promise((resolve, reject) => {
    const t = d.transaction(store, mode);
    const s = t.objectStore(store);
    let out;
    const r = fn(s);
    if (r && 'onsuccess' in r) r.onsuccess = () => { out = r.result; };
    t.oncomplete = () => resolve(out);
    t.onerror = () => reject(t.error);
    t.onabort = () => reject(t.error);
  });
}

export const db = {
  all: (s) => run(s, 'readonly', (st) => st.getAll()),
  get: (s, id) => run(s, 'readonly', (st) => st.get(id)),
  put: (s, v) => run(s, 'readwrite', (st) => st.put(v)),
  del: (s, id) => run(s, 'readwrite', (st) => st.delete(id)),
  clear: (s) => run(s, 'readwrite', (st) => st.clear()),
  putMany: (s, list) => run(s, 'readwrite', (st) => { for (const v of list) st.put(v); }),
  delMany: (s, ids) => run(s, 'readwrite', (st) => { for (const id of ids) st.delete(id); }),
};

// ---------- Pengaturan ----------
export const settings = {
  theme: 'light',          // light | dark | system
  calAccent: '#0a99f0',
  weekStart: 1,            // 1 = Senin, 0 = Minggu
  weekNumbers: false,
  showOther: true,
  redSunday: true,
  todayStyle: 'bar',       // bar | round
  eventStyle: 'label',     // label | dot
  stylusOnly: false,
  smooth: 1,               // penghalus coretan: 0 mati, 1 halus, 2 sangat halus
  pens: null,
  gestures: {
    tap2: 'undo',
    tap3: 'redo',
    dbl1: 'none',
  },
};

export async function loadSettings() {
  const s = await db.get('kv', 'settings');
  if (s) Object.assign(settings, s.value);
}
export function saveSettings() {
  return db.put('kv', { id: 'settings', value: { ...settings } });
}
